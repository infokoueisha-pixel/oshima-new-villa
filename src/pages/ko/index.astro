---
import InternationalLayout from '../../layouts/InternationalLayout.astro';

const pageTitle = '오시마 뉴 빌라 | 도쿄 이즈오시마 독채 숙소';
const pageDescription = '도쿄의 화산섬 이즈오시마에 위치한 최대 6인 독채 빌라. 주방, BBQ 공간, 무료 Wi-Fi, 주차장, 셀프 체크인. 모토마치항에서 차로 약 5분입니다.';
const bookingUrl = 'https://www.airbnb.com/rooms/1602063410123886296';

const islandHighlights = [
  {
    title: '미하라산',
    eyebrow: '활화산',
    description: '이즈오시마의 화산 중심부, 미하라산 주변에서 역동적인 용암 지형을 걸어보세요.',
    image: '/mihara-mountain-view.webp',
    alt: '이즈오시마 미하라산 풍경',
  },
  {
    title: '우라사바쿠',
    eyebrow: '검은 화산 사막',
    description: '검은 화산지대와 탁 트인 하늘이 펼쳐지는, 다른 행성 같은 광대한 풍경입니다.',
    image: '/urasabaku-panorama.webp',
    alt: '이즈오시마 우라사바쿠의 광활한 화산 지형',
  },
  {
    title: '하부항',
    eyebrow: '역사적인 항구 마을',
    description: '섬 남쪽의 오래된 항구와 조용한 골목을 천천히 둘러보세요.',
    image: '/habu-port-overlook.webp',
    alt: '이즈오시마 하부항과 주변 마을',
  },
  {
    title: '노을과 별빛',
    eyebrow: '섬의 저녁',
    description: '바다에서 하루를 마무리한 뒤 숲으로 돌아와 고요한 밤과 별빛을 즐겨보세요.',
    image: '/sunset-ocean-view.webp',
    alt: '이즈오시마 바다의 노을',
  },
];

const villaFeatures = [
  ['독채 빌라', '69.27㎡, 한 팀만 단독 이용'],
  ['최대 6명 숙박', '싱글베드 4개 + 소파베드 2개'],
  ['주방', '냉장·냉동고, 전자레인지, 밥솥, 조리도구, 식기와 커트러리'],
  ['야외 BBQ', '지붕이 있는 가제보, 그릴, 벤치, 접이식 테이블'],
  ['욕실·화장실', '욕조와 샤워가 있는 전용 욕실, 분리형 화장실'],
  ['무료 Wi-Fi', '빌라 내 이용 가능. 연결 상태와 속도는 보장되지 않습니다'],
  ['주차', '부지 내 무료 주차'],
  ['셀프 체크인', '부지 내 설치된 태블릿으로 체크인'],
];

const accessCards = [
  {
    step: '01',
    title: '도쿄 → 이즈오시마',
    body: '도쿄 도심 다케시바에서 고속 제트선을 타면 약 2시간입니다. 조후공항에서 항공편을 이용하는 방법도 있습니다. 계절과 날씨에 따라 운항 일정이 달라질 수 있으므로 출발 전 운항사 정보를 확인해 주세요.',
  },
  {
    step: '02',
    title: '도착 항구 확인',
    body: '해상 상황에 따라 모토마치항 또는 오카다항으로 입항합니다. 승선 전 당일 도착 항구를 확인해 주세요.',
  },
  {
    step: '03',
    title: '렌터카 이용',
    body: '관광, 장보기, 섬 내 이동에는 렌터카를 추천합니다. 차량이 매진될 수 있으므로 미리 예약하는 것이 좋습니다.',
  },
  {
    step: '04',
    title: '오시마 뉴 빌라로 이동',
    body: '차로 모토마치항에서 약 5분, 오카다항에서 약 11분, 오시마공항에서 약 6분입니다.',
  },
];

const bookingNotes = [
  {
    title: '체크인 / 체크아웃',
    text: '체크인은 오후 3시부터, 체크아웃은 오전 10시까지입니다. 무인 운영 시설이며 태블릿으로 셀프 체크인합니다.',
  },
  {
    title: 'BBQ를 이용할 경우',
    text: '그릴, 벤치, 접이식 테이블은 준비되어 있습니다. 숯, 착화제, 점화용 라이터, 음식과 음료는 제공되지 않으므로 필요한 물품을 준비하거나 섬에서 구입해 주세요.',
  },
  {
    title: 'Wi-Fi',
    text: '무료 Wi-Fi is available, but island network conditions, weather, outages or equipment conditions may affect connectivity and speed. Please prepare a backup connection for important online meetings.',
  },
  {
    title: '직접 준비할 어메니티',
    text: '목욕 타월, 페이스 타월, 칫솔, 실내용 슬리퍼, 샴푸, 컨디셔너, 바디워시는 제공됩니다. 잠옷과 면도기는 제공되지 않습니다.',
  },
  {
    title: '흡연 및 반려동물',
    text: '빌라 내부는 금연입니다. 반려동물 동반은 불가합니다.',
  },
  {
    title: '최신 예약 조건',
    text: '공실, 요금, 취소 조건은 Airbnb에 표시됩니다. 최신 정보는 예약 페이지에서 확인해 주세요.',
  },
];
---

<InternationalLayout locale="ko" title={pageTitle} description={pageDescription}>
  <!-- Hero -->
  <section class="relative flex min-h-[100svh] items-center overflow-hidden bg-gray-950" aria-labelledby="en-hero-title">
    <picture class="absolute inset-0" aria-hidden="true">
      <source srcset="/main-optimized-640.webp 640w, /main-optimized-960.webp 960w, /main-optimized.webp 1170w" sizes="100vw" />
      <img src="/main-optimized.webp" alt="" class="h-full w-full object-cover" width="1170" height="1171" fetchpriority="high" />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-r from-gray-950/80 via-gray-950/55 to-gray-950/25" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 pt-28 pb-16 md:pt-32 md:pb-24">
      <div class="max-w-3xl text-white">
        <p class="text-xs font-bold tracking-[0.28em] text-green-200 uppercase sm:text-sm">도쿄 이즈오시마의 독채 빌라</p>
        <h1 id="en-hero-title" class="mt-5 font-serif text-4xl leading-[1.12] font-bold tracking-tight sm:text-5xl md:text-6xl lg:text-7xl">
          도쿄의 화산섬에서<br />머물러 보세요.
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-white/90 sm:text-lg md:text-xl md:leading-9">
          화산과 검은 화산 사막, 바다를 여행한 뒤 숲에 둘러싸인 독채 빌라로 돌아오세요. 오시마 뉴 빌라는 최대 6명까지 한 팀이 단독으로 머무는 숙소입니다.
        </p>
        <ul class="mt-7 flex flex-wrap gap-2.5 text-xs font-bold text-white sm:text-sm" aria-label="주요 특징">
          <li class="rounded-full border border-white/30 bg-white/10 px-4 py-2 backdrop-blur-sm">독채 빌라</li>
          <li class="rounded-full border border-white/30 bg-white/10 px-4 py-2 backdrop-blur-sm">최대 6명</li>
          <li class="rounded-full border border-white/30 bg-white/10 px-4 py-2 backdrop-blur-sm">주방 & BBQ</li>
          <li class="rounded-full border border-white/30 bg-white/10 px-4 py-2 backdrop-blur-sm">모토마치항에서 차로 5분</li>
        </ul>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={bookingUrl}
            data-booking-location="ko_hero"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-green-600 px-8 py-4 text-sm font-bold text-white shadow-xl transition-all hover:-translate-y-0.5 hover:bg-green-500"
          >
            Airbnb에서 공실 확인 <span class="ml-2" aria-hidden="true">↗</span>
          </a>
          <a href="#access" class="inline-flex items-center justify-center rounded-full border border-white/50 bg-white/10 px-8 py-4 text-sm font-bold text-white backdrop-blur-sm transition-colors hover:bg-white hover:text-gray-900">
            오시는 길
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Tokyo island positioning -->
  <section id="island" class="bg-orange-50 py-20 md:py-28" aria-labelledby="island-title">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-5">
        <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">또 다른 도쿄</p>
        <h2 id="island-title" class="mt-3 font-serif text-3xl font-bold leading-tight text-gray-900 md:text-5xl">
          도쿄는 도시만이 아닙니다.
        </h2>
        <div class="mt-6 space-y-5 text-base leading-8 text-gray-600 md:text-lg md:leading-9">
          <p>
            이즈오시마는 이즈 제도에서 가장 큰 섬으로 행정구역상 도쿄도에 속합니다. 도쿄 도심에서 고속 제트선으로 약 2시간이지만, 도착하면 전혀 다른 풍경이 펼쳐집니다.
          </p>
          <p>
            Spend the day hiking around 미하라산, exploring the black volcanic landscape of 우라사바쿠, visiting old harbor towns, diving, fishing or relaxing at an onsen.
          </p>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="https://www.gotokyo.org/en/destinations/izu-and-ogasawara-islands/oshima-island/index.html" target="_blank" rel="noopener noreferrer" class="rounded-full border border-green-700 px-5 py-2.5 text-sm font-bold text-green-800 transition-colors hover:bg-green-700 hover:text-white">
            도쿄 공식 오시마 관광 안내 ↗
          </a>
        </div>
      </div>
      <div class="lg:col-span-7">
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
          <img src="/mihara-crater.webp" alt="미하라산 분화구 풍경" class="aspect-[4/5] w-full rounded-2xl object-cover shadow-lg" width="1500" height="2000" loading="lazy" />
          <img src="/urasabaku-sea-view.webp" alt="바다가 내려다보이는 우라사바쿠 화산 지형" class="mt-8 aspect-[4/5] w-full rounded-2xl object-cover shadow-lg sm:mt-12" width="1500" height="2000" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Villa -->
  <section id="villa" class="bg-white py-20 md:py-28" aria-labelledby="villa-title">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">섬에서의 프라이빗 베이스</p>
        <h2 id="villa-title" class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-5xl">한 채의 빌라, 우리만의 속도로.</h2>
        <p class="mt-5 text-base leading-8 text-gray-600 md:text-lg">
          Salvia는 가족, 친구, 소규모 그룹이 한 팀으로 이용하는 69.27㎡ 독채 빌라입니다. 함께 요리하고 거실에서 쉬거나, 저녁에는 BBQ 가제보에서 시간을 보내세요.
        </p>
      </div>

      <div class="mt-14 grid gap-4 md:grid-cols-12">
        <figure class="overflow-hidden rounded-2xl bg-gray-100 md:col-span-7">
          <img src="/sofa-salvia.webp" alt="오시마 뉴 빌라의 소파베드 2개가 있는 거실" class="aspect-[4/3] h-full w-full object-cover" width="1108" height="832" loading="lazy" />
        </figure>
        <figure class="overflow-hidden rounded-2xl bg-gray-100 md:col-span-5">
          <img src="/bed-salvia.webp" alt="싱글베드 4개가 있는 침실" class="aspect-[4/3] h-full w-full object-cover" width="1477" height="994" loading="lazy" />
        </figure>
        <figure class="overflow-hidden rounded-2xl bg-gray-100 md:col-span-5">
          <img src="/day-bbq.webp" alt="오시마 뉴 빌라의 지붕 있는 야외 BBQ 가제보" class="aspect-[4/3] h-full w-full object-cover" width="1376" height="2000" loading="lazy" />
        </figure>
        <figure class="overflow-hidden rounded-2xl bg-gray-100 md:col-span-7">
          <img src="/bath_salvia.jpg" alt="Salvia 빌라의 전용 욕실" class="aspect-[4/3] h-full w-full object-cover" width="1200" height="900" loading="lazy" />
        </figure>
      </div>

      <dl class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {villaFeatures.map(([term, detail]) => (
          <div class="rounded-2xl border border-gray-100 bg-orange-50 p-5">
            <dt class="font-bold text-gray-900">{term}</dt>
            <dd class="mt-2 text-sm leading-6 text-gray-600">{detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Things to do -->
  <section id="things-to-do" class="bg-green-950 py-20 text-white md:py-28" aria-labelledby="things-title">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-3xl">
        <p class="text-xs font-bold tracking-[0.28em] text-green-300 uppercase">이즈오시마를 즐기다</p>
        <h2 id="things-title" class="mt-3 font-serif text-3xl font-bold md:text-5xl">낮에는 화산, 밤에는 숲.</h2>
        <p class="mt-5 text-base leading-8 text-green-50/80 md:text-lg">
          오시마는 자동차로 둘러보기 좋은 크기이면서도, 시간대마다 전혀 다른 풍경과 경험을 만날 수 있는 섬입니다.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {islandHighlights.map((item) => (
          <article class="overflow-hidden rounded-2xl border border-white/10 bg-white/5">
            <img src={item.image} alt={item.alt} class="aspect-[4/3] w-full object-cover" width="1500" height="1000" loading="lazy" />
            <div class="p-5">
              <p class="text-xs font-bold tracking-[0.2em] text-green-300 uppercase">{item.eyebrow}</p>
              <h3 class="mt-2 font-serif text-xl font-bold">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-green-50/75">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Access -->
  <section id="access" class="bg-orange-50 py-20 md:py-28" aria-labelledby="access-title">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">오시는 길</p>
        <h2 id="access-title" class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-5xl">도쿄 도심에서 숲까지.</h2>
        <p class="mt-5 text-base leading-8 text-gray-600 md:text-lg">
          이동하는 시간도 여행의 일부입니다. 가장 이해하기 쉬운 동선은 도쿄 → 배 또는 비행기 → 렌터카 → 오시마 뉴 빌라입니다.
        </p>
      </div>

      <ol class="mx-auto mt-12 grid max-w-5xl gap-4 md:grid-cols-2">
        {accessCards.map((item) => (
          <li class="rounded-2xl border border-orange-100 bg-white p-6 shadow-sm">
            <p class="font-serif text-3xl font-bold text-green-700">{item.step}</p>
            <h3 class="mt-3 text-lg font-bold text-gray-900">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">{item.body}</p>
          </li>
        ))}
      </ol>

      <div class="mx-auto mt-8 max-w-5xl rounded-2xl border border-green-100 bg-green-50 p-6 md:p-8">
        <div class="grid gap-6 md:grid-cols-3">
          <div>
            <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">모토마치항</p>
            <p class="mt-2 font-serif text-2xl font-bold text-gray-900">약 5분</p>
            <p class="mt-1 text-sm text-gray-600">차로</p>
          </div>
          <div>
            <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">오카다항</p>
            <p class="mt-2 font-serif text-2xl font-bold text-gray-900">약 11분</p>
            <p class="mt-1 text-sm text-gray-600">차로</p>
          </div>
          <div>
            <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">오시마공항</p>
            <p class="mt-2 font-serif text-2xl font-bold text-gray-900">약 6분</p>
            <p class="mt-1 text-sm text-gray-600">차로</p>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="https://www.tokaikisen.co.jp/en/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-green-700 bg-white px-5 py-2.5 text-sm font-bold text-green-800 transition-colors hover:bg-green-700 hover:text-white">
          도카이기센 선박 정보 ↗
        </a>
        <a href="https://www.gotokyo.org/en/plan/getting-around/going-to-islands/index.html" target="_blank" rel="noopener noreferrer" class="rounded-full border border-gray-300 bg-white px-5 py-2.5 text-sm font-bold text-gray-700 transition-colors hover:border-gray-900 hover:bg-gray-900 hover:text-white">
          도쿄 공식 섬 교통 안내 ↗
        </a>
      </div>
      <p class="mx-auto mt-5 max-w-3xl text-center text-xs leading-6 text-gray-500">
        선박과 항공편 시간은 계절, 노선, 날씨에 따라 변경될 수 있습니다. 출발 전 운항사의 최신 일정을 확인해 주세요.
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="bg-white py-20 md:py-28" aria-labelledby="story-en-title">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-12 lg:items-center lg:gap-16">
      <figure class="lg:col-span-6">
        <img src="/old-brochure.webp" alt="1975년 오시마 뉴 빌라 원본 브로슈어" class="w-full rounded-2xl shadow-xl" width="1024" height="1054" loading="lazy" />
        <figcaption class="mt-3 text-center text-xs leading-6 text-gray-500">1975년 당시의 원본 브로슈어입니다.</figcaption>
      </figure>
      <div class="lg:col-span-6">
        <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">우리의 이야기</p>
        <h2 id="story-en-title" class="mt-3 font-serif text-3xl font-bold leading-tight text-gray-900 md:text-5xl">1975년 첫 문을 열고, 2026년 다시 태어났습니다.</h2>
        <div class="mt-6 space-y-5 text-base leading-8 text-gray-600 md:text-lg md:leading-9">
          <p>오시마 뉴 빌라는 1975년 이즈오시마의 숲에서 처음 문을 열어 섬을 찾는 여행객들을 맞이했습니다.</p>
          <p>약 15년간 문을 닫은 뒤, 당시의 분위기와 흔적을 남기면서 세심하게 리노베이션했습니다.</p>
          <p>2026년, 가족과 친구들이 자신들만의 속도로 섬을 즐길 수 있는 독채 빌라로 새로운 시간을 시작했습니다.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Before booking -->
  <section id="before-booking" class="bg-gray-100 py-20 md:py-28" aria-labelledby="before-title">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">예약 전 확인</p>
        <h2 id="before-title" class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-5xl">예약 전에 알아두세요.</h2>
        <p class="mt-5 text-base leading-8 text-gray-600 md:text-lg">섬에 오시기 전에 필요한 실용적인 정보를 미리 확인해 주세요.</p>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl gap-4 md:grid-cols-2">
        {bookingNotes.map((item) => (
          <article class="rounded-2xl bg-white p-6 shadow-sm">
            <h3 class="font-bold text-gray-900">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">{item.text}</p>
          </article>
        ))}
      </div>

      <div class="mx-auto mt-8 max-w-5xl rounded-2xl border border-green-200 bg-green-50 p-6 text-center sm:flex sm:items-center sm:justify-between sm:gap-6 sm:text-left">
        <div>
          <p class="text-sm font-bold text-gray-900">이미 예약하셨나요?</p>
          <p class="mt-1 text-sm leading-7 text-gray-600">한국어 숙박 가이드에서 도착 항구, 셀프 체크인, Wi-Fi, BBQ 이용 규칙 등 숙박에 필요한 정보를 확인할 수 있습니다.</p>
        </div>
        <a href="/en/guest-guide/" class="mt-4 inline-flex shrink-0 rounded-full bg-green-700 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-green-600 sm:mt-0">
          숙박 가이드 열기 →
        </a>
      </div>
    </div>
  </section>

  <!-- Booking CTA -->
  <section class="relative overflow-hidden bg-green-950 py-20 text-white md:py-24" aria-labelledby="booking-en-title">
    <img src="/night-bbq.webp" alt="" class="absolute inset-0 h-full w-full object-cover opacity-20" width="1500" height="2000" loading="lazy" aria-hidden="true" />
    <div class="absolute inset-0 bg-green-950/70" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
      <p class="text-xs font-bold tracking-[0.28em] text-green-300 uppercase">Oshima New Villa</p>
      <h2 id="booking-en-title" class="mt-3 font-serif text-3xl font-bold md:text-5xl">도쿄 여행에 이즈오시마를 더해보세요.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-green-50/85 md:text-lg">
        Airbnb에서 최신 공실, 요금, 예약 조건을 확인하세요.
      </p>
      <a
        href={bookingUrl}
        data-booking-location="ko_bottom"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center rounded-full bg-white px-8 py-4 text-sm font-bold text-green-900 shadow-xl transition-all hover:-translate-y-0.5 hover:bg-green-50"
      >
        Airbnb에서 공실 확인 <span class="ml-2" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</InternationalLayout>
