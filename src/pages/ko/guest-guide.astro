---
import InternationalLayout from '../../layouts/InternationalLayout.astro';

const pageTitle = '숙박 가이드 | Oshima New Villa';
const pageDescription = '도쿄 이즈오시마 Oshima New Villa 숙박 고객을 위한 가이드입니다. 도착 항구, 버스, Wi-Fi, 셀프 체크인, 제공 물품, BBQ 이용 규칙, 부지 내 오너 소유 설비 등 숙박에 필요한 정보를 안내합니다.';

const quickLinks = [
  { label: '도착·체크인', href: '#arrival', icon: '🚢' },
  { label: 'Wi-Fi', href: '#wifi', icon: '📶' },
  { label: '제공 물품 안내', href: '#guest-info', icon: '🧳' },
  { label: '먹거리·관광·장보기', href: '#island-guide', icon: '🗺️' },
  { label: 'BBQ·가제보', href: '#bbq', icon: '🔥' },
  { label: '숲에서 보내는 시간', href: '#forest-time', icon: '🌙' },
];

const providedItems = [
  '싱글베드 4개·소파베드 2개',
  '6인용 다이닝 공간·욕실/화장실 분리',
  '냉장고·전자레인지·밥솥·토스터',
  '전기포트·가스레인지·기본 조리도구·식기류',
  '욕조·샤워·비데 기능 변기',
  '목욕 타월·페이스 타월·칫솔·실내용 슬리퍼',
  '샴푸·컨디셔너·바디워시',
  'BBQ 그릴·벤치',
  'Wi-Fi 장비(연결 및 속도는 보장되지 않음)',
];

const complimentaryItems = [
  '보드게임',
  '장난감류',
  '물총 등 물놀이 용품',
  '야외용 슬리퍼',
  '세안제',
  'Bluetooth 스피커',
];

const ownerFacilities = [
  '세탁기',
  '가스 건조기',
  '컨테이너 내 샤워 부스',
  '컨테이너 내 화장실',
];

const not제공Items = [
  '잠옷·파자마',
  '면도기',
];

const bbqCoreItems = [
  'BBQ 그릴',
  '석쇠·철판',
  '집게·작업용 장갑',
  '접이식 테이블',
  '싱크대·양동이',
];
---

<InternationalLayout locale="ko" title={pageTitle} description={pageDescription} noindex={true}>
  <div class="bg-orange-50">
    <!-- Hero -->
    <section class="relative overflow-hidden pt-24 md:pt-28">
      <div class="absolute inset-0">
        <img
          src="/forest-optimized.webp"
          alt="Forest surrounding Oshima New Villa"
          class="h-full w-full object-cover"
          width="1500"
          height="2000"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-green-950/65"></div>
      </div>
      <div class="relative mx-auto max-w-5xl px-6 py-20 text-center text-white md:py-28">
        <p class="text-xs font-bold tracking-[0.3em] text-green-200 uppercase">숙박 가이드</p>
        <h1 class="mt-4 font-serif text-4xl font-bold tracking-wide sm:text-5xl">Oshima New Villa에 오신 것을 환영합니다.</h1>
        <p class="mx-auto mt-6 max-w-2xl text-sm leading-8 text-white/90 sm:text-base">
          바다를 건너 이즈오시마의 이 숲까지 찾아와 주셔서 감사합니다.<br class="hidden sm:block" />
          섬에서의 시간을 편안하고 자유롭게 즐길 수 있도록 이 가이드를 활용해 주세요.
        </p>
        <div class="mx-auto mt-8 inline-flex rounded-full border border-white/30 bg-white/10 px-5 py-2 text-xs font-bold tracking-wide text-white/90 backdrop-blur-sm">
          숙박 고객 전용 안내
        </div>
      </div>
    </section>

    <!-- Quick navigation -->
    <section class="border-b border-orange-100 bg-white py-8">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
          {quickLinks.map((item) => (
            <a
              href={item.href}
              class="flex min-h-24 flex-col items-center justify-center rounded-2xl border border-gray-200 bg-white px-3 py-4 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-green-300 hover:shadow-md"
            >
              <span class="text-2xl" aria-hidden="true">{item.icon}</span>
              <span class="mt-2 text-xs font-bold leading-5 text-gray-800">{item.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Arrival -->
    <section id="arrival" class="scroll-mt-28 py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="max-w-3xl">
          <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">도착 전 확인</p>
          <h2 class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">도착 전에 확인해 주세요</h2>
          <p class="mt-5 leading-8 text-gray-600">이즈오시마에서는 당일 해상 상황에 따라 입항지가 달라질 수 있습니다. 출발 전에 최신 정보를 확인해 주세요.</p>
        </div>

        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          <article class="rounded-3xl border border-orange-100 bg-white p-7 shadow-sm">
            <div class="text-3xl" aria-hidden="true">🚨</div>
            <h3 class="mt-4 text-xl font-bold text-gray-900">오늘의 입항지</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">모토마치항과 오카다항 중 어디에 도착하는지 확인해 주세요. 고속 제트선의 입출항지는 보통 당일 오전 6시경 안내됩니다.</p>
            <a
              href="https://www.tokaikisen.co.jp/schedule/"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-green-700 hover:underline"
            >
              도카이기센 운항 상황 확인 <span aria-hidden="true">↗</span>
            </a>
          </article>

          <article class="rounded-3xl border border-orange-100 bg-white p-7 shadow-sm">
            <div class="text-3xl" aria-hidden="true">🚌</div>
            <h3 class="mt-4 text-xl font-bold text-gray-900">노선버스 시간표</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">가장 가까운 정류장은 “오시마코코마에(大島高校前)”이며 빌라까지 도보 약 9분입니다. 당일 입출항지에 따라 시간표가 달라질 수 있으므로 승차 전 최신 공원선 시간표를 확인해 주세요.</p>
            <a
              href="https://www.oshima-bus.com/rosen-bus.html"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-green-700 hover:underline"
            >
              오시마 버스 시간표 보기 <span aria-hidden="true">↗</span>
            </a>
          </article>

          <article class="rounded-3xl border border-orange-100 bg-white p-7 shadow-sm">
            <div class="text-3xl" aria-hidden="true">🔑</div>
            <h3 class="mt-4 text-xl font-bold text-gray-900">체크인</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">체크인은 오후 3시부터, 체크아웃은 오전 10시까지입니다. 무인 운영 시설이므로 부지 내 설치된 태블릿으로 셀프 체크인해 주세요.</p>
            <p class="mt-4 rounded-2xl bg-orange-50 px-4 py-3 text-xs font-medium leading-6 text-gray-600">모토마치항에서 차로 약 5분 / 오카다항에서 약 11분 / 오시마공항에서 약 6분</p>
          </article>
        </div>

        <div class="mt-6 rounded-3xl border-2 border-red-200 bg-red-50 p-6 md:p-7">
          <div class="flex gap-4">
            <div class="shrink-0 text-3xl" aria-hidden="true">⚠️</div>
            <div>
              <p class="text-xs font-bold tracking-[0.18em] text-red-700 uppercase">Important</p>
              <h3 class="mt-2 font-serif text-xl font-bold text-gray-900">예약하신 숙박동만 이용해 주세요</h3>
              <p class="mt-3 text-sm font-bold leading-7 text-gray-800">
                현재 숙박 가능한 동은 SALVIA뿐입니다.
              </p>
              <p class="mt-2 text-sm leading-7 text-gray-700">
                같은 부지 내 FREESIA는 영업 준비 중이므로, SALVIA를 예약하신 고객은 FREESIA 건물 내부에 출입하거나 시설을 이용하지 말아 주세요.
              </p>
              <p class="mt-2 text-xs leading-6 text-gray-600">
                FREESIA 영업 시작 후에는 예약 내용에 따라 이용 가능한 숙박동을 안내해 드립니다.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-6 rounded-3xl border border-green-100 bg-green-50/70 p-6 md:flex md:items-center md:justify-between md:gap-8">
          <div>
            <h3 class="font-serif text-lg font-bold text-gray-900">섬 내 이동은 렌터카를 추천합니다</h3>
            <p class="mt-2 text-sm leading-7 text-gray-600">미하라산, 우라사바쿠, 하부항, 고진카 온천, 장보기 장소 등을 자유롭게 둘러보려면 렌터카가 편리합니다. 차량 수가 한정되어 있으므로 숙소와 함께 일찍 예약하는 것을 추천합니다.</p>
          </div>
          <a href="https://www.oshima-navi.com/transportation/" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex shrink-0 text-sm font-bold text-green-700 hover:underline md:mt-0">섬 내 교통 안내 보기 ↗</a>
        </div>
      </div>
    </section>

    <!-- Wi-Fi -->
    <section id="wifi" class="scroll-mt-28 bg-green-950 py-16 text-white md:py-20">
      <div class="mx-auto max-w-5xl px-6">
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <p class="text-xs font-bold tracking-[0.28em] text-green-300 uppercase">Wi-Fi</p>
            <h2 class="mt-3 font-serif text-3xl font-bold">무료 Wi-Fi를 이용할 수 있습니다</h2>
            <p class="mt-5 text-sm leading-8 text-white/75">
              섬 내 통신 상황, 장애, 날씨, 장비 상태 등에 따라 일시적으로 연결이 어렵거나 속도가 느려질 수 있습니다. 항상 연결되거나 일정한 통신 속도가 유지되는 것은 보장되지 않습니다.
            </p>
            <p class="mt-3 text-sm leading-7 text-white/75">중요한 온라인 회의 등 안정적인 통신이 꼭 필요한 경우 예비 인터넷 연결 수단을 준비해 주세요.</p>
          </div>
          <div class="rounded-3xl border border-white/15 bg-white/10 p-7 backdrop-blur-sm sm:p-8">
            <p class="text-xs font-bold tracking-[0.2em] text-green-300 uppercase">연결 정보</p>
            <h3 class="mt-3 text-xl font-bold">SSID와 비밀번호는 빌라 내부에 안내되어 있습니다</h3>
            <p class="mt-4 text-sm leading-7 text-white/75">
              보안을 위해 Wi-Fi 접속 정보는 웹사이트에 공개하지 않습니다. 숙박 시 시설 내부에 표시된 안내를 확인해 주세요.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Guest info -->
    <section id="guest-info" class="scroll-mt-28 py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="max-w-3xl">
          <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">숙박 안내</p>
          <h2 class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">있는 것·없는 것</h2>
          <p class="mt-5 leading-8 text-gray-600">
            숙박시설로 제공되는 것, 무료로 이용할 수 있으나 제공을 보장하지 않는 것, 기본적으로 제공하지 않는 것의 세 가지로 나누어 안내합니다.
          </p>
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-3">
          <article class="rounded-3xl border border-green-200 bg-green-50 p-7">
            <p class="text-xs font-bold tracking-[0.2em] text-green-700 uppercase">제공</p>
            <h3 class="mt-2 text-xl font-bold text-gray-900">숙박 시 제공되는 것</h3>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-gray-700">
              {providedItems.map((item) => (
                <li class="flex gap-3"><span class="mt-0.5 text-green-700" aria-hidden="true">●</span><span>{item}</span></li>
              ))}
            </ul>
            <p class="mt-5 border-t border-green-200 pt-5 text-xs leading-6 text-green-950/75">
              숙박시설과 기본 어메니티로 제공하는 주요 품목입니다. Wi-Fi 장비는 제공되지만 연결 관련 안내는 위 내용을 확인해 주세요.
            </p>
          </article>

          <article class="rounded-3xl border border-sky-200 bg-sky-50 p-7">
            <p class="text-xs font-bold tracking-[0.2em] text-sky-800 uppercase">무료 이용 가능</p>
            <h3 class="mt-2 text-xl font-bold text-gray-900">무료로 이용할 수 있는 경우가 있습니다</h3>
            <p class="mt-4 text-sm leading-7 text-gray-700">무료 대여·서비스 품목</p>
            <ul class="mt-3 space-y-3 text-sm leading-7 text-gray-700">
              {complimentaryItems.map((item) => (
                <li class="flex gap-3"><span class="mt-0.5 text-sky-700" aria-hidden="true">●</span><span>{item}</span></li>
              ))}
            </ul>
            <p class="mt-5 text-xs leading-6 text-sky-950/75">
              숙박시설이나 기본 어메니티에 포함되지 않습니다. 품목·종류·수량은 변경될 수 있으며 파손, 분실, 보충 상황 등에 따라 이용할 수 없을 수 있습니다. 특정 품목의 상시 제공은 보장되지 않습니다.
            </p>

            <div class="mt-6 border-t border-sky-200 pt-6">
              <p class="text-sm font-bold text-gray-900">부지 내 오너 소유 설비</p>
              <ul class="mt-3 space-y-3 text-sm leading-7 text-gray-700">
                {ownerFacilities.map((item) => (
                  <li class="flex gap-3"><span class="mt-0.5 text-sky-700" aria-hidden="true">●</span><span>{item}</span></li>
                ))}
              </ul>
              <p class="mt-4 text-xs leading-6 text-sky-950/75">
                이 설비는 같은 부지 내에서 오너가 소유·관리하고 있습니다. <strong>Oshima New Villa의 숙박시설 또는 부대시설에는 포함되지 않습니다.</strong> 이용 가능한 경우 숙박 고객이 무료로 사용할 수 있으나, 점검·고장·청소 등의 이유로 이용하지 못할 수 있습니다.
              </p>
            </div>
          </article>

          <article class="rounded-3xl border border-amber-200 bg-amber-50 p-7">
            <p class="text-xs font-bold tracking-[0.2em] text-amber-800 uppercase">미제공</p>
            <h3 class="mt-2 text-xl font-bold text-gray-900">기본적으로 제공하지 않습니다</h3>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-gray-700">
              {not제공Items.map((item) => (
                <li class="flex gap-3"><span class="mt-0.5 text-amber-700" aria-hidden="true">●</span><span>{item}</span></li>
              ))}
            </ul>
            <p class="mt-5 border-t border-amber-200 pt-5 text-xs leading-6 text-amber-950/75">
              필요한 경우 직접 준비해 주세요.
            </p>

            <div class="mt-6 rounded-2xl border border-amber-200 bg-white/80 p-5">
              <p class="text-sm font-bold text-gray-900">🔥 BBQ를 이용하는 경우에만</p>
              <p class="mt-2 text-xs leading-6 text-gray-600">
                숯, 착화제, 긴 점화 라이터, 음식과 음료는 제공하지 않습니다. BBQ를 이용할 경우에만 필요한 물품을 준비해 주세요.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Island guide -->
    <section id="island-guide" class="scroll-mt-28 bg-white py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="text-center">
          <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">오시마에서</p>
          <h2 class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">먹고, 즐기고, 장보기</h2>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          <a
            href="https://app.notion.com/p/2e024b6861ae80a5baf2f65672232b32?pvs=21"
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-3xl border border-gray-200 bg-orange-50 p-7 transition hover:-translate-y-1 hover:shadow-lg"
          >
            <span class="text-3xl" aria-hidden="true">🍴</span>
            <h3 class="mt-4 text-xl font-bold text-gray-900">먹거리</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">저희 팀과 현지 주민이 추천하는 모토마치 먹거리 가이드입니다.</p>
            <p class="mt-5 text-sm font-bold text-green-700">먹거리 가이드 보기 <span aria-hidden="true">↗</span></p>
          </a>
          <a
            href="https://www.izu-oshima.or.jp/play.html"
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-3xl border border-gray-200 bg-orange-50 p-7 transition hover:-translate-y-1 hover:shadow-lg"
          >
            <span class="text-3xl" aria-hidden="true">🌋</span>
            <h3 class="mt-4 text-xl font-bold text-gray-900">즐길 거리</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">자연, 액티비티, 관광지의 최신 정보는 이즈오시마 관광협회도 함께 확인해 주세요.</p>
            <p class="mt-5 text-sm font-bold text-green-700">관광협회 보기 <span aria-hidden="true">↗</span></p>
          </a>
          <a
            href="/#shopping-guide"
            class="group rounded-3xl border border-gray-200 bg-orange-50 p-7 transition hover:-translate-y-1 hover:shadow-lg"
          >
            <span class="text-3xl" aria-hidden="true">🛒</span>
            <h3 class="mt-4 text-xl font-bold text-gray-900">장보기</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">BBQ 식재료, 식료품, 음료, 생활용품을 구입할 수 있는 장소를 확인하세요.</p>
            <p class="mt-5 text-sm font-bold text-green-700">장보기 정보 보기 <span aria-hidden="true">↗</span></p>
          </a>
