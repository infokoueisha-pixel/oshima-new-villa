---
import InternationalLayout from '../../layouts/InternationalLayout.astro';
const pageTitle = '숙박 가이드 | 예약 유형 선택 | Oshima New Villa';
const pageDescription = 'Oshima New Villa 숙박 고객용 가이드입니다. SALVIA, FREESIA 또는 두 동 동시 예약 중 예약 유형을 선택해 주세요.';
---

<InternationalLayout locale="ko" title={pageTitle} description={pageDescription} noindex={true}>
  <main class="min-h-screen bg-orange-50 pt-24 md:pt-28">
    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">숙박 가이드</p>
          <h1 class="mt-4 font-serif text-4xl font-bold text-gray-900 md:text-5xl">예약하신 숙박 유형을 선택해 주세요</h1>
          <p class="mx-auto mt-6 max-w-2xl text-sm leading-8 text-gray-600 md:text-base">예약 확인서에 표시된 유형을 선택하면 이용 가능한 시설과 BBQ 장소에 맞는 안내를 확인할 수 있습니다.</p>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
        <a href="/ko/guest-guide/salvia/" class="group rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-lg">
          <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">최대 6명</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-gray-900">SALVIA</h2>
          <p class="mt-3 text-sm leading-7 text-gray-600">BBQ는 가제보</p>
          <span class="mt-6 inline-flex text-sm font-bold text-green-800">가이드 열기 <span class="ml-1 transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        <a href="/ko/guest-guide/freesia/" class="group rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-lg">
          <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">최대 3명</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-gray-900">FREESIA</h2>
          <p class="mt-3 text-sm leading-7 text-gray-600">BBQ는 전용 우드데크</p>
          <span class="mt-6 inline-flex text-sm font-bold text-green-800">가이드 열기 <span class="ml-1 transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        <a href="/ko/guest-guide/salvia-freesia/" class="group rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-lg">
          <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">두 동 합계 최대 9명</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-gray-900">SALVIA + FREESIA</h2>
          <p class="mt-3 text-sm leading-7 text-gray-600">가제보 이용 가능</p>
          <span class="mt-6 inline-flex text-sm font-bold text-green-800">가이드 열기 <span class="ml-1 transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        </div>
        <p class="mx-auto mt-8 max-w-2xl text-center text-xs leading-6 text-gray-500">숙박 전 안내 메시지에서는 보통 해당 가이드로 직접 안내합니다.</p>
      </div>
    </section>
  </main>
</InternationalLayout>
