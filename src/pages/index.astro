---
import Layout from '../layouts/Layout.astro';

const heroImages = [
  { src: '/main-optimized.webp', srcset: '/main-optimized-640.webp 640w, /main-optimized-960.webp 960w, /main-optimized.webp 1170w', alt: '大島ニュービラの外観と豊かな自然', width: 1170, height: 1171 },
  { src: '/sea-of-izu-oshima.webp', srcset: '/sea-of-izu-oshima-640.webp 640w, /sea-of-izu-oshima-960.webp 960w, /sea-of-izu-oshima.webp 2000w', alt: '伊豆大島の美しい海と夕景', width: 2000, height: 1500 },
  { src: '/forest-optimized.webp', srcset: '/forest-optimized-640.webp 640w, /forest-optimized-960.webp 960w, /forest-optimized.webp 1500w', alt: '施設を囲む静かな森', width: 1500, height: 2000 },
];

const appeals = [
  {
    id: 'private-time',
    number: '01',
    title: '観光のあとも、みんなの時間',
    subtitle: 'Private Villa',
    description:
      '三原山や裏砂漠などを楽しんだあとは、森に囲まれた一棟貸しへ。最大6名で過ごせるリビングやボードゲームを備え、周囲を気にせず、家族や友人との食事や会話をゆっくり楽しめます。',
    image: { src: '/sofa-salvia.webp', alt: '家族や友人とくつろげる大島ニュービラのリビング', width: 1108, height: 832 },
    subImages: [
      { src: '/bed-salvia.webp', alt: 'シングルベッド4台を備えた寝室', width: 1477, height: 994 },
      { src: '/forest-optimized.webp', alt: '大島ニュービラを囲む静かな森', width: 1500, height: 2000 },
    ],
    href: '#gallery',
    linkLabel: '客室・間取りを見る',
  },
  {
    id: 'cooking',
    number: '02',
    title: '島の食材を、好きなかたちで',
    subtitle: 'Local Dining',
    description:
      '室内キッチンには冷蔵庫・電子レンジ・炊飯器・調理器具などを用意。専用の屋外炊事場「ガゼボ庵」ではBBQも楽しめます。地元のスーパーで食材を選ぶ時間から、伊豆大島の食体験が始まります。',
    image: { src: '/night-bbq.webp', alt: '夜にライトアップされた屋外炊事場のガゼボ庵', width: 1500, height: 2000 },
    subImages: [
      { src: '/day-bbq.webp', alt: '昼間のガゼボ庵の外観', width: 1376, height: 2000 },
      { src: '/bbq-gazebo.webp', alt: 'ガゼボ庵に備えられたBBQコンロとベンチ', width: 1500, height: 2000 },
    ],
    href: '#shopping-guide',
    linkLabel: '買い出し先を見る',
  },
  {
    id: 'checkin',
    number: '03',
    title: '到着後は、自分たちのペースで',
    subtitle: 'Self Check-in',
    description:
      '敷地内コンテナに設置したタブレットでチェックイン。対面での長い手続きをせず、到着後は荷物を置いて、そのまま御神火温泉や買い出し、夕方の海辺へ向かえます。滞在中も一棟貸切なので、自分たちのペースでお過ごしください。',
    image: { src: '/checkin-tablet.webp', alt: '大島ニュービラの無人チェックイン用タブレット', width: 489, height: 489 },
    subImages: [
      { src: '/day-salvia.webp', alt: 'リニューアルしたサルビア棟の外観', width: 1500, height: 2000 },
      { src: '/mihara-mountain-view.webp', alt: '大島ニュービラのスタッフが撮影した三原山の景観', width: 1536, height: 1152 },
    ],
    href: '#facilities',
    linkLabel: '設備・よくある質問を見る',
  },
];


const facilityGroups = [
  {
    title: '寝具・室内',
    description: '最大6名で、食事も就寝も一棟の中でゆったり過ごせます。',
    items: ['シングルベッド4台', 'ソファベッド2台', '6名で囲めるダイニング', 'バス・トイレ別'],
  },
  {
    title: 'キッチン・調理',
    description: '島で買った食材を、室内で好きな時間に調理できます。',
    items: ['冷蔵庫・電子レンジ', '炊飯器・トースター', '電気ケトル・ガスコンロ', '包丁・まな板・フライパン・食器類'],
  },
  {
    title: '屋外BBQ',
    description: '屋根付きの屋外炊事場「ガゼボ庵」をご利用いただけます。',
    items: ['宿泊者専用スペース', 'BBQコンロ・ベンチ', '雨を避けやすい屋根付き', '強風時は利用をお控えください'],
  },
  {
    title: 'バス・アメニティ',
    description: '棟内に浴槽とシャワーを備えています。どこか懐かしさのあるタイル浴室で、グループ旅行では御神火温泉を組み合わせるのもおすすめです。',
    items: ['浴槽・シャワー', 'バスタオル・フェイスタオル', '歯ブラシ・スリッパ', 'シャンプー・リンス・ボディソープ', '温水洗浄便座'],
  },
  {
    title: 'Wi-Fi・室内時間',
    description: '観光後の夜や天候が変わった日も、室内でゆっくり楽しめます。',
    items: ['無料Wi-Fi', 'スマートTV', '動画配信サービスに対応', 'ボードゲーム'],
  },
  {
    title: 'チェックイン',
    description: '敷地内のタブレットを使った無人受付で、到着後も自分たちのペースで。',
    items: ['チェックイン 15:00〜', 'チェックアウト 10:00まで', 'タブレットで無人受付', '一棟貸切で滞在'],
  },
];

const stayFaqItems = [
  {
    question: 'チェックインとチェックアウトの時間は？',
    answer: 'チェックインは15:00から、チェックアウトは10:00までです。敷地内のタブレットを使用した無人受付となります。',
    href: null,
    linkLabel: null,
  },
  {
    question: 'バーベキューはできますか？',
    answer: 'はい。屋根付きの屋外炊事場「ガゼボ庵」をご利用いただけます。強風時は使用をお控えいただき、使用後の炭や灰は完全に消火してください。',
    href: null,
    linkLabel: null,
  },
  {
    question: '自炊に必要な調理器具はありますか？',
    answer: '冷蔵庫、電子レンジ、炊飯器、トースター、電気ケトル、ガスコンロのほか、包丁、まな板、フライパン、食器、コップ、箸・カトラリー類などを用意しています。',
    href: null,
    linkLabel: null,
  },
  {
    question: 'タオルや歯ブラシはありますか？',
    answer: 'バスタオル、フェイスタオル、歯ブラシ、スリッパを用意しています。浴室にはシャンプー、リンス、ボディソープがあります。',
    href: null,
    linkLabel: null,
  },
  {
    question: '宿にお風呂はありますか？',
    answer: 'はい。サルビア棟内に浴槽とシャワーを備えた浴室があります。6名などのグループ旅行では、複数人が同じ時間帯に入浴しやすい「愛らんどセンター御神火温泉」を利用すると、入浴の順番待ちを減らし、夜の時間を確保しやすくなります。',
    href: null,
    linkLabel: null,
  },
  {
    question: 'Netflixなどの動画配信サービスは見られますか？',
    answer: 'リビングのスマートTVで、YouTube、Netflix、Amazon Primeなどを利用できます。有料サービスはご自身のアカウントでログインしてください。',
    href: null,
    linkLabel: null,
  },
  {
    question: '伊豆大島での移動にレンタカーは必要ですか？',
    answer: '観光や買い出しを自由に楽しむため、レンタカーの利用をおすすめしています。港や空港からの所要時間は、ページ内のアクセス案内をご確認ください。',
    href: '#access',
    linkLabel: 'アクセス案内を見る',
  },
  {
    question: '到着する港は元町港と岡田港のどちらですか？',
    answer: '当日の海況によって元町港または岡田港に決まります。出発前に東海汽船の案内をご確認ください。',
    href: '#access',
    linkLabel: '港からの行き方を見る',
  },
  {
    question: '室内で喫煙できますか？',
    answer: '室内は完全禁煙です。喫煙は屋外でお願いいたします。',
    href: null,
    linkLabel: null,
  },
  {
    question: 'ペットと一緒に泊まれますか？',
    answer: '申し訳ございませんが、ペット同伴での宿泊はお受けしていません。',
    href: null,
    linkLabel: null,
  },
];

const islandFaqItems = [
  {
    question: '伊豆大島は1泊2日でも楽しめますか？',
    answer: 'はい。船や飛行機の到着時刻、天候にもよりますが、1泊2日でも三原山や裏砂漠などの自然、島の南部、港町などを組み合わせて楽しめます。このページでは、初めての方向けのモデルコースを紹介しています。',
    href: '#itinerary',
    linkLabel: '1泊2日モデルコースを見る',
  },
  {
    question: '初めての伊豆大島旅行でも大丈夫ですか？',
    answer: 'はい。到着港が当日に決まることがあるため、出発前に港を確認しておくのがポイントです。島内を自由に巡るならレンタカーがおすすめです。元町港・岡田港・大島空港からのアクセスもページ内にまとめています。',
    href: '#access',
    linkLabel: 'アクセス案内を見る',
  },
  {
    question: '家族や友人6人で泊まれますか？',
    answer: 'はい。サルビア棟は最大6名の一棟貸しです。シングルベッド4台とソファベッド2台を備え、リビングやダイニングも一緒に過ごせるつくりになっています。',
    href: '#gallery',
    linkLabel: '客室・間取りを見る',
  },
  {
    question: '雨の日はどう過ごせますか？',
    answer: '天候に合わせてジオノスなどの屋内施設を旅程に入れたり、ヴィラで料理、ボードゲーム、スマートTVなどを楽しんだりできます。予定を詰め込みすぎず、島の天候に合わせて過ごし方を変えるのがおすすめです。',
    href: '#facilities',
    linkLabel: '室内設備を見る',
  },
  {
    question: 'BBQの食材や翌朝の朝食は島で買えますか？',
    answer: 'はい。元町周辺を中心に食料品を購入できるお店があります。BBQの食材、飲み物、翌朝の朝食をまとめて買っておくと、ヴィラ到着後をゆっくり過ごせます。ページ内に買い出し先をまとめています。',
    href: '#shopping-guide',
    linkLabel: 'スーパー＆食料品店を見る',
  },
  {
    question: '夕焼けや星空はいつでも見られますか？',
    answer: '天候や雲の状況に左右されるため、必ず見られるものではありません。晴れた日は、夕方に海辺へ寄り道したり、夜に空を見上げたりする時間も伊豆大島ならではの楽しみのひとつです。',
    href: '#sunset-sky-guide',
    linkLabel: '夕焼けと星空の景色を見る',
  },
];

const galleryImages = [
  {
    src: '/sofa-salvia.webp',
    alt: 'ソファベッド2台を備えたサルビア棟のリビング',
    title: 'リビング',
    description: '食事や会話を楽しめるリビング。2台のソファは、就寝時にはソファベッドとして利用できます。',
    span: 'md:col-span-7',
    aspect: 'aspect-[4/3]',
    width: 1108,
    height: 832,
  },
  {
    src: '/bed-salvia.webp',
    alt: 'シングルベッド4台を備えたサルビア棟の寝室',
    title: 'ベッドスペース',
    description: 'シングルベッド4台を並べ、グループでも休みやすくしています。',
    span: 'md:col-span-5',
    aspect: 'aspect-[4/3]',
    width: 1477,
    height: 994,
  },
  {
    src: '/day-bbq.webp',
    alt: '屋根付きの屋外炊事場ガゼボ庵',
    title: '屋外炊事場「ガゼボ庵」',
    description: '屋根付きの専用スペースで、家族や友人とBBQを楽しめます。',
    span: 'md:col-span-5',
    aspect: 'aspect-[4/3]',
    width: 1376,
    height: 2000,
  },
  {
    src: '/main-optimized.webp',
    alt: '森に囲まれた大島ニュービラのサルビア棟',
    title: '森に囲まれた一棟貸し',
    description: '周囲の自然を感じながら、自分たちだけの時間を過ごせます。',
    span: 'md:col-span-7',
    aspect: 'aspect-[4/3]',
    width: 1170,
    height: 1171,
  },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative flex min-h-[100svh] items-center justify-center overflow-hidden" aria-label="ヒーロー">
    <!-- Background slider -->
    <div class="absolute inset-0" aria-hidden="true">
      {
        heroImages.map((img, i) => (
          <img
            src={img.src}
            srcset={img.srcset}
            sizes="100vw"
            alt=""
            class:list={[
              'hero-slide absolute inset-0 h-full w-full object-cover',
              i === 0 && 'opacity-100',
              i !== 0 && 'opacity-0',
            ]}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            width={img.width}
            height={img.height}
          />
        ))
      }
    </div>

    <!-- Light warm overlay (明るく開放的なオーバーレイに変更) -->
    <div class="absolute inset-0 bg-white/40" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-5xl px-6 pt-24 pb-12 text-center sm:pb-16">
      <p class="mb-4 text-xs font-bold tracking-[0.24em] text-green-900 uppercase drop-shadow-md sm:tracking-[0.35em]">
        伊豆大島の一棟貸し<span class="mx-2" aria-hidden="true">｜</span>Since 1975
      </p>
      <h1 class="font-serif text-4xl leading-tight font-bold tracking-wide text-gray-900 drop-shadow-lg sm:text-5xl md:text-6xl lg:text-7xl">
        森と眠る、<br class="sm:hidden" />心の再生
      </h1>
      <p class="mt-5 font-serif text-lg font-bold tracking-wide text-green-900 drop-shadow-md md:text-xl">
        大島を遊ぶ。森に帰る。
      </p>
      <p class="mx-auto mt-5 max-w-2xl text-sm font-medium leading-7 text-gray-800 drop-shadow-md sm:text-base md:text-lg md:leading-8">
        三原山や裏砂漠など、伊豆大島の自然を楽しんだあとは森に囲まれたヴィラへ。<br class="hidden md:block" />
        家族や友人と、BBQや静かな夜を楽しめる一棟貸しの宿です。
      </p>

      <ul class="mx-auto mt-7 flex max-w-3xl flex-wrap justify-center gap-2 text-xs font-bold text-gray-800 sm:gap-3 sm:text-sm" aria-label="施設の主な特徴">
        <li class="rounded-full border border-white/70 bg-white/85 px-4 py-2 shadow-sm backdrop-blur-sm">一棟貸切</li>
        <li class="rounded-full border border-white/70 bg-white/85 px-4 py-2 shadow-sm backdrop-blur-sm">最大6名</li>
        <li class="rounded-full border border-white/70 bg-white/85 px-4 py-2 shadow-sm backdrop-blur-sm">BBQ・自炊</li>
        <li class="rounded-full border border-white/70 bg-white/85 px-4 py-2 shadow-sm backdrop-blur-sm">元町港から車約5分</li>
      </ul>

      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center sm:gap-4">
        <a href="#booking" data-booking-location="hero" class="w-full max-w-xs rounded-full bg-green-700 px-8 py-3.5 text-sm font-bold tracking-wide text-white shadow-lg transition-all hover:-translate-y-0.5 hover:bg-green-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-green-800 sm:w-auto">
          空室・料金を確認する
        </a>
        <a href="#story" class="w-full max-w-xs rounded-full border-2 border-gray-900 bg-white/90 px-8 py-3.5 text-sm font-bold tracking-wide text-gray-900 transition-colors hover:bg-gray-900 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gray-900 sm:w-auto">
          1975年からの物語
        </a>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section id="story" class="bg-orange-50 py-20 md:py-28" aria-labelledby="story-title">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto mb-14 max-w-3xl text-center md:mb-16">
        <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">Our Story</p>
        <h2 id="story-title" class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">
          1975年から、もう一度。
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-gray-600 md:text-lg">
          約15年の時を経て、大島ニュービラが再び始まりました。
        </p>
      </div>

      <!-- 1975年のパンフレットと施設の歩み -->
      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
        <figure class="lg:col-span-6">
          <img
            src="/old-brochure.webp"
            alt="1975年当時の大島ニュービラのパンフレット"
            class="w-full rounded-2xl object-cover shadow-xl"
            loading="lazy"
            width="1024"
            height="1054"
          />
          <figcaption class="mt-3 text-center text-xs leading-relaxed text-gray-500 md:text-sm">
            1975年当時のパンフレット。開業時の大島ニュービラの面影を今に伝える資料です。
          </figcaption>
        </figure>

        <div class="lg:col-span-6">
          <div class="space-y-5 text-base leading-8 text-gray-700 md:text-lg md:leading-9">
            <p>
              1975年、伊豆大島の森の中に開業した「大島ニュービラ」。
            </p>
            <p>
              島を訪れる人を迎えてきたこの施設は、その後、約15年間にわたり静かに扉を閉じていました。
            </p>
            <p>
              2026年、当時の面影を大切に残しながら、建物を丁寧にリノベーション。家族や友人と過ごせる一棟貸しの宿として、再びゲストをお迎えしています。
            </p>
          </div>

          <ol class="mt-9 grid gap-3 sm:grid-cols-3" aria-label="大島ニュービラの歩み">
            <li class="rounded-xl border border-orange-100 bg-white px-5 py-4 shadow-sm">
              <p class="font-serif text-2xl font-bold text-green-800">1975</p>
              <p class="mt-1 text-sm font-medium text-gray-600">開業</p>
            </li>
            <li class="rounded-xl border border-orange-100 bg-white px-5 py-4 shadow-sm">
              <p class="font-serif text-2xl font-bold text-green-800">約15年間</p>
              <p class="mt-1 text-sm font-medium text-gray-600">休館</p>
            </li>
            <li class="rounded-xl border border-orange-100 bg-white px-5 py-4 shadow-sm">
              <p class="font-serif text-2xl font-bold text-green-800">2026</p>
              <p class="mt-1 text-sm font-medium text-gray-600">リニューアルオープン</p>
            </li>
          </ol>
        </div>
      </div>

      <!-- 変わったもの、変わらないもの -->
      <div class="mt-16 grid items-center gap-10 lg:mt-20 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5">
          <p class="text-xs font-bold tracking-[0.25em] text-green-700 uppercase">Then and Now</p>
          <h3 class="mt-3 font-serif text-2xl font-bold leading-snug text-gray-900 md:text-3xl">
            森は、ずっとここにありました。
          </h3>
          <div class="mt-6 space-y-5 text-base leading-8 text-gray-700 md:text-lg md:leading-9">
            <p>
              変わったものも、変わらないものもあります。鳥の声、木々に包まれる静けさ、そして大切な人とゆっくり過ごせる時間。
            </p>
            <p>
              昔を知る方にも、これから初めて訪れる方にも、ここで新しい思い出が生まれることを願っています。
            </p>
          </div>

          <div class="mt-8 rounded-2xl bg-white p-6 shadow-sm">
            <p class="font-serif text-lg font-bold text-gray-900">現在の大島ニュービラ</p>
            <p class="mt-2 text-sm leading-7 text-gray-600">
              一棟貸切・最大6名。森に囲まれた環境で、家族や友人との時間を気兼ねなくお過ごしいただけます。
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 lg:col-span-7 md:gap-6">
          <figure>
            <img
              src="/day-salvia.webp"
              alt="リニューアルした現在の大島ニュービラの外観"
              class="aspect-[3/4] w-full rounded-2xl object-cover shadow-lg"
              loading="lazy"
