      async function loadCancellationPreview() {
        if (!cancellationTarget) return;
        const token = sessionStorage.getItem(TOKEN_KEY);
        if (!token) {
          closeCancellationModal();
          setAuthMessage('管理者トークンを再入力してください。');
          authPanel.classList.remove('hidden');
          dashboard.classList.add('hidden');
          return;
        }

        cancellationPreviewButton.disabled = true;
        cancellationPreviewButton.textContent = '計算中…';
        cancellationPreviewError.classList.add('hidden');

        try {
          const response = await fetch(CANCELLATION_PREVIEW_URL, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({
              booking_code: cancellationTarget.public_booking_code,
              reason_code: cancellationReason.value,
            }),
          });

          const data = await response.json().catch(() => null);

          if (response.status === 401) {
            sessionStorage.removeItem(TOKEN_KEY);
            throw new Error('管理者トークンが一致しません。');
          }

          if (!response.ok || !data?.ok || !data.cancellation) {
            if (data?.error === 'booking_not_cancellable') {
              throw new Error('この予約は現在キャンセル・返金対象ではありません。');
            }
            throw new Error('キャンセル料を計算できませんでした。');
          }

          const cancellation = data.cancellation;
          cancellationPreviewData = data;
          previewDays.textContent = `${cancellation.days_until_check_in}日`;
          previewRate.textContent = `${cancellation.policy_rate}%`;
          previewFee.textContent = yen.format(Number(cancellation.cancellation_fee_jpy || 0));
          previewRefund.textContent = yen.format(Number(cancellation.refund_amount_jpy || 0));
          previewPolicyNote.textContent = `${reasonLabel(cancellation.reason_code)}として計算。宿泊料金 ${yen.format(Number(data.booking?.total_jpy || cancellationTarget.total_jpy || 0))} に対し、キャンセル料 ${cancellation.policy_rate}% を適用しています。`;
          cancellationPreviewPlaceholder.classList.add('hidden');
          cancellationPreviewResult.classList.remove('hidden');
          cancellationExecuteSummary.textContent = `${cancellationTarget.public_booking_code} をキャンセルし、${yen.format(Number(cancellation.refund_amount_jpy || 0))} をStripeで返金します。キャンセル料は ${yen.format(Number(cancellation.cancellation_fee_jpy || 0))}（${cancellation.policy_rate}%）です。`;
          cancellationFinalConfirm.checked = false;
          cancellationConfirmCode.value = '';
          cancellationConfirmCodeGuide.textContent = `「${cancellationTarget.public_booking_code}」と入力したときだけ実行できます。`;
          cancellationExecuteButton.textContent = Number(cancellation.refund_amount_jpy || 0) > 0
            ? `${yen.format(Number(cancellation.refund_amount_jpy || 0))}を返金して予約をキャンセル`
            : '返金なしで予約をキャンセル';
          cancellationExecutePanel.classList.remove('hidden');
          syncCancellationExecuteButton();
          cancellationSuccess.classList.add('hidden');
        } catch (error) {
          cancellationPreviewError.textContent = error instanceof Error ? error.message : 'キャンセル料を計算できませんでした。';
          cancellationPreviewError.classList.remove('hidden');
          cancellationPreviewResult.classList.add('hidden');
          cancellationPreviewPlaceholder.classList.remove('hidden');
          cancellationPreviewData = null;
          cancellationExecutePanel.classList.add('hidden');
          cancellationFinalConfirm.checked = false;
          cancellationConfirmCode.value = '';
          syncCancellationExecuteButton();
        } finally {
          cancellationPreviewButton.disabled = false;
          cancellationPreviewButton.textContent = '返金額を再計算';
        }
      }

      async function executeCancellationRefund() {
        if (!cancellationTarget || !cancellationPreviewData?.cancellation) return;
        if (!cancellationFinalConfirm.checked) return;
        if (cancellationConfirmCode.value.trim() !== cancellationTarget.public_booking_code) return;

        const refundAmount = Number(cancellationPreviewData.cancellation.refund_amount_jpy || 0);
        const finalMessage = refundAmount > 0
          ? `${yen.format(refundAmount)}をStripeで返金し、予約 ${cancellationTarget.public_booking_code} をキャンセルします。\n\nこの操作は取り消せません。実行しますか？`
          : `返金なしで予約 ${cancellationTarget.public_booking_code} をキャンセルします。\n\nこの操作は取り消せません。実行しますか？`;

        if (!window.confirm(finalMessage)) return;

        const token = sessionStorage.getItem(TOKEN_KEY);
        if (!token) {
          closeCancellationModal();
          setAuthMessage('管理者トークンを再入力してください。');
          authPanel.classList.remove('hidden');
          dashboard.classList.add('hidden');
          return;
        }

        cancellationExecuteButton.disabled = true;
        cancellationPreviewButton.disabled = true;
        cancellationCancelButton.disabled = true;
        cancellationModalClose.disabled = true;
        cancellationExecuteButton.textContent = '返金処理中…';
        cancellationPreviewError.classList.add('hidden');

        try {
          const response = await fetch(CANCEL_REFUND_URL, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({
              booking_code: cancellationTarget.public_booking_code,
              reason_code: cancellationReason.value,
              admin_note: cancellationAdminNote.value.trim(),
              confirm: true,
            }),
          });

          const data = await response.json().catch(() => null);

          if (response.status === 401) {
            sessionStorage.removeItem(TOKEN_KEY);
            throw new Error('管理者トークンが一致しません。');
          }

          if (!response.ok || !data?.ok) {
            if (data?.error === 'already_cancelled') {
              throw new Error('この予約はすでにキャンセル・返金処理済みです。');
            }
            if (data?.error === 'stripe_refund_failed') {
              throw new Error('Stripe返金に失敗しました。予約はキャンセル確定していません。Stripeと履歴を確認してください。');
            }
            if (data?.error === 'booking_not_cancellable') {
              throw new Error('この予約は現在キャンセル・返金対象ではありません。');
            }
            throw new Error('返金・キャンセル処理を完了できませんでした。');
          }

          const refund = Number(data.cancellation?.refund_amount_jpy || 0);
          cancellationExecutePanel.classList.add('hidden');
          cancellationPreviewButton.classList.add('hidden');
          cancellationSafetyNote.classList.add('hidden');
          cancellationSuccessDetail.textContent = refund > 0
            ? `${yen.format(refund)} のStripe返金が ${data.stripe?.refund_status === 'succeeded' ? '完了' : '受付'}されました。予約はキャンセル済みとなり、在庫も解放されました。${data.stripe?.refund_id ? ` 返金ID: ${data.stripe.refund_id}` : ''}`
            : '予約をキャンセルし、在庫を解放しました。今回の返金額は¥0です。';
          cancellationSuccess.classList.remove('hidden');

          await loadBookings(token);
        } catch (error) {
          cancellationPreviewError.textContent = error instanceof Error ? error.message : '返金・キャンセル処理を完了できませんでした。';
          cancellationPreviewError.classList.remove('hidden');
          syncCancellationExecuteButton();
          cancellationExecuteButton.textContent = cancellationPreviewData?.cancellation?.refund_amount_jpy > 0
            ? `${yen.format(Number(cancellationPreviewData.cancellation.refund_amount_jpy))}を返金して予約をキャンセル`
            : '返金なしで予約をキャンセル';
        } finally {
          cancellationPreviewButton.disabled = false;
          cancellationCancelButton.disabled = false;
          cancellationModalClose.disabled = false;
          syncCancellationExecuteButton();
        }
      }

      async function loadBookings(token) {
        loadingState.classList.remove('hidden');
        emptyState.classList.add('hidden');
        authSubmit.disabled = true;
        refreshButton.disabled = true;

        try {
          const response = await fetch(API_URL, {
            method: 'GET',
            headers: {
              Authorization: `Bearer ${token}`,
            },
          });

          const data = await response.json().catch(() => null);

          if (response.status === 401) {
            sessionStorage.removeItem(TOKEN_KEY);
            throw new Error('管理者トークンが一致しません。');
          }

          if (!response.ok || !data?.ok || !Array.isArray(data.bookings)) {
            throw new Error('予約一覧を取得できませんでした。');
          }

          bookings = data.bookings;
          sessionStorage.setItem(TOKEN_KEY, token);
          authPanel.classList.add('hidden');
          dashboard.classList.remove('hidden');
          refreshButton.classList.remove('hidden');
          refreshButton.classList.add('inline-flex');
          logoutButton.classList.remove('hidden');
          logoutButton.classList.add('inline-flex');
          updateSummary();
          render();
        } catch (error) {
          dashboard.classList.add('hidden');
          authPanel.classList.remove('hidden');
          setAuthMessage(error instanceof Error ? error.message : '予約一覧を取得できませんでした。');
        } finally {
          loadingState.classList.add('hidden');
          authSubmit.disabled = false;
          refreshButton.disabled = false;
        }
      }

      authForm.addEventListener('submit', (event) => {
        event.preventDefault();
        authMessage.classList.add('hidden');
        const token = tokenInput.value.trim();
        if (!token) return;
        loadBookings(token);
      });

      refreshButton.addEventListener('click', () => {
        const token = sessionStorage.getItem(TOKEN_KEY);
        if (token) loadBookings(token);
      });

      logoutButton.addEventListener('click', () => {
        sessionStorage.removeItem(TOKEN_KEY);
        tokenInput.value = '';
        bookings = [];
        dashboard.classList.add('hidden');
        refreshButton.classList.add('hidden');
        refreshButton.classList.remove('inline-flex');
        logoutButton.classList.add('hidden');
        logoutButton.classList.remove('inline-flex');
        authPanel.classList.remove('hidden');
        authMessage.classList.add('hidden');
        tokenInput.focus();
      });

      searchInput.addEventListener('input', render);

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activeFilter = button.dataset.filter || 'all';
          filterButtons.forEach((item) => {
            const active = item === button;
            item.classList.toggle('bg-green-800', active);
            item.classList.toggle('text-white', active);
            item.classList.toggle('border', !active);
            item.classList.toggle('border-stone-300', !active);
            item.classList.toggle('bg-white', !active);
            item.classList.toggle('text-gray-700', !active);
          });
          render();
        });
      });

      dashboard.addEventListener('click', (event) => {
        const detailTarget = event.target.closest('[data-booking-detail]');
        if (detailTarget) {
          const bookingCode = detailTarget.getAttribute('data-booking-detail');
          if (bookingCode) openDetailModal(bookingCode);
          return;
        }

        const emailStatusTarget = event.target.closest('[data-email-status]');
        if (emailStatusTarget) {
          const bookingCode = emailStatusTarget.getAttribute('data-email-status');
          if (bookingCode) openEmailModal(bookingCode);
          return;
        }

        const resendTarget = event.target.closest('[data-email-resend]');
        if (resendTarget) {
          const emailType = resendTarget.getAttribute('data-email-resend');
          if (emailType) resendFailedEmail(emailType, resendTarget);
          return;
        }

        const cancellationTargetButton = event.target.closest('[data-cancellation-preview]');
        if (!cancellationTargetButton) return;
        const bookingCode = cancellationTargetButton.getAttribute('data-cancellation-preview');
        if (bookingCode) openCancellationModal(bookingCode);
      });

      detailModalClose.addEventListener('click', closeDetailModal);
      detailModalCloseBottom.addEventListener('click', closeDetailModal);
      detailModal.addEventListener('click', (event) => {
        if (event.target === detailModal) closeDetailModal();
      });

      emailModalClose.addEventListener('click', closeEmailModal);
      emailModalCloseBottom.addEventListener('click', closeEmailModal);
      emailModal.addEventListener('click', (event) => {
        if (event.target === emailModal) closeEmailModal();
      });

      cancellationPreviewButton.addEventListener('click', loadCancellationPreview);
      cancellationReason.addEventListener('change', () => {
        cancellationPreviewPlaceholder.classList.remove('hidden');
        cancellationPreviewResult.classList.add('hidden');
        cancellationPreviewError.classList.add('hidden');
        cancellationPreviewData = null;
        cancellationExecutePanel.classList.add('hidden');
        cancellationFinalConfirm.checked = false;
        cancellationConfirmCode.value = '';
        syncCancellationExecuteButton();
        cancellationPreviewButton.textContent = '返金額を計算';
      });
      cancellationFinalConfirm.addEventListener('input', syncCancellationExecuteButton);
      cancellationFinalConfirm.addEventListener('change', syncCancellationExecuteButton);
      cancellationConfirmCode.addEventListener('input', syncCancellationExecuteButton);
      cancellationConfirmCode.addEventListener('change', syncCancellationExecuteButton);
      cancellationExecuteButton.addEventListener('click', executeCancellationRefund);
      cancellationModalClose.addEventListener('click', closeCancellationModal);
      cancellationCancelButton.addEventListener('click', closeCancellationModal);
      cancellationModal.addEventListener('click', (event) => {
        if (event.target === cancellationModal) closeCancellationModal();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;

        if (!detailModal.classList.contains('hidden')) {
          closeDetailModal();
          return;
        }

        if (!emailModal.classList.contains('hidden')) {
          closeEmailModal();
          return;
        }

        if (!cancellationModal.classList.contains('hidden')) {
          closeCancellationModal();
        }
      });

      const existingToken = sessionStorage.getItem(TOKEN_KEY);
      if (existingToken) {
        tokenInput.value = existingToken;
        loadBookings(existingToken);
      }
    })();
  </script>
</Layout>
