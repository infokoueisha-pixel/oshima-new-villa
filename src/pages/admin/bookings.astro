        const booking = bookings.find((item) => item.public_booking_code === bookingCode);
        if (!booking || !canPreviewCancellation(booking)) return;

        cancellationTarget = booking;
        cancellationReason.value = 'guest_request';
        cancellationBookingSummary.textContent = `${booking.public_booking_code} / ${booking.customer_name} / ${formatDate(booking.check_in_date)}〜${formatDate(booking.check_out_date)} / ${yen.format(Number(booking.total_jpy || 0))}`;
        cancellationPreviewPlaceholder.classList.remove('hidden');
        cancellationPreviewResult.classList.add('hidden');
