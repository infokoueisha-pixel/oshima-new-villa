---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="大島ニュービラ｜予約管理（開発環境）"
  description="大島ニュービラ自社予約システムの管理者向け予約一覧です。"
  noindex={true}
>
  <main class="min-h-screen bg-stone-50 pt-28 pb-20 md:pt-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-800">
            <span class="h-2 w-2 rounded-full bg-amber-500" aria-hidden="true"></span>
            開発環境
          </div>
          <p class="mt-5 text-xs font-bold tracking-[0.2em] text-green-700 uppercase">Booking Admin</p>
          <h1 class="mt-2 font-serif text-3xl font-bold text-gray-950 md:text-4xl">予約一覧</h1>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-gray-600">
            自社予約システムに入った予約を確認できます。管理者トークンはブラウザのこのタブを閉じるまでだけ保持します。
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center gap-2 md:justify-end">
          <button
            id="refresh-button"
            type="button"
            class="hidden h-10 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-lg border border-green-200 bg-green-50 px-4 py-2 text-sm font-bold leading-none text-green-800 transition hover:border-green-300 hover:bg-green-100 disabled:cursor-not-allowed disabled:opacity-60"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 4v5h5" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M4 13a8.1 8.1 0 0 0 15.5 2M20 20v-5h-5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span>更新</span>
          </button>
          <button
            id="logout-button"
            type="button"
            class="hidden h-10 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-bold leading-none text-gray-700 transition hover:border-red-300 hover:bg-red-50 hover:text-red-700"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 6h18" stroke-linecap="round"></path>
              <path d="M8 6V4h8v2" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M19 6l-1 14H6L5 6" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M10 11v5M14 11v5" stroke-linecap="round"></path>
            </svg>
            <span>トークンを破棄</span>
          </button>
        </div>
      </div>

      <section id="auth-panel" class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm md:p-8">
        <div class="max-w-2xl">
          <h2 class="font-serif text-2xl font-bold text-gray-950">管理者認証</h2>
          <p class="mt-2 text-sm leading-7 text-gray-600">
            Cloudflare の <strong>ADMIN_DASHBOARD_TOKEN</strong> に登録した値を入力してください。値はページのソースには保存されません。
          </p>
          <form id="auth-form" class="mt-6 flex flex-col gap-3 sm:flex-row">
            <label class="sr-only" for="admin-token">管理者トークン</label>
            <input
              id="admin-token"
              type="password"
              autocomplete="off"
              spellcheck="false"
              required
              placeholder="ADMIN_DASHBOARD_TOKEN"
              class="min-h-12 min-w-0 flex-1 rounded-xl border border-stone-300 bg-white px-4 py-3 text-base text-gray-900 outline-none transition focus:border-green-700 focus:ring-4 focus:ring-green-100"
            />
            <button
              id="auth-submit"
              type="submit"
              class="min-h-12 rounded-full bg-green-800 px-7 py-3 text-sm font-bold text-white shadow-md transition hover:bg-green-700 disabled:cursor-not-allowed disabled:opacity-60"
            >
              予約一覧を表示
            </button>
          </form>
          <p id="auth-message" class="mt-4 hidden rounded-xl px-4 py-3 text-sm leading-6" role="alert"></p>
        </div>
      </section>

      <section id="dashboard" class="hidden space-y-6">
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-bold tracking-wider text-gray-500">確定予約</p>
            <p id="summary-confirmed" class="mt-2 text-3xl font-bold text-gray-950">0</p>
          </article>
          <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-bold tracking-wider text-gray-500">支払待ち</p>
            <p id="summary-pending" class="mt-2 text-3xl font-bold text-amber-700">0</p>
          </article>
          <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-bold tracking-wider text-gray-500">期限切れ</p>
            <p id="summary-expired" class="mt-2 text-3xl font-bold text-gray-500">0</p>
          </article>
          <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-bold tracking-wider text-gray-500">確定売上（一覧内）</p>
            <p id="summary-sales" class="mt-2 text-3xl font-bold text-green-800">¥0</p>
          </article>
        </div>

        <section class="rounded-3xl border border-stone-200 bg-white p-5 shadow-sm md:p-6">
          <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
            <label class="block">
              <span class="mb-2 block text-xs font-bold tracking-wider text-gray-500">検索</span>
              <input
                id="search-input"
                type="search"
                placeholder="予約番号・氏名・メール・電話番号"
                class="min-h-11 w-full rounded-xl border border-stone-300 px-4 py-2.5 text-sm outline-none transition focus:border-green-700 focus:ring-4 focus:ring-green-100"
              />
            </label>
            <div class="flex flex-wrap gap-2" aria-label="予約ステータス絞り込み">
              <button data-filter="all" class="filter-button rounded-full bg-green-800 px-4 py-2.5 text-xs font-bold text-white">すべて</button>
              <button data-filter="confirmed" class="filter-button rounded-full border border-stone-300 bg-white px-4 py-2.5 text-xs font-bold text-gray-700">確定</button>
              <button data-filter="pending_payment" class="filter-button rounded-full border border-stone-300 bg-white px-4 py-2.5 text-xs font-bold text-gray-700">支払待ち</button>
              <button data-filter="expired" class="filter-button rounded-full border border-stone-300 bg-white px-4 py-2.5 text-xs font-bold text-gray-700">期限切れ</button>
              <button data-filter="cancelled" class="filter-button rounded-full border border-stone-300 bg-white px-4 py-2.5 text-xs font-bold text-gray-700">キャンセル</button>
            </div>
          </div>
          <p id="result-count" class="mt-4 text-xs text-gray-500"></p>
        </section>

        <section class="overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm">
          <div id="loading-state" class="hidden px-6 py-16 text-center text-sm text-gray-500">予約一覧を読み込んでいます…</div>
          <div id="empty-state" class="hidden px-6 py-16 text-center text-sm text-gray-500">条件に一致する予約はありません。</div>

          <div id="desktop-table-wrap" class="hidden overflow-x-auto lg:block">
            <table class="min-w-[1180px] w-full border-collapse text-left text-sm">
              <thead class="bg-stone-50 text-xs font-bold text-gray-600">
                <tr>
                  <th class="px-5 py-4">予約番号</th>
                  <th class="px-5 py-4">宿泊日</th>
                  <th class="px-5 py-4">予約者</th>
                  <th class="px-5 py-4">人数</th>
                  <th class="px-5 py-4">金額</th>
                  <th class="px-5 py-4">予約状態</th>
                  <th class="px-5 py-4">決済</th>
                  <th class="px-5 py-4">在庫</th>
                  <th class="px-5 py-4">作成日時</th>
                  <th class="px-5 py-4">操作</th>
                </tr>
              </thead>
              <tbody id="booking-table-body" class="divide-y divide-stone-100"></tbody>
            </table>
          </div>

          <div id="mobile-cards" class="divide-y divide-stone-100 lg:hidden"></div>
        </section>

        <p class="text-xs leading-6 text-gray-500">
          ※ 現在は開発用APIの最新100件を表示しています。本番公開時は管理画面の認証方式をCloudflare Access等へ切り替える予定です。
        </p>


        <div id="detail-modal" class="fixed inset-0 z-[120] hidden items-center justify-center bg-black/45 p-4" aria-hidden="true">
          <div class="flex max-h-[92vh] w-full max-w-4xl flex-col overflow-hidden rounded-3xl bg-white shadow-2xl" role="dialog" aria-modal="true" aria-labelledby="detail-modal-title">
            <div class="shrink-0 border-b border-stone-200 px-6 py-5 md:px-7">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.18em] text-green-700">Booking Detail</p>
                  <h2 id="detail-modal-title" class="mt-1 font-serif text-2xl font-bold text-gray-950">予約詳細</h2>
                  <p id="detail-booking-summary" class="mt-2 text-sm leading-6 text-gray-600"></p>
                </div>
                <button id="detail-modal-close" type="button" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-stone-200 text-xl text-gray-500 transition hover:bg-stone-50" aria-label="閉じる">×</button>
              </div>
            </div>

            <div class="min-h-0 flex-1 overflow-y-auto px-6 py-6 md:px-7">
              <div id="detail-loading" class="rounded-2xl bg-stone-50 px-5 py-10 text-center text-sm text-gray-500">
                予約詳細を読み込んでいます…
              </div>

              <p id="detail-error" class="hidden rounded-xl bg-red-50 px-4 py-3 text-sm leading-6 text-red-700" role="alert"></p>

              <div id="detail-content" class="hidden space-y-6"></div>
            </div>

            <div class="shrink-0 border-t border-stone-200 bg-white px-6 py-4 md:px-7">
              <div class="flex justify-end">
                <button id="detail-modal-close-bottom" type="button" class="min-h-11 rounded-xl border border-stone-300 bg-white px-5 py-2.5 text-sm font-bold text-gray-700 hover:bg-stone-50">閉じる</button>
              </div>
            </div>
          </div>
        </div>

        <div id="email-modal" class="fixed inset-0 z-[110] hidden items-center justify-center bg-black/45 p-4" aria-hidden="true">
          <div class="w-full max-w-2xl overflow-hidden rounded-3xl bg-white shadow-2xl" role="dialog" aria-modal="true" aria-labelledby="email-modal-title">
            <div class="border-b border-stone-200 px-6 py-5 md:px-7">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.18em] text-green-700">Email Delivery</p>
                  <h2 id="email-modal-title" class="mt-1 font-serif text-2xl font-bold text-gray-950">メール送信状況</h2>
                  <p id="email-booking-summary" class="mt-2 text-sm leading-6 text-gray-600"></p>
                </div>
                <button id="email-modal-close" type="button" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-stone-200 text-xl text-gray-500 transition hover:bg-stone-50" aria-label="閉じる">×</button>
              </div>
            </div>

            <div class="space-y-5 px-6 py-6 md:px-7">
              <div id="email-status-loading" class="rounded-2xl bg-stone-50 px-5 py-8 text-center text-sm text-gray-500">
                メール送信状況を確認しています…
              </div>

              <p id="email-status-message" class="hidden rounded-xl px-4 py-3 text-sm leading-6" role="status"></p>

              <div id="email-status-list" class="hidden space-y-3"></div>

              <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs leading-6 text-amber-900">
                二重送信防止のため、「再送する」は送信状態が <strong>failed</strong> のメールだけに表示します。送信済み・送信中のメールは再送できません。
              </div>

              <div class="flex justify-end">
                <button id="email-modal-close-bottom" type="button" class="min-h-11 rounded-xl border border-stone-300 bg-white px-5 py-2.5 text-sm font-bold text-gray-700 hover:bg-stone-50">閉じる</button>
              </div>
            </div>
          </div>
        </div>

        <div id="cancellation-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/45 p-4" aria-hidden="true">
          <div class="w-full max-w-xl overflow-hidden rounded-3xl bg-white shadow-2xl" role="dialog" aria-modal="true" aria-labelledby="cancellation-modal-title">
            <div class="border-b border-stone-200 px-6 py-5 md:px-7">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.18em] text-green-700">Cancellation Preview</p>
                  <h2 id="cancellation-modal-title" class="mt-1 font-serif text-2xl font-bold text-gray-950">キャンセル・返金額を確認</h2>
                  <p id="cancellation-booking-summary" class="mt-2 text-sm leading-6 text-gray-600"></p>
                </div>
                <button id="cancellation-modal-close" type="button" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-stone-200 text-xl text-gray-500 transition hover:bg-stone-50" aria-label="閉じる">×</button>
              </div>
            </div>

            <div class="space-y-5 px-6 py-6 md:px-7">
              <label class="block">
                <span class="mb-2 block text-sm font-bold text-gray-800">キャンセル理由</span>
                <select id="cancellation-reason" class="min-h-12 w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition focus:border-green-700 focus:ring-4 focus:ring-green-100">
                  <option value="guest_request">お客様都合</option>
                  <option value="transport_cancellation">船・航空便の正式欠航</option>
                  <option value="facility_reason">施設都合</option>
                  <option value="other">その他</option>
                </select>
              </label>

              <div class="rounded-2xl border border-stone-200 bg-stone-50 p-5">
                <div id="cancellation-preview-placeholder" class="text-sm leading-6 text-gray-600">理由を選び、「返金額を計算」を押してください。まだ返金は実行されません。</div>
                <div id="cancellation-preview-result" class="hidden">
                  <div class="grid grid-cols-2 gap-x-5 gap-y-4 text-sm">
                    <div>
                      <p class="text-xs font-bold text-gray-500">チェックインまで</p>
                      <p id="preview-days" class="mt-1 font-bold text-gray-950"></p>
                    </div>
                    <div>
                      <p class="text-xs font-bold text-gray-500">キャンセル料率</p>
                      <p id="preview-rate" class="mt-1 font-bold text-gray-950"></p>
                    </div>
                    <div>
                      <p class="text-xs font-bold text-gray-500">キャンセル料</p>
                      <p id="preview-fee" class="mt-1 font-bold text-gray-950"></p>
                    </div>
                    <div>
                      <p class="text-xs font-bold text-gray-500">返金予定額</p>
                      <p id="preview-refund" class="mt-1 text-xl font-bold text-green-800"></p>
                    </div>
                  </div>
                  <p id="preview-policy-note" class="mt-4 rounded-xl bg-white px-4 py-3 text-xs leading-6 text-gray-600"></p>
                </div>
              </div>

              <p id="cancellation-preview-error" class="hidden rounded-xl bg-red-50 px-4 py-3 text-sm leading-6 text-red-700" role="alert"></p>

              <label class="block">
                <span class="mb-2 block text-sm font-bold text-gray-800">管理者メモ <span class="font-normal text-gray-400">（任意）</span></span>
                <textarea id="cancellation-admin-note" rows="3" maxlength="500" placeholder="例：9/14 お客様より電話でキャンセル依頼" class="w-full resize-y rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition focus:border-green-700 focus:ring-4 focus:ring-green-100"></textarea>
              </label>

              <div id="cancellation-execute-panel" class="hidden rounded-2xl border border-red-200 bg-red-50 p-5">
                <p class="text-sm font-bold text-red-800">この操作は取り消せません</p>
                <p id="cancellation-execute-summary" class="mt-2 text-sm leading-6 text-red-700"></p>
                <label class="mt-4 flex cursor-pointer items-start gap-3 rounded-xl bg-white px-4 py-3 text-sm text-gray-800">
                  <input id="cancellation-final-confirm" type="checkbox" class="mt-0.5 h-4 w-4 rounded border-stone-300 text-red-700 focus:ring-red-200" />
                  <span>予約番号・返金額・キャンセル理由を確認しました。</span>
                </label>

                <label class="mt-3 block rounded-xl bg-white px-4 py-3">
                  <span class="block text-xs font-bold text-red-800">最終確認：予約番号を入力してください</span>
                  <span id="cancellation-confirm-code-guide" class="mt-1 block text-xs leading-5 text-gray-500"></span>
                  <input
                    id="cancellation-confirm-code"
                    type="text"
                    autocomplete="off"
                    spellcheck="false"
                    placeholder="ONV-XXXXXXXXXX"
                    class="mt-3 min-h-11 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm font-bold tracking-wide text-gray-900 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100"
                  />
                </label>

                <button id="cancellation-execute-button" type="button" disabled aria-disabled="true" class="mt-4 min-h-12 w-full rounded-xl border border-stone-300 bg-stone-200 px-5 py-3 text-sm font-bold text-stone-500 shadow-sm transition">返金して予約をキャンセル</button>
              </div>

              <div id="cancellation-success" class="hidden rounded-2xl border border-green-200 bg-green-50 p-5" role="status">
                <p class="text-sm font-bold text-green-900">返金・キャンセルが完了しました</p>
                <p id="cancellation-success-detail" class="mt-2 text-sm leading-6 text-green-800"></p>
              </div>

              <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                <button id="cancellation-cancel-button" type="button" class="min-h-11 rounded-xl border border-stone-300 bg-white px-5 py-2.5 text-sm font-bold text-gray-700 hover:bg-stone-50">閉じる</button>
                <button id="cancellation-preview-button" type="button" class="min-h-11 rounded-xl bg-green-800 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-green-700 disabled:cursor-not-allowed disabled:opacity-60">返金額を計算</button>
              </div>

              <div id="cancellation-safety-note" class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs leading-6 text-amber-900">
                「返金額を計算」だけでは返金されません。金額確認後、赤い確認欄で明示的に実行した場合のみStripe返金・予約キャンセル・在庫解放を行います。
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script is:inline>
    (() => {
      const API_URL = 'https://oshima-new-villa-booking-api-dev.info-koueisha.workers.dev/api/admin/bookings';
      const CANCELLATION_PREVIEW_URL = 'https://oshima-new-villa-booking-api-dev.info-koueisha.workers.dev/api/admin/cancellation-preview';
      const CANCEL_REFUND_URL = 'https://oshima-new-villa-booking-api-dev.info-koueisha.workers.dev/api/admin/cancel-refund';
      const EMAIL_STATUS_URL = 'https://oshima-new-villa-booking-api-dev.info-koueisha.workers.dev/api/admin/email-status';
      const EMAIL_RESEND_URL = 'https://oshima-new-villa-booking-api-dev.info-koueisha.workers.dev/api/admin/email-resend';
      const BOOKING_DETAIL_URL = 'https://oshima-new-villa-booking-api-dev.info-koueisha.workers.dev/api/admin/booking-detail';
      const TOKEN_KEY = 'onv_admin_dashboard_token';

      const authPanel = document.getElementById('auth-panel');
      const authForm = document.getElementById('auth-form');
      const tokenInput = document.getElementById('admin-token');
      const authSubmit = document.getElementById('auth-submit');
      const authMessage = document.getElementById('auth-message');
      const dashboard = document.getElementById('dashboard');
      const refreshButton = document.getElementById('refresh-button');
      const logoutButton = document.getElementById('logout-button');
      const loadingState = document.getElementById('loading-state');
      const emptyState = document.getElementById('empty-state');
      const tableBody = document.getElementById('booking-table-body');
      const mobileCards = document.getElementById('mobile-cards');
      const searchInput = document.getElementById('search-input');
      const resultCount = document.getElementById('result-count');
      const filterButtons = Array.from(document.querySelectorAll('.filter-button'));
      const cancellationModal = document.getElementById('cancellation-modal');
      const cancellationModalClose = document.getElementById('cancellation-modal-close');
      const cancellationCancelButton = document.getElementById('cancellation-cancel-button');
      const cancellationPreviewButton = document.getElementById('cancellation-preview-button');
      const cancellationReason = document.getElementById('cancellation-reason');
      const cancellationBookingSummary = document.getElementById('cancellation-booking-summary');
      const cancellationPreviewPlaceholder = document.getElementById('cancellation-preview-placeholder');
      const cancellationPreviewResult = document.getElementById('cancellation-preview-result');
      const cancellationPreviewError = document.getElementById('cancellation-preview-error');
      const previewDays = document.getElementById('preview-days');
      const previewRate = document.getElementById('preview-rate');
      const previewFee = document.getElementById('preview-fee');
      const previewRefund = document.getElementById('preview-refund');
      const previewPolicyNote = document.getElementById('preview-policy-note');
      const cancellationAdminNote = document.getElementById('cancellation-admin-note');
      const cancellationExecutePanel = document.getElementById('cancellation-execute-panel');
      const cancellationExecuteSummary = document.getElementById('cancellation-execute-summary');
      const cancellationFinalConfirm = document.getElementById('cancellation-final-confirm');
      const cancellationConfirmCodeGuide = document.getElementById('cancellation-confirm-code-guide');
      const cancellationConfirmCode = document.getElementById('cancellation-confirm-code');
      const cancellationExecuteButton = document.getElementById('cancellation-execute-button');
      const cancellationSuccess = document.getElementById('cancellation-success');
      const cancellationSuccessDetail = document.getElementById('cancellation-success-detail');
      const cancellationSafetyNote = document.getElementById('cancellation-safety-note');
      const emailModal = document.getElementById('email-modal');
      const emailModalClose = document.getElementById('email-modal-close');
      const emailModalCloseBottom = document.getElementById('email-modal-close-bottom');
      const emailBookingSummary = document.getElementById('email-booking-summary');
