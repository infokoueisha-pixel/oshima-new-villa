      async function openDetailModal(bookingCode) {
        const booking = bookings.find((item) => item.public_booking_code === bookingCode);
        if (!booking) return;

        const token = sessionStorage.getItem(TOKEN_KEY);
        if (!token) {
          setAuthMessage('管理者トークンを再入力してください。');
          authPanel.classList.remove('hidden');
          dashboard.classList.add('hidden');
          return;
        }

        detailBookingSummary.textContent = `${booking.public_booking_code} / ${booking.customer_name} / ${formatDate(booking.check_in_date)}〜${formatDate(booking.check_out_date)}`;
        detailLoading.classList.remove('hidden');
        detailError.classList.add('hidden');
        detailError.textContent = '';
        detailContent.classList.add('hidden');
        detailContent.innerHTML = '';
        detailModal.classList.remove('hidden');
        detailModal.classList.add('flex');
        detailModal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('overflow-hidden');

        try {
          const response = await fetch(
            `${BOOKING_DETAIL_URL}?booking_code=${encodeURIComponent(booking.public_booking_code)}`,
            {
              method: 'GET',
              headers: {
                Authorization: `Bearer ${token}`,
              },
            }
          );

          const data = await response.json().catch(() => null);

          if (response.status === 401) {
            sessionStorage.removeItem(TOKEN_KEY);
            closeDetailModal();
            setAuthMessage('管理者トークンが一致しません。再入力してください。');
            authPanel.classList.remove('hidden');
            dashboard.classList.add('hidden');
            return;
          }

          if (!response.ok || !data?.ok || !data.booking) {
            throw new Error('予約詳細を取得できませんでした。');
          }

          renderBookingDetail(data);
          detailLoading.classList.add('hidden');
          detailContent.classList.remove('hidden');
        } catch (error) {
          detailLoading.classList.add('hidden');
          detailError.textContent = error instanceof Error ? error.message : '予約詳細を取得できませんでした。';
          detailError.classList.remove('hidden');
        }
      }

      function canPreviewCancellation(booking) {
        return booking?.status === 'confirmed' && booking?.payment_status === 'paid';
      }

      const emailTypeMeta = {
        booking_confirmation: {
          label: '予約確定メール',
          audience: 'お客様向け',
        },
        cancellation_completion: {
          label: 'キャンセル・返金完了メール',
          audience: 'お客様向け',
        },
        admin_cancellation_notification: {
          label: 'キャンセル通知メール',
          audience: '管理者向け',
        },
      };

      function emailStatusLabel(status, applicable) {
        if (!applicable) return '対象外';
        if (status === 'sent') return '送信済み';
        if (status === 'failed') return '送信失敗';
        if (status === 'pending') return '送信中';
        return '履歴なし';
      }

      function emailStatusClass(status, applicable) {
        if (!applicable) return 'border-stone-200 bg-stone-100 text-stone-500';
        if (status === 'sent') return 'border-green-200 bg-green-50 text-green-800';
        if (status === 'failed') return 'border-red-200 bg-red-50 text-red-700';
        if (status === 'pending') return 'border-amber-200 bg-amber-50 text-amber-800';
        return 'border-stone-200 bg-white text-stone-600';
      }

      function closeEmailModal() {
        emailTarget = null;
        emailModal.classList.add('hidden');
        emailModal.classList.remove('flex');
        emailModal.setAttribute('aria-hidden', 'true');

        if (cancellationModal.classList.contains('hidden')) {
          document.body.classList.remove('overflow-hidden');
        }
      }

      function setEmailStatusMessage(message, type = 'success') {
        emailStatusMessage.textContent = message;
        emailStatusMessage.className = `rounded-xl px-4 py-3 text-sm leading-6 ${
          type === 'error'
            ? 'bg-red-50 text-red-700'
            : 'bg-green-50 text-green-800'
        }`;
        emailStatusMessage.classList.remove('hidden');
      }

      function renderEmailStatuses(data) {
        const emails = data?.emails || {};

        emailStatusList.innerHTML = Object.entries(emailTypeMeta)
          .map(([type, meta]) => {
            const item = emails[type] || {};
            const applicable = Boolean(item.applicable);
            const status = item.status || null;
            const canRetry = status === 'failed';
            const recipient = item.recipient_email
              ? escapeHtml(item.recipient_email)
              : '—';
            const sentAt = item.sent_at
              ? escapeHtml(formatDateTime(item.sent_at))
              : '—';
            const errorHtml = item.last_error
              ? `<p class="mt-3 break-words rounded-lg bg-red-50 px-3 py-2 text-xs leading-5 text-red-700"><strong>エラー:</strong> ${escapeHtml(item.last_error)}</p>`
              : '';

            return `
              <article class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="text-sm font-bold text-gray-950">${escapeHtml(meta.label)}</h3>
                      <span class="text-xs text-gray-500">${escapeHtml(meta.audience)}</span>
                    </div>
                    <p class="mt-2 text-xs leading-5 text-gray-500">送信先: ${recipient}</p>
                    <p class="mt-1 text-xs leading-5 text-gray-500">送信日時: ${sentAt}</p>
                  </div>
                  <span class="inline-flex w-fit rounded-full border px-2.5 py-1 text-xs font-bold ${emailStatusClass(status, applicable)}">
                    ${escapeHtml(emailStatusLabel(status, applicable))}
                  </span>
                </div>
                ${errorHtml}
                ${canRetry ? `
                  <div class="mt-4 border-t border-stone-100 pt-4">
                    <button
                      type="button"
                      data-email-resend="${escapeHtml(type)}"
                      class="rounded-lg border border-red-200 bg-white px-4 py-2.5 text-xs font-bold text-red-700 transition hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      再送する
                    </button>
                  </div>
                ` : ''}
              </article>
            `;
          })
          .join('');

        emailStatusLoading.classList.add('hidden');
        emailStatusList.classList.remove('hidden');
      }

      async function loadEmailStatuses() {
        if (!emailTarget) return;

        const token = sessionStorage.getItem(TOKEN_KEY);

        if (!token) {
          closeEmailModal();
          setAuthMessage('管理者トークンを再入力してください。');
          authPanel.classList.remove('hidden');
          dashboard.classList.add('hidden');
          return;
        }

        emailStatusLoading.classList.remove('hidden');
        emailStatusList.classList.add('hidden');
        emailStatusMessage.classList.add('hidden');

        try {
          const response = await fetch(
            `${EMAIL_STATUS_URL}?booking_code=${encodeURIComponent(emailTarget.public_booking_code)}`,
            {
              method: 'GET',
              headers: {
                Authorization: `Bearer ${token}`,
              },
            }
          );

          const data = await response.json().catch(() => null);

          if (response.status === 401) {
            sessionStorage.removeItem(TOKEN_KEY);
            throw new Error('管理者トークンが一致しません。');
          }

          if (!response.ok || !data?.ok || !data.emails) {
            throw new Error('メール送信状況を取得できませんでした。');
          }

          renderEmailStatuses(data);
        } catch (error) {
          emailStatusLoading.classList.add('hidden');
          emailStatusList.classList.add('hidden');
          setEmailStatusMessage(
            error instanceof Error ? error.message : 'メール送信状況を取得できませんでした。',
            'error'
          );
        }
      }

      function openEmailModal(bookingCode) {
        const booking = bookings.find((item) => item.public_booking_code === bookingCode);
        if (!booking) return;

        emailTarget = booking;
        emailBookingSummary.textContent = `${booking.public_booking_code} / ${booking.customer_name} / ${formatDate(booking.check_in_date)}〜${formatDate(booking.check_out_date)}`;
        emailStatusMessage.classList.add('hidden');
        emailStatusList.innerHTML = '';
        emailStatusList.classList.add('hidden');
        emailStatusLoading.classList.remove('hidden');

        emailModal.classList.remove('hidden');
        emailModal.classList.add('flex');
        emailModal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('overflow-hidden');

        loadEmailStatuses();
      }

      async function resendFailedEmail(emailType, button) {
        if (!emailTarget || !emailTypeMeta[emailType]) return;

        const token = sessionStorage.getItem(TOKEN_KEY);

        if (!token) {
          closeEmailModal();
          setAuthMessage('管理者トークンを再入力してください。');
          authPanel.classList.remove('hidden');
          dashboard.classList.add('hidden');
          return;
        }

        const meta = emailTypeMeta[emailType];

        if (!window.confirm(
          `${meta.label}（${meta.audience}）を再送しますか？\n\n送信失敗の履歴に対する再送です。`
        )) {
          return;
        }

        const originalText = button.textContent;
        button.disabled = true;
        button.textContent = '再送中…';
        emailStatusMessage.classList.add('hidden');

        try {
          const response = await fetch(EMAIL_RESEND_URL, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({
              booking_code: emailTarget.public_booking_code,
              email_type: emailType,
            }),
          });

          const data = await response.json().catch(() => null);

          if (response.status === 401) {
            sessionStorage.removeItem(TOKEN_KEY);
            throw new Error('管理者トークンが一致しません。');
          }

          if (!response.ok || !data?.ok) {
            if (data?.error === 'email_not_failed') {
              throw new Error('このメールは現在「送信失敗」状態ではないため再送できません。');
            }
            if (data?.error === 'email_retry_in_progress') {
              throw new Error('このメールはすでに再送処理中です。');
            }
            if (data?.error === 'email_delivery_not_found') {
              throw new Error('このメールの送信履歴が見つかりません。');
            }
            throw new Error('メールを再送できませんでした。');
          }

          await loadEmailStatuses();
          setEmailStatusMessage(`${meta.label}を再送しました。`);
        } catch (error) {
          setEmailStatusMessage(
            error instanceof Error ? error.message : 'メールを再送できませんでした。',
            'error'
          );
          button.disabled = false;
          button.textContent = originalText;
        }
      }

      function closeCancellationModal() {
        cancellationTarget = null;
        cancellationPreviewData = null;
        cancellationModal.classList.add('hidden');
        cancellationModal.classList.remove('flex');
        cancellationModal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('overflow-hidden');
      }

