      function syncCancellationExecuteButton() {
        const expectedCode = cancellationTarget?.public_booking_code || '';
        const enteredCode = cancellationConfirmCode.value.trim();
        const canExecute = Boolean(
          cancellationFinalConfirm.checked &&
          cancellationPreviewData?.cancellation &&
          !cancellationExecutePanel.classList.contains('hidden') &&
          expectedCode &&
          enteredCode === expectedCode
        );

        cancellationExecuteButton.disabled = !canExecute;
        cancellationExecuteButton.setAttribute('aria-disabled', String(!canExecute));

        // 金銭操作なので、有効・無効を色でも明確に区別する。
        if (canExecute) {
          cancellationExecuteButton.style.backgroundColor = '#b91c1c';
          cancellationExecuteButton.style.borderColor = '#991b1b';
          cancellationExecuteButton.style.color = '#ffffff';
          cancellationExecuteButton.style.cursor = 'pointer';
          cancellationExecuteButton.style.opacity = '1';
        } else {
          cancellationExecuteButton.style.backgroundColor = '#e7e5e4';
          cancellationExecuteButton.style.borderColor = '#d6d3d1';
          cancellationExecuteButton.style.color = '#78716c';
          cancellationExecuteButton.style.cursor = 'not-allowed';
          cancellationExecuteButton.style.opacity = '1';
        }
      }

      const yen = new Intl.NumberFormat('ja-JP', {
        style: 'currency',
        currency: 'JPY',
        maximumFractionDigits: 0,
      });

      const dateFormatter = new Intl.DateTimeFormat('ja-JP', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      });

      function escapeHtml(value) {
        return String(value ?? '')
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;')
          .replaceAll("'", '&#039;');
      }

      function formatDate(value) {
        if (!value) return '—';
        const date = new Date(`${value}T00:00:00`);
        return Number.isNaN(date.getTime()) ? value : dateFormatter.format(date);
      }

      function formatDateTime(value) {
        if (!value) return '—';
        return String(value).replace('T', ' ').slice(0, 16);
      }

      function statusLabel(status) {
        const labels = {
          confirmed: '確定',
          pending_payment: '支払待ち',
          expired: '期限切れ',
          cancelled: 'キャンセル',
        };
        return labels[status] || status || '—';
      }

      function statusClass(status) {
        if (status === 'confirmed') return 'bg-green-50 text-green-800 border-green-200';
        if (status === 'pending_payment') return 'bg-amber-50 text-amber-800 border-amber-200';
        if (status === 'expired') return 'bg-stone-100 text-stone-600 border-stone-200';
        if (status === 'cancelled') return 'bg-red-50 text-red-700 border-red-200';
        return 'bg-stone-50 text-stone-700 border-stone-200';
      }

      function paymentLabel(status) {
        const labels = {
          paid: '支払済み',
          unpaid: '未払い',
          refunded: '返金済み',
          partially_refunded: '一部返金',
        };
        return labels[status] || status || '—';
      }

      function inventoryLabel(type) {
        if (type === 'booking') return '本予約';
        if (type === 'hold') return '仮押さえ';
        return '—';
      }

      function reasonLabel(reason) {
        const labels = {
          guest_request: 'お客様都合',
          transport_cancellation: '船・航空便の正式欠航',
          facility_reason: '施設都合',
