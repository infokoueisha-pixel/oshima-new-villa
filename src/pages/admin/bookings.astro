      function setAuthMessage(message, type = 'error') {
        authMessage.textContent = message;
        authMessage.className = `mt-4 rounded-xl px-4 py-3 text-sm leading-6 ${
          type === 'error'
            ? 'bg-red-50 text-red-700'
            : 'bg-green-50 text-green-800'
        }`;
        authMessage.classList.remove('hidden');
      }

      function updateSummary() {
        const confirmed = bookings.filter((b) => b.status === 'confirmed');
        const pending = bookings.filter((b) => b.status === 'pending_payment');
        const expired = bookings.filter((b) => b.status === 'expired');
        const sales = confirmed
          .filter((b) => b.payment_status === 'paid')
          .reduce((sum, b) => sum + Number(b.total_jpy || 0), 0);

        document.getElementById('summary-confirmed').textContent = String(confirmed.length);
        document.getElementById('summary-pending').textContent = String(pending.length);
        document.getElementById('summary-expired').textContent = String(expired.length);
        document.getElementById('summary-sales').textContent = yen.format(sales);
      }

      function filteredBookings() {
        const query = searchInput.value.trim().toLowerCase();
        return bookings.filter((booking) => {
          if (activeFilter !== 'all' && booking.status !== activeFilter) return false;
          if (!query) return true;
          const haystack = [
            booking.public_booking_code,
            booking.customer_name,
            booking.customer_email,
            booking.customer_phone,
            booking.check_in_date,
            booking.check_out_date,
          ]
            .filter(Boolean)
            .join(' ')
            .toLowerCase();
          return haystack.includes(query);
        });
      }

