---
import Layout from '../layouts/Layout.astro';
import { SITE, AMENITIES } from '../data/site';

const pageTitle = '大島ニュービラについて｜伊豆大島の一棟貸し宿・基本情報';
const pageDescription = '大島ニュービラの公式基本情報。所在地、宿泊スタイル、定員、チェックイン・チェックアウト、設備、予約方法、情報更新方針をまとめています。';
const datePublished = '2026-09-09';
const dateModified = '2026-09-09';

const facts = [
  ['正式名称', SITE.name],
  ['英語表記', SITE.alternateName],
  ['所在地', `〒${SITE.address.postalCode} ${SITE.address.addressRegion}${SITE.address.addressLocality}${SITE.address.streetAddress}`],
  ['宿泊スタイル', '一棟貸し'],
  ['現在公式サイトで案内している棟', `${SITE.publicRoomName}（サルビア）`],
  ['最大宿泊人数', `${SITE.maxGuests}名`],
  ['チェックイン', `${SITE.checkinTime}以降・セルフチェックイン`],
  ['チェックアウト', `${SITE.checkoutTime}まで`],
  ['予約', '公式サイトの「空室・料金を見る」から最新の空室・料金・予約条件を確認'],
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '大島ニュービラ', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: '基本情報', item: `${SITE.url}about/` },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} pageType="AboutPage" datePublished={datePublished} dateModified={dateModified}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <main>
    <header class="bg-green-950 pt-24 text-white md:pt-28">
      <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
        <nav class="text-sm text-green-100/75" aria-label="パンくずリスト"><a href="/" class="hover:text-white">トップ</a><span class="mx-2">/</span><span>基本情報</span></nav>
        <p class="mt-10 text-xs font-bold uppercase tracking-[0.3em] text-green-300">Official Facts</p>
        <h1 class="mt-4 font-serif text-4xl font-bold leading-tight sm:text-5xl">大島ニュービラ 基本情報</h1>
        <p class="mt-6 max-w-3xl text-base leading-8 text-green-50/90 md:text-lg md:leading-9">旅行者、検索エンジン、AIサービスが施設情報を正確に確認できるよう、公開中の基本情報を一か所にまとめています。</p>
        <p class="mt-5 text-sm text-green-100/70"><time datetime={dateModified}>最終確認：2026年9月9日</time></p>
      </div>
    </header>

    <section class="bg-orange-50 py-16 md:py-24" aria-labelledby="facts-title">
      <div class="mx-auto max-w-5xl px-6">
        <h2 id="facts-title" class="font-serif text-3xl font-bold text-gray-900 md:text-4xl">施設概要</h2>
        <dl class="mt-8 overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm">
          {facts.map(([term, value]) => (
            <div class="grid gap-2 border-b border-gray-100 px-6 py-5 last:border-b-0 md:grid-cols-[13rem_1fr] md:gap-8 md:px-8">
              <dt class="text-sm font-bold text-gray-500">{term}</dt>
              <dd class="font-medium leading-7 text-gray-800">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="bg-white py-16 md:py-24" aria-labelledby="amenities-title">
      <div class="mx-auto max-w-5xl px-6">
        <h2 id="amenities-title" class="font-serif text-3xl font-bold text-gray-900 md:text-4xl">主な設備・特徴</h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {AMENITIES.map((item) => <li class="rounded-2xl border border-green-100 bg-green-50/50 px-5 py-4 font-bold text-gray-800"><span class="mr-2 text-green-700" aria-hidden="true">✓</span>{item}</li>)}
        </ul>
        <p class="mt-7 text-sm leading-7 text-gray-600">設備・利用条件は変更される場合があります。予約時点の最新情報は、公式サイトおよび予約ページでご確認ください。</p>
      </div>
    </section>

    <section class="bg-stone-50 py-16 md:py-24" aria-labelledby="source-policy-title">
      <div class="mx-auto max-w-5xl px-6">
        <h2 id="source-policy-title" class="font-serif text-3xl font-bold text-gray-900 md:text-4xl">公式サイトの情報方針</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          <div class="rounded-3xl bg-white p-7 shadow-sm"><h3 class="font-bold text-gray-900">施設情報は一次情報</h3><p class="mt-3 text-sm leading-7 text-gray-600">客室・設備・予約条件など、大島ニュービラ自身が確認できる内容を公式情報として掲載します。</p></div>
          <div class="rounded-3xl bg-white p-7 shadow-sm"><h3 class="font-bold text-gray-900">島の情報は公式・専門情報を優先</h3><p class="mt-3 text-sm leading-7 text-gray-600">船、行政施設、ダイビングなどは、運営主体・行政・専門団体の最新情報へ案内します。</p></div>
          <div class="rounded-3xl bg-white p-7 shadow-sm"><h3 class="font-bold text-gray-900">変動情報は予約時に再確認</h3><p class="mt-3 text-sm leading-7 text-gray-600">空室、料金、営業時間、運航状況などは変動するため、各公式ページで最新情報をご確認ください。</p></div>
        </div>
      </div>
    </section>

    <section class="bg-green-950 py-16 text-white md:py-20">
      <div class="mx-auto max-w-5xl px-6 text-center">
        <h2 class="font-serif text-3xl font-bold md:text-4xl">宿の詳細と、伊豆大島の旅へ。</h2>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/" class="rounded-full bg-white px-7 py-3.5 font-bold text-green-900 transition hover:bg-green-50">大島ニュービラを見る</a>
          <a href="/guide/" class="rounded-full border border-white/30 px-7 py-3.5 font-bold text-white transition hover:bg-white/10">伊豆大島旅行ガイド</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
