---
import InternationalLayout from '../../layouts/InternationalLayout.astro';
const pageTitle = '住宿指南｜选择预订类型｜Oshima New Villa';
const pageDescription = 'Oshima New Villa 住宿客人指南。请选择 SALVIA、FREESIA 或两栋同时预订。';
---

<InternationalLayout locale="zh-Hans" title={pageTitle} description={pageDescription} noindex={true}>
  <main class="min-h-screen bg-orange-50 pt-24 md:pt-28">
    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">住宿指南</p>
          <h1 class="mt-4 font-serif text-4xl font-bold text-gray-900 md:text-5xl">请选择您的预订类型</h1>
          <p class="mx-auto mt-6 max-w-2xl text-sm leading-8 text-gray-600 md:text-base">请根据预订确认内容选择住宿类型，即可查看对应的可使用设施和 BBQ 场所。</p>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
        <a href="/zh-cn/guest-guide/salvia/" class="group rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-lg">
          <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">最多 6 人</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-gray-900">SALVIA</h2>
          <p class="mt-3 text-sm leading-7 text-gray-600">BBQ 使用 Gazebo An 凉亭</p>
          <span class="mt-6 inline-flex text-sm font-bold text-green-800">打开指南 <span class="ml-1 transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        <a href="/zh-cn/guest-guide/freesia/" class="group rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-lg">
          <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">最多 3 人</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-gray-900">FREESIA</h2>
          <p class="mt-3 text-sm leading-7 text-gray-600">BBQ 使用专用木质露台</p>
          <span class="mt-6 inline-flex text-sm font-bold text-green-800">打开指南 <span class="ml-1 transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        <a href="/zh-cn/guest-guide/salvia-freesia/" class="group rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-lg">
          <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">两栋最多 9 人</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-gray-900">SALVIA + FREESIA</h2>
          <p class="mt-3 text-sm leading-7 text-gray-600">可使用 Gazebo An 凉亭</p>
          <span class="mt-6 inline-flex text-sm font-bold text-green-800">打开指南 <span class="ml-1 transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        </div>
        <p class="mx-auto mt-8 max-w-2xl text-center text-xs leading-6 text-gray-500">住宿前的通知通常会直接提供对应指南的链接。</p>
      </div>
    </section>
  </main>
</InternationalLayout>
