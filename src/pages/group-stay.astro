---
import Layout from '../layouts/Layout.astro';

const pageTitle = '伊豆大島の一棟貸し｜4〜9名のグループ旅行・2棟利用｜大島ニュービラ';
const pageDescription = '伊豆大島で4〜9名のグループ旅行なら大島ニュービラ。SALVIA（最大6名）とFREESIA（最大3名）の2棟を組み合わせ、家族・友人・2家族旅行にも対応。';

const useCases: Array<{ icon: string; kicker: string; title: string; description: string; href?: string }> = [
  {
    icon: '💬',
    kicker: 'Offsite',
    title: 'オフサイト',
    description: '少人数のチームで集まり、話す・考える・食べる時間を一つの場所で。会議室とは違う環境で過ごせます。',
  },
  {
    icon: '💻',
    kicker: 'Workation',
    title: 'ワーケーション',
    description: '無料Wi-Fiを備え、リビングやダイニングでPC作業ができます。通信品質・常時接続を保証するものではないため、重要なオンライン会議等がある場合は予備回線のご用意をおすすめします。',
  },
  {
    icon: '🧑‍💻',
    kicker: 'Team Camp',
    title: '開発・チーム合宿',
    description: 'SALVIAとFREESIAの2棟利用で最大9名。仕事や観光のあとも、料理やBBQを囲みながらチームだけで過ごせます。',
  },
  {
    icon: '🤿',
    kicker: 'Diving',
    title: 'ダイビング旅行',
    description: '伊豆大島で海を楽しむグループの宿泊拠点としても歓迎しています。潜ったあとの時間まで仲間と楽しみたい方へ。',
    href: '/diving/',
  },
  {
    icon: '🎣',
    kicker: 'Fishing',
    title: '釣り旅行',
    description: '釣りを楽しんだあとは、屋外炊事場「ガゼボ庵」で釣った魚を調理して食事を楽しめます。',
  },
  {
    icon: '📷',
    kicker: 'Photography',
    title: '写真・星空撮影',
    description: '朝夕の景色や星空を目的に動きたい方にも。一棟貸しだから、自分たちのスケジュールで過ごせます。',
  },
];

const amenities = [
  '2棟利用で最大9名',
  '無料Wi-Fi（通信品質・常時接続の保証なし）',
  'キッチン・調理器具',
  'SALVIA・2棟利用：屋外炊事場「ガゼボ庵」',
  'FREESIA：専用ウッドデッキでBBQ',
  '無人チェックイン',
  '無料駐車場',
  '元町港から車で約5分',
];

const faqs = [
  {
    question: '会社やチームで利用できますか？',
    answer: 'はい。少人数のオフサイト、ワーケーション、チーム合宿などの宿泊先としてご利用いただけます。SALVIAは最大6名、FREESIAは最大3名で、2棟利用なら最大9名まで宿泊できます。',
  },
  {
    question: 'Wi-Fiはありますか？',
    answer: 'はい。無料Wi-Fiをご利用いただけます。ただし、島内の回線状況、通信障害、天候、機器の状態などにより、一時的に接続しにくくなったり通信速度が低下したりする場合があります。常時の接続や通信速度を保証するものではないため、重要なオンライン会議等がある場合は予備の通信手段をご用意ください。',
  },
  {
    question: '釣った魚を調理できますか？',
    answer: 'SALVIAまたはSALVIA＋FREESIAをご利用の場合は、屋外炊事場「ガゼボ庵」で調理していただけます。FREESIA単独の場合は専用ウッドデッキでBBQをお楽しみください。炭・着火剤・着火ライター・食材・飲み物はご用意していません。',
  },
  {
    question: 'BBQの炭は用意されていますか？',
    answer: 'いいえ。BBQコンロ・ベンチはご用意していますが、炭・着火剤・着火ライター・食材・飲み物はご用意していません。BBQをされる方のみ、必要なものをご準備ください。',
  },
  {
    question: 'ダイビング旅行の宿泊にも使えますか？',
    answer: 'はい。ダイビングを楽しむグループの宿泊拠点としても歓迎しています。一棟貸しなので、仲間だけで自分たちのペースで過ごせます。',
  },
  {
    question: '基本的に用意されていないものはありますか？',
    answer: '寝巻き・パジャマ、髭剃りはご用意していません。必要な方はご自身でご用意ください。BBQをされる場合は、炭・着火剤・着火ライター・食材・飲み物もご用意していませんので、必要なものをご準備ください。',
  },
  {
    question: '一棟貸しはどんなグループに向いていますか？',
    answer: '2〜3名ならFREESIA、4〜6名ならSALVIA、7〜9名なら2棟利用がおすすめです。ホテルの客室のように必要以上に分かれず、人数に合わせた一棟貸しを選べます。',
  },
  {
    question: 'SALVIAとFREESIAはどう選べばいいですか？',
    answer: '目安として、2〜3名はFREESIA、4〜6名はSALVIA、7〜9名はSALVIA＋FREESIAの2棟利用がおすすめです。旅のメンバー構成や、就寝スペースを分けたいかどうかでも選べます。',
  },
  {
    question: 'SALVIAとFREESIAを同時に利用できますか？',
    answer: 'はい。同じ日程で両棟に空室がある場合は、2棟を利用して最大9名まで宿泊できます。2家族旅行や三世代旅行、友人グループなど、寝る場所や水回りを分けたい旅行に向いています。',
  },
  {
    question: 'BBQはどこでできますか？',
    answer: 'SALVIAをご利用の場合はガゼボ庵、FREESIA単独の場合はFREESIA専用ウッドデッキをご利用ください。SALVIA＋FREESIAの2棟利用ではガゼボ庵を利用できます。',
  },
  {
    question: '予約方法は？',
    answer: '現在の空室状況・宿泊料金・予約条件は予約ページで確認できます。日程と人数を入力してご確認ください。',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '大島ニュービラ', item: 'https://oshima-new-villa.com/' },
    { '@type': 'ListItem', position: 2, name: '伊豆大島の一棟貸し・グループ旅行', item: 'https://oshima-new-villa.com/group-stay/' },
  ],
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <!-- Hero -->
  <section class="relative overflow-hidden bg-green-950 pt-24 text-white md:pt-28" aria-labelledby="group-stay-title">
    <div class="absolute inset-0 opacity-25" aria-hidden="true">
      <img src="/main-optimized.webp" alt="" class="h-full w-full object-cover" width="1170" height="1171" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-br from-green-950 via-green-950/90 to-green-900/70" aria-hidden="true"></div>

    <div class="relative mx-auto grid max-w-7xl gap-10 px-6 py-16 md:py-24 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-14">
      <div>
        <a href="/" class="inline-flex items-center gap-2 text-sm font-bold text-green-200 transition-colors hover:text-white">
          <span aria-hidden="true">←</span> 大島ニュービラ トップへ
        </a>
        <p class="mt-10 text-xs font-bold tracking-[0.3em] text-green-300 uppercase">Group Stay / Work & Play</p>
        <h1 id="group-stay-title" class="mt-4 font-serif text-4xl font-bold leading-tight sm:text-5xl md:text-6xl">
          伊豆大島の一棟貸しで、<br />グループの時間をもっと特別に。
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-green-50/90 md:text-lg md:leading-9">
          家族や友人の旅行、オフサイト、ワーケーション、ダイビング、釣り旅行まで。人数に合わせてSALVIA・FREESIAを選べ、2棟利用なら最大9名まで泊まれるから、仕事も遊びも、仲間との時間も、自分たちのペースで楽しめます。
        </p>

        <div class="mt-8 flex flex-wrap gap-2 text-xs font-bold text-green-50">
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2">2棟利用で最大9名</span>
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2">無料Wi-Fi</span>
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2">BBQ・自炊</span>
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2">元町港から車約5分</span>
        </div>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href="https://www.booking.com/hotel/jp/salvia.ja.html"
            data-booking-location="group_stay_hero"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-white px-7 py-3.5 text-sm font-bold text-green-950 shadow-lg transition-all hover:-translate-y-0.5 hover:bg-green-50"
          >
            空室・料金を見る<span class="ml-2" aria-hidden="true">↗</span>
          </a>
          <a href="#stay-options" class="inline-flex items-center justify-center rounded-full border border-white/35 px-7 py-3.5 text-sm font-bold text-white transition-colors hover:bg-white/10">
            人数別の泊まり方を見る<span class="ml-2" aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:gap-4">
        <figure class="col-span-2 overflow-hidden rounded-3xl border border-white/10 bg-white/10 shadow-2xl">
          <img src="/sofa-salvia.webp" alt="グループで過ごせる大島ニュービラのリビング" class="aspect-[16/10] w-full object-cover" width="1108" height="832" />
        </figure>
        <figure class="overflow-hidden rounded-3xl border border-white/10 bg-white/10 shadow-xl">
          <img src="/day-bbq.webp" alt="屋根付きの屋外炊事場ガゼボ庵" class="aspect-square w-full object-cover" width="1376" height="2000" loading="lazy" />
        </figure>
        <figure class="overflow-hidden rounded-3xl border border-white/10 bg-white/10 shadow-xl">
          <img src="/night-bbq.webp" alt="夜のガゼボ庵とBBQスペース" class="aspect-square w-full object-cover" width="1500" height="2000" loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  <!-- Stay options by group size -->
  <section id="stay-options" class="bg-orange-50/45 py-20 md:py-28" aria-labelledby="stay-options-title">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">Choose by Group Size</p>
        <h2 id="stay-options-title" class="mt-3 font-serif text-3xl font-bold leading-tight text-gray-900 md:text-4xl">人数に合わせて選べる、3つの一棟貸し。</h2>
        <p class="mx-auto mt-5 max-w-2xl leading-8 text-gray-600 md:text-lg">少人数から最大9名のグループまで。人数と過ごし方に合わせてSALVIA・FREESIA・2棟利用を選べます。</p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        <article class="rounded-3xl border border-orange-100 bg-white p-7 shadow-sm">
          <p class="text-xs font-bold tracking-[0.2em] text-orange-700 uppercase">2〜3名</p>
          <h3 class="mt-2 font-serif text-2xl font-bold text-gray-900">FREESIA</h3>
          <p class="mt-4 text-sm leading-7 text-gray-600">夫婦・カップル・友人2〜3名なら、コンパクトなFREESIA。必要な設備が1棟にまとまり、少人数でも大きすぎない距離感で過ごせます。</p>
          <ul class="mt-5 space-y-2 text-sm font-bold text-gray-700"><li>✓ 最大3名</li><li>✓ 専用ウッドデッキでBBQ</li><li>✓ キッチン・浴室・トイレ・洗面</li></ul>
        </article>

        <article class="rounded-3xl border border-green-100 bg-white p-7 shadow-sm">
          <p class="text-xs font-bold tracking-[0.2em] text-green-700 uppercase">4〜6名</p>
          <h3 class="mt-2 font-serif text-2xl font-bold text-gray-900">SALVIA</h3>
          <p class="mt-4 text-sm leading-7 text-gray-600">家族や友人4〜6名なら、広めのSALVIA。ホテルで複数室に分かれず、リビング・ダイニング・キッチンを一緒に使えます。</p>
          <ul class="mt-5 space-y-2 text-sm font-bold text-gray-700"><li>✓ 最大6名</li><li>✓ ガゼボ庵でBBQ</li><li>✓ 69.27㎡の一棟貸し</li></ul>
        </article>

        <article class="rounded-3xl border border-emerald-200 bg-emerald-950 p-7 text-white shadow-sm">
          <p class="text-xs font-bold tracking-[0.2em] text-emerald-200 uppercase">7〜9名</p>
          <h3 class="mt-2 font-serif text-2xl font-bold">SALVIA + FREESIA</h3>
          <p class="mt-4 text-sm leading-7 text-emerald-50/85">2家族・三世代・友人グループなら2棟利用。寝室や水回りを分けられるため、大人数でも生活時間の違いを調整しやすくなります。</p>
          <ul class="mt-5 space-y-2 text-sm font-bold text-emerald-50"><li>✓ 2棟合計で最大9名</li><li>✓ ガゼボ庵利用可</li><li>✓ 2つのキッチン・浴室</li></ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section id="uses" class="bg-white py-20 md:py-28" aria-labelledby="uses-title">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">For Your Group</p>
        <h2 id="uses-title" class="mt-3 font-serif text-3xl font-bold leading-tight text-gray-900 md:text-4xl">こんな利用におすすめです。</h2>
        <p class="mt-5 leading-7 text-gray-600 md:text-lg md:leading-8">
          観光旅行だけではなく、平日のチーム利用や海のアクティビティを目的にした滞在にも。必要なサービスを増やしすぎず、仲間だけで自由に過ごせる一棟貸しです。
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {useCases.map((item) => (
          <article class="rounded-3xl border border-gray-100 bg-orange-50/40 p-7 shadow-sm">
            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-xl shadow-sm" aria-hidden="true">{item.icon}</div>
            <p class="mt-5 text-xs font-bold tracking-[0.2em] text-green-700 uppercase">{item.kicker}</p>
            <h3 class="mt-2 font-serif text-xl font-bold text-gray-900">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">{item.description}</p>
            {item.href && (
              <a href={item.href} class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-cyan-800 underline decoration-cyan-200 underline-offset-4 transition-colors hover:text-cyan-950">
                ダイビング旅行の宿泊案内を見る<span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="villa-comparison" class="bg-white py-20 md:py-28" aria-labelledby="villa-comparison-title">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">Compare Your Stay</p>
        <h2 id="villa-comparison-title" class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">設備と過ごし方を比べる。</h2>
        <p class="mx-auto mt-5 max-w-2xl leading-8 text-gray-600 md:text-lg">同じ敷地内でも、人数とBBQの場所が異なります。予約前に違いを確認して、自分たちに合う泊まり方を選んでください。</p>
      </div>

      <div class="mt-10 overflow-x-auto rounded-3xl border border-gray-200 bg-white shadow-sm">
        <table class="min-w-[820px] w-full border-collapse text-left text-sm">
          <thead class="bg-green-950 text-white">
            <tr>
              <th class="px-5 py-4 font-bold">比較項目</th>
              <th class="px-5 py-4 font-bold">SALVIA</th>
              <th class="px-5 py-4 font-bold">FREESIA</th>
              <th class="px-5 py-4 font-bold">SALVIA + FREESIA</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 text-gray-700">
            <tr><th class="bg-gray-50 px-5 py-4 font-bold text-gray-900">定員</th><td class="px-5 py-4">最大6名</td><td class="px-5 py-4">最大3名</td><td class="px-5 py-4">最大9名</td></tr>
            <tr><th class="bg-gray-50 px-5 py-4 font-bold text-gray-900">おすすめ人数</th><td class="px-5 py-4">4〜6名</td><td class="px-5 py-4">2〜3名</td><td class="px-5 py-4">7〜9名</td></tr>
            <tr><th class="bg-gray-50 px-5 py-4 font-bold text-gray-900">向いている旅行</th><td class="px-5 py-4">家族・友人グループ</td><td class="px-5 py-4">夫婦・カップル・少人数</td><td class="px-5 py-4">2家族・三世代・大人数グループ</td></tr>
            <tr><th class="bg-gray-50 px-5 py-4 font-bold text-gray-900">BBQ</th><td class="px-5 py-4">ガゼボ庵</td><td class="px-5 py-4">専用ウッドデッキ</td><td class="px-5 py-4">ガゼボ庵を利用可</td></tr>
            <tr><th class="bg-gray-50 px-5 py-4 font-bold text-gray-900">キッチン</th><td class="px-5 py-4">あり</td><td class="px-5 py-4">あり</td><td class="px-5 py-4">2棟それぞれにあり</td></tr>
            <tr><th class="bg-gray-50 px-5 py-4 font-bold text-gray-900">浴室・トイレ</th><td class="px-5 py-4">あり</td><td class="px-5 py-4">あり</td><td class="px-5 py-4">2棟それぞれにあり</td></tr>
            <tr><th class="bg-gray-50 px-5 py-4 font-bold text-gray-900">特徴</th><td class="px-5 py-4">みんなで同じリビングに集まりやすい</td><td class="px-5 py-4">少人数でコンパクトに過ごしやすい</td><td class="px-5 py-4">集まる時間と休む時間を分けやすい</td></tr>
          </tbody>
        </table>
      </div>

      <div class="mt-8 rounded-3xl border border-green-100 bg-green-50/60 p-6 md:p-8">
        <h3 class="font-serif text-2xl font-bold text-gray-900">2棟同時利用のメリット</h3>
        <p class="mt-4 max-w-4xl leading-8 text-gray-600">SALVIAとFREESIAは同じ敷地内にあります。日中や食事は一緒に過ごしながら、就寝時は2棟に分かれられるため、家族ごと・世代ごとに休みやすいのが特長です。大人数のBBQはSALVIA側のガゼボ庵を利用できます。</p>
      </div>
    </div>
  </section>

  <!-- Why private villa -->
  <section class="bg-green-50/60 py-20 md:py-28" aria-labelledby="private-title">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-2 lg:items-center lg:gap-14">
      <div class="grid grid-cols-2 gap-4">
        <figure class="col-span-2 overflow-hidden rounded-3xl bg-white shadow-sm">
          <img src="/sofa-salvia.webp" alt="テーブルとソファを備えたサルビア棟のリビング" class="aspect-[16/9] w-full object-cover" width="1108" height="832" loading="lazy" />
        </figure>
        <figure class="overflow-hidden rounded-3xl bg-white shadow-sm">
          <img src="/bed-salvia.webp" alt="シングルベッド4台を備えた寝室" class="aspect-square w-full object-cover" width="1477" height="994" loading="lazy" />
        </figure>
        <figure class="overflow-hidden rounded-3xl bg-white shadow-sm">
          <img src="/night-bbq.webp" alt="仲間と夜を楽しめるガゼボ庵" class="aspect-square w-full object-cover" width="1500" height="2000" loading="lazy" />
        </figure>
      </div>

      <div>
        <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">Private Villa</p>
        <h2 id="private-title" class="mt-3 font-serif text-3xl font-bold leading-tight text-gray-900 md:text-4xl">
          ホテルの客室ではなく、<br class="hidden sm:block" />一棟まるごと自分たちの空間に。
        </h2>
        <p class="mt-6 leading-8 text-gray-600 md:text-lg md:leading-9">
          大島ニュービラはSALVIA（最大6名）とFREESIA（最大3名）の2棟。4〜6名ならSALVIA、7〜9名なら2棟利用など、人数に合わせて宿泊棟を組み合わせられます。
        </p>
        <p class="mt-4 leading-8 text-gray-600">
          4〜6名の旅行では、ホテルだと複数の客室に分かれることがあります。一棟貸しなら、観光から戻ったあともリビングやダイニングに集まり、食事や翌日の予定をみんなで話しながら過ごせます。
        </p>
        <p class="mt-4 leading-8 text-gray-600">
          スタッフが常駐する宿ではなく、タブレットを使った無人チェックイン。滞在中も、自分たちのスケジュールで自由にお過ごしください。
        </p>
      </div>
    </div>
  </section>

  <!-- Amenities -->
  <section class="bg-white py-20 md:py-28" aria-labelledby="group-amenities-title">
    <div class="mx-auto max-w-5xl px-6">
      <div class="text-center">
        <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">Facilities</p>
        <h2 id="group-amenities-title" class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">グループ利用にうれしい設備。</h2>
      </div>

      <ul class="mt-10 grid gap-3 sm:grid-cols-2" aria-label="グループ利用向け設備">
        {amenities.map((item) => (
          <li class="flex items-center gap-3 rounded-2xl border border-green-100 bg-green-50/50 px-5 py-4 text-sm font-bold text-gray-800">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-green-700 text-xs text-white" aria-hidden="true">✓</span>
            {item}
          </li>
        ))}
      </ul>

      <p class="mt-6 text-center text-sm leading-7 text-gray-500">
        専用の会議室やスタッフ常駐サービスはありません。必要なものを持ち込み、自分たちで自由に過ごしたい少人数グループに向いています。
      </p>

      <aside class="mt-10 rounded-3xl border border-gray-200 bg-gray-50 p-6 md:p-8" aria-labelledby="group-shared-equipment-title">
        <p class="text-xs font-bold tracking-[0.22em] text-gray-500 uppercase">Shared Facilities</p>
        <h3 id="group-shared-equipment-title" class="mt-2 font-serif text-xl font-bold text-gray-900 md:text-2xl">同じ敷地内の共用設備</h3>
        <p class="mt-3 text-sm leading-7 text-gray-600">
          同じ敷地内には、ご宿泊中のお客様が無料で利用できる洗濯機・乾燥機・シャワー・トイレがあります。
        </p>
        <p class="mt-3 text-xs leading-6 text-gray-500">
          これらは大島ニュービラの宿泊設備・付帯設備には含まれません。メンテナンス・故障・清掃等により予告なくご利用いただけない場合があります。
        </p>
      </aside>
    </div>
  </section>

  <!-- Fishing / Diving -->
  <section class="overflow-hidden bg-slate-950 py-20 text-white md:py-28" aria-labelledby="active-title">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-14">
      <div>
        <p class="text-xs font-bold tracking-[0.3em] text-orange-300 uppercase">Fishing & Diving</p>
        <h2 id="active-title" class="mt-3 font-serif text-3xl font-bold leading-tight md:text-4xl">釣りやダイビングを楽しむ方にも。</h2>
        <p class="mt-6 leading-8 text-slate-300 md:text-lg md:leading-9">
          伊豆大島の海を楽しんだあとは、森のヴィラへ。釣り旅行では、釣った魚を屋外炊事場「ガゼボ庵」で調理して、そのまま仲間との食事を楽しめます。
        </p>
        <p class="mt-4 leading-8 text-slate-400">
          ダイビングを楽しむグループの宿泊も歓迎しています。観光の時間割に合わせるのではなく、海の予定を中心に自分たちのペースで滞在できます。
        </p>
        <a href="/diving/" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-cyan-200 underline decoration-cyan-800 underline-offset-4 transition-colors hover:text-white">
          伊豆大島のダイビング旅行・宿泊案内を見る<span aria-hidden="true">→</span>
        </a>
        <div class="mt-4">
          <a href="/guide/group-trip/" class="inline-flex items-center gap-2 text-sm font-bold text-orange-200 underline decoration-orange-800 underline-offset-4 transition-colors hover:text-white">
            4〜6名のグループ旅行モデルを見る<span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <figure class="overflow-hidden rounded-3xl border border-white/10 shadow-2xl">
        <img src="/night-bbq.webp" alt="釣りや海遊びのあとに食事を楽しめる夜のガゼボ庵" class="aspect-[4/3] w-full object-cover" width="1500" height="2000" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-orange-50/50 py-20 md:py-28" aria-labelledby="group-faq-title">
    <div class="mx-auto max-w-4xl px-6">
      <div class="text-center">
        <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">FAQ</p>
        <h2 id="group-faq-title" class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">グループ利用のよくある質問。</h2>
      </div>

      <div class="mt-10 rounded-3xl border border-gray-100 bg-white px-6 shadow-sm sm:px-8">
        {faqs.map((faq) => (
          <details class="group border-b border-gray-200 py-5 last:border-b-0">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <span class="mt-1 text-xl leading-none text-green-700 transition-transform group-open:rotate-45" aria-hidden="true">＋</span>
            </summary>
            <p class="pt-3 pr-8 text-sm leading-7 text-gray-600">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden py-24 md:py-28" aria-labelledby="group-cta-title">
    <img src="/main-optimized.webp" alt="" class="absolute inset-0 h-full w-full object-cover" width="1170" height="1171" loading="lazy" aria-hidden="true" />
    <div class="absolute inset-0 bg-white/88 backdrop-blur-sm" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-6 text-center">
      <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">Weekday Stay</p>
      <h2 id="group-cta-title" class="mt-3 font-serif text-3xl font-bold leading-tight text-gray-900 md:text-5xl">平日のグループ利用も歓迎しています。</h2>
      <p class="mx-auto mt-6 max-w-2xl leading-8 text-gray-600 md:text-lg md:leading-9">
        オフサイト、ワーケーション、ダイビング、釣り、写真撮影など。いつもの観光旅行とは少し違う伊豆大島の過ごし方にも、大島ニュービラをご利用ください。
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="https://www.booking.com/hotel/jp/salvia.ja.html"
          data-booking-location="group_stay_bottom_cta"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full max-w-sm items-center justify-center rounded-full bg-green-700 px-8 py-4 text-base font-bold text-white shadow-xl transition-all hover:-translate-y-0.5 hover:bg-green-600 sm:w-auto"
        >
          空室・料金を見る<span class="ml-2" aria-hidden="true">↗</span>
        </a>
        <a href="/" class="inline-flex w-full max-w-sm items-center justify-center rounded-full border-2 border-green-800 bg-white/90 px-8 py-3.5 text-sm font-bold text-green-800 transition-colors hover:bg-green-800 hover:text-white sm:w-auto">
          大島ニュービラのトップへ
        </a>
      </div>
    </div>
  </section>
</Layout>
