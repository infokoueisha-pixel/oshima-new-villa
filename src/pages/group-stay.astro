---
import Layout from '../layouts/Layout.astro';

const pageTitle = '伊豆大島のグループ旅行・オフサイト・ワーケーション｜大島ニュービラ';
const pageDescription = '伊豆大島でオフサイト、ワーケーション、ダイビング、釣り旅行をご検討の方へ。最大6名の一棟貸し「大島ニュービラ」は、Wi-Fi・キッチン・BBQ設備を備えたグループ利用の宿です。';

const useCases = [
  {
    icon: '💬',
    kicker: 'Offsite',
    title: 'オフサイト',
    description: '少人数のチームで集まり、話す・考える・食べる時間を一つの場所で。会議室とは違う環境で過ごせます。',
  },
  {
    icon: '💻',
    kicker: 'Workation',
    title: 'ワーケーション',
    description: '無料Wi-Fiを備え、リビングやダイニングでPC作業ができます。仕事の前後は島の自然へ。',
  },
  {
    icon: '🧑‍💻',
    kicker: 'Team Camp',
    title: '開発・チーム合宿',
    description: '最大6名の一棟貸し。仕事が終わったあとも、料理やBBQを囲みながらチームだけで過ごせます。',
  },
  {
    icon: '🤿',
    kicker: 'Diving',
    title: 'ダイビング旅行',
    description: '伊豆大島で海を楽しむグループの宿泊拠点としても歓迎しています。観光とは違う島時間を楽しみたい方へ。',
  },
  {
    icon: '🎣',
    kicker: 'Fishing',
    title: '釣り旅行',
    description: '釣りを楽しんだあとは、屋外炊事場「ガゼボ庵」で釣った魚を調理して食事を楽しめます。',
  },
  {
    icon: '📷',
    kicker: 'Photography',
    title: '写真・星空撮影',
    description: '朝夕の景色や星空を目的に動きたい方にも。一棟貸しだから、自分たちのスケジュールで過ごせます。',
  },
];

const amenities = [
  '最大6名・一棟貸切',
  '無料Wi-Fi',
  'キッチン・調理器具',
  '屋外炊事場「ガゼボ庵」',
  'BBQ設備（コンロ・ベンチ／炭は要持参）',
  '無人チェックイン',
  '無料駐車場',
  '元町港から車で約5分',
];

const faqs = [
  {
    question: '会社やチームで利用できますか？',
    answer: 'はい。少人数のオフサイト、ワーケーション、チーム合宿などの宿泊先としてご利用いただけます。最大6名の一棟貸しです。',
  },
  {
    question: 'Wi-Fiはありますか？',
    answer: 'はい、無料Wi-Fiを用意しています。リビングやダイニングでPC作業ができます。通信状況は回線や天候などにより変動する場合があります。',
  },
  {
    question: '釣った魚を調理できますか？',
    answer: 'はい。屋外炊事場「ガゼボ庵」で調理していただけます。BBQコンロ・ベンチもあるので、釣りのあとの食事まで仲間と楽しめます。炭は施設では用意していないため、BBQを予定している場合はご持参ください。',
  },
  {
    question: 'BBQの炭は用意されていますか？',
    answer: 'いいえ。BBQコンロ・ベンチは用意していますが、炭は施設ではご用意していません。BBQを予定している場合は炭をご持参ください。食材・飲み物も各自でご用意ください。',
  },
  {
    question: 'ダイビング旅行の宿泊にも使えますか？',
    answer: 'はい。ダイビングを楽しむグループの宿泊拠点としても歓迎しています。一棟貸しなので、仲間だけで自分たちのペースで過ごせます。',
  },
  {
    question: '予約方法は？',
    answer: '現在の空室状況・宿泊料金・予約条件はAirbnbで確認できます。日程と人数を入力してご確認ください。',
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-green-950 pt-24 text-white md:pt-28" aria-labelledby="group-stay-title">
    <div class="absolute inset-0 opacity-25" aria-hidden="true">
      <img src="/main-optimized.webp" alt="" class="h-full w-full object-cover" width="1170" height="1171" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-br from-green-950 via-green-950/90 to-green-900/70" aria-hidden="true"></div>

    <div class="relative mx-auto grid max-w-7xl gap-10 px-6 py-16 md:py-24 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-14">
      <div>
        <a href="/" class="inline-flex items-center gap-2 text-sm font-bold text-green-200 transition-colors hover:text-white">
          <span aria-hidden="true">←</span> 大島ニュービラ トップへ
        </a>
        <p class="mt-10 text-xs font-bold tracking-[0.3em] text-green-300 uppercase">Group Stay / Work & Play</p>
        <h1 id="group-stay-title" class="mt-4 font-serif text-4xl font-bold leading-tight sm:text-5xl md:text-6xl">
          グループで集まる時間を、<br />もっと特別に。
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-green-50/90 md:text-lg md:leading-9">
          オフサイト、ワーケーション、ダイビング、釣り旅行まで。最大6名の一棟貸しだから、仕事も遊びも、仲間との時間も、自分たちのペースで楽しめます。
        </p>

        <div class="mt-8 flex flex-wrap gap-2 text-xs font-bold text-green-50">
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2">最大6名</span>
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2">無料Wi-Fi</span>
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2">BBQ・自炊</span>
          <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2">元町港から車約5分</span>
        </div>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href="https://www.airbnb.jp/rooms/1602063410123886296?guests=6&adults=6&s=67&unique_share_id=a393ba49-61eb-4d8e-a4c9-95935b649d65"
            data-booking-location="group_stay_hero"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-white px-7 py-3.5 text-sm font-bold text-green-950 shadow-lg transition-all hover:-translate-y-0.5 hover:bg-green-50"
          >
            空室・料金を見る<span class="ml-2" aria-hidden="true">↗</span>
          </a>
          <a href="#uses" class="inline-flex items-center justify-center rounded-full border border-white/35 px-7 py-3.5 text-sm font-bold text-white transition-colors hover:bg-white/10">
            利用シーンを見る<span class="ml-2" aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:gap-4">
        <figure class="col-span-2 overflow-hidden rounded-3xl border border-white/10 bg-white/10 shadow-2xl">
          <img src="/sofa-salvia.webp" alt="グループで過ごせる大島ニュービラのリビング" class="aspect-[16/10] w-full object-cover" width="1108" height="832" />
        </figure>
        <figure class="overflow-hidden rounded-3xl border border-white/10 bg-white/10 shadow-xl">
          <img src="/day-bbq.webp" alt="屋根付きの屋外炊事場ガゼボ庵" class="aspect-square w-full object-cover" width="1376" height="2000" loading="lazy" />
        </figure>
        <figure class="overflow-hidden rounded-3xl border border-white/10 bg-white/10 shadow-xl">
          <img src="/night-bbq.webp" alt="夜のガゼボ庵とBBQスペース" class="aspect-square w-full object-cover" width="1500" height="2000" loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section id="uses" class="bg-white py-20 md:py-28" aria-labelledby="uses-title">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">For Your Group</p>
        <h2 id="uses-title" class="mt-3 font-serif text-3xl font-bold leading-tight text-gray-900 md:text-4xl">こんな利用におすすめです。</h2>
        <p class="mt-5 leading-7 text-gray-600 md:text-lg md:leading-8">
          観光旅行だけではなく、平日のチーム利用や海のアクティビティを目的にした滞在にも。必要なサービスを増やしすぎず、仲間だけで自由に過ごせる一棟貸しです。
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {useCases.map((item) => (
          <article class="rounded-3xl border border-gray-100 bg-orange-50/40 p-7 shadow-sm">
            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-xl shadow-sm" aria-hidden="true">{item.icon}</div>
            <p class="mt-5 text-xs font-bold tracking-[0.2em] text-green-700 uppercase">{item.kicker}</p>
            <h3 class="mt-2 font-serif text-xl font-bold text-gray-900">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Why private villa -->
  <section class="bg-green-50/60 py-20 md:py-28" aria-labelledby="private-title">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-2 lg:items-center lg:gap-14">
      <div class="grid grid-cols-2 gap-4">
        <figure class="col-span-2 overflow-hidden rounded-3xl bg-white shadow-sm">
          <img src="/sofa-salvia.webp" alt="テーブルとソファを備えたサルビア棟のリビング" class="aspect-[16/9] w-full object-cover" width="1108" height="832" loading="lazy" />
        </figure>
        <figure class="overflow-hidden rounded-3xl bg-white shadow-sm">
          <img src="/bed-salvia.webp" alt="シングルベッド4台を備えた寝室" class="aspect-square w-full object-cover" width="1477" height="994" loading="lazy" />
        </figure>
        <figure class="overflow-hidden rounded-3xl bg-white shadow-sm">
          <img src="/night-bbq.webp" alt="仲間と夜を楽しめるガゼボ庵" class="aspect-square w-full object-cover" width="1500" height="2000" loading="lazy" />
        </figure>
      </div>

      <div>
        <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">Private Villa</p>
        <h2 id="private-title" class="mt-3 font-serif text-3xl font-bold leading-tight text-gray-900 md:text-4xl">
          仕事が終わっても、<br class="hidden sm:block" />チームの時間は続く。
        </h2>
        <p class="mt-6 leading-8 text-gray-600 md:text-lg md:leading-9">
          大島ニュービラは最大6名の一棟貸し。話し合う時間も、料理する時間も、夜にBBQを囲む時間も、同じ場所で過ごせます。
        </p>
        <p class="mt-4 leading-8 text-gray-600">
          スタッフが常駐する宿ではなく、タブレットを使った無人チェックイン。滞在中も、自分たちのスケジュールで自由にお過ごしください。
        </p>
      </div>
    </div>
  </section>

  <!-- Amenities -->
  <section class="bg-white py-20 md:py-28" aria-labelledby="group-amenities-title">
    <div class="mx-auto max-w-5xl px-6">
      <div class="text-center">
        <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">Facilities</p>
        <h2 id="group-amenities-title" class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">グループ利用にうれしい設備。</h2>
      </div>

      <ul class="mt-10 grid gap-3 sm:grid-cols-2" aria-label="グループ利用向け設備">
        {amenities.map((item) => (
          <li class="flex items-center gap-3 rounded-2xl border border-green-100 bg-green-50/50 px-5 py-4 text-sm font-bold text-gray-800">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-green-700 text-xs text-white" aria-hidden="true">✓</span>
            {item}
          </li>
        ))}
      </ul>

      <p class="mt-6 text-center text-sm leading-7 text-gray-500">
        専用の会議室やスタッフ常駐サービスはありません。必要なものを持ち込み、自分たちで自由に過ごしたい少人数グループに向いています。
      </p>
    </div>
  </section>

  <!-- Fishing / Diving -->
  <section class="overflow-hidden bg-slate-950 py-20 text-white md:py-28" aria-labelledby="active-title">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-14">
      <div>
        <p class="text-xs font-bold tracking-[0.3em] text-orange-300 uppercase">Fishing & Diving</p>
        <h2 id="active-title" class="mt-3 font-serif text-3xl font-bold leading-tight md:text-4xl">釣りやダイビングを楽しむ方にも。</h2>
        <p class="mt-6 leading-8 text-slate-300 md:text-lg md:leading-9">
          伊豆大島の海を楽しんだあとは、森のヴィラへ。釣り旅行では、釣った魚を屋外炊事場「ガゼボ庵」で調理して、そのまま仲間との食事を楽しめます。
        </p>
        <p class="mt-4 leading-8 text-slate-400">
          ダイビングを楽しむグループの宿泊も歓迎しています。観光の時間割に合わせるのではなく、海の予定を中心に自分たちのペースで滞在できます。
        </p>
      </div>

      <figure class="overflow-hidden rounded-3xl border border-white/10 shadow-2xl">
        <img src="/night-bbq.webp" alt="釣りや海遊びのあとに食事を楽しめる夜のガゼボ庵" class="aspect-[4/3] w-full object-cover" width="1500" height="2000" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-orange-50/50 py-20 md:py-28" aria-labelledby="group-faq-title">
    <div class="mx-auto max-w-4xl px-6">
      <div class="text-center">
        <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">FAQ</p>
        <h2 id="group-faq-title" class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">グループ利用のよくある質問。</h2>
      </div>

      <div class="mt-10 rounded-3xl border border-gray-100 bg-white px-6 shadow-sm sm:px-8">
        {faqs.map((faq) => (
          <details class="group border-b border-gray-200 py-5 last:border-b-0">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <span class="mt-1 text-xl leading-none text-green-700 transition-transform group-open:rotate-45" aria-hidden="true">＋</span>
            </summary>
            <p class="pt-3 pr-8 text-sm leading-7 text-gray-600">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden py-24 md:py-28" aria-labelledby="group-cta-title">
    <img src="/main-optimized.webp" alt="" class="absolute inset-0 h-full w-full object-cover" width="1170" height="1171" loading="lazy" aria-hidden="true" />
    <div class="absolute inset-0 bg-white/88 backdrop-blur-sm" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-6 text-center">
      <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">Weekday Stay</p>
      <h2 id="group-cta-title" class="mt-3 font-serif text-3xl font-bold leading-tight text-gray-900 md:text-5xl">平日のグループ利用も歓迎しています。</h2>
      <p class="mx-auto mt-6 max-w-2xl leading-8 text-gray-600 md:text-lg md:leading-9">
        オフサイト、ワーケーション、ダイビング、釣り、写真撮影など。いつもの観光旅行とは少し違う伊豆大島の過ごし方にも、大島ニュービラをご利用ください。
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="https://www.airbnb.jp/rooms/1602063410123886296?guests=6&adults=6&s=67&unique_share_id=a393ba49-61eb-4d8e-a4c9-95935b649d65"
          data-booking-location="group_stay_bottom_cta"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full max-w-sm items-center justify-center rounded-full bg-green-700 px-8 py-4 text-base font-bold text-white shadow-xl transition-all hover:-translate-y-0.5 hover:bg-green-600 sm:w-auto"
        >
          Airbnbで空室・料金を見る<span class="ml-2" aria-hidden="true">↗</span>
        </a>
        <a href="/" class="inline-flex w-full max-w-sm items-center justify-center rounded-full border-2 border-green-800 bg-white/90 px-8 py-3.5 text-sm font-bold text-green-800 transition-colors hover:bg-green-800 hover:text-white sm:w-auto">
          大島ニュービラのトップへ
        </a>
      </div>
    </div>
  </section>
</Layout>
