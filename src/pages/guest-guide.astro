---
import Layout from '../layouts/Layout.astro';
const pageTitle = 'ご宿泊ガイド｜予約タイプを選択｜大島ニュービラ';
const pageDescription = '大島ニュービラのご宿泊者向けガイド。SALVIA、FREESIA、2棟同時予約からご予約タイプを選択してください。';
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <main class="min-h-screen bg-orange-50 pt-24 md:pt-28">
    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">Guest Guide</p>
          <h1 class="mt-4 font-serif text-4xl font-bold text-gray-900 md:text-5xl">ご予約の宿泊タイプを選択してください</h1>
          <p class="mx-auto mt-6 max-w-2xl text-sm leading-8 text-gray-600 md:text-base">予約確認に記載された宿泊タイプを選ぶと、利用できる設備やBBQ場所に合わせた案内をご覧いただけます。</p>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
        <a href="/guest-guide/salvia/" class="group rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-lg">
          <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">最大6名</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-gray-900">SALVIA</h2>
          <p class="mt-3 text-sm leading-7 text-gray-600">BBQはガゼボ庵</p>
          <span class="mt-6 inline-flex text-sm font-bold text-green-800">ガイドを開く <span class="ml-1 transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        <a href="/guest-guide/freesia/" class="group rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-lg">
          <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">最大3名</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-gray-900">FREESIA</h2>
          <p class="mt-3 text-sm leading-7 text-gray-600">BBQは専用ウッドデッキ</p>
          <span class="mt-6 inline-flex text-sm font-bold text-green-800">ガイドを開く <span class="ml-1 transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        <a href="/guest-guide/salvia-freesia/" class="group rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-lg">
          <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">2棟で最大9名</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-gray-900">SALVIA + FREESIA</h2>
          <p class="mt-3 text-sm leading-7 text-gray-600">ガゼボ庵も利用できます</p>
          <span class="mt-6 inline-flex text-sm font-bold text-green-800">ガイドを開く <span class="ml-1 transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        </div>
        <p class="mx-auto mt-8 max-w-2xl text-center text-xs leading-6 text-gray-500">予約後のご案内メールでは、該当するガイドへ直接ご案内します。</p>
      </div>
    </section>
  </main>
</Layout>
