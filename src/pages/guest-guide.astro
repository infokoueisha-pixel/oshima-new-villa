---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'ご宿泊ガイド｜大島ニュービラ';
const pageDescription = '大島ニュービラにご宿泊のお客様向けガイド。到着港、バス、Wi-Fi、チェックイン、持参品、BBQ、無料貸出品、敷地内のオーナー所有設備などをご案内します。';

const quickLinks = [
  { label: '到着・チェックイン', href: '#arrival', icon: '🚢' },
  { label: 'Wi-Fi', href: '#wifi', icon: '📶' },
  { label: '設備・持参品', href: '#guest-info', icon: '🧳' },
  { label: '島で食べる・遊ぶ・買う', href: '#island-guide', icon: '🗺️' },
  { label: 'BBQ・ガゼボ庵', href: '#bbq', icon: '🔥' },
  { label: '森での過ごし方', href: '#forest-time', icon: '🌙' },
];

const basicAmenities = [
  'シングルベッド4台・ソファベッド2台',
  '6名で囲めるダイニング・バス／トイレ別',
  '冷蔵庫・電子レンジ・炊飯器・トースター',
  '電気ケトル・ガスコンロ・基本調理器具・食器類',
  '浴槽・シャワー・温水洗浄便座',
  'バスタオル・フェイスタオル・歯ブラシ・室内用スリッパ',
  'シャンプー・リンス・ボディソープ',
  'BBQコンロ・ベンチ（炭は付属しません）',
  '無料Wi-Fi（通信品質・常時接続の保証はありません）',
];

const bringItems = [
  '寝巻き・パジャマ',
  '髭剃り',
  'BBQ用の炭',
  'BBQの食材・飲み物',
  '着火剤・着火ライター（BBQをする場合）',
  '普段お使いの化粧品・スキンケア用品',
];

const complimentaryItems = [
  'ボードゲーム',
  '玩具類',
  '水鉄砲などの水遊び用品',
  '外履き用スリッパ',
  '洗顔料',
];

const ownerFacilities = [
  '洗濯機',
  'ガス乾燥機',
  'コンテナ内シャワー',
  'コンテナ内トイレ',
];

const bbqCoreItems = [
  'BBQコンロ',
  '網・鉄板',
  'トング・軍手',
  '折りたたみテーブル',
  'シンク・バケツ',
];
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <main class="bg-orange-50">
    <!-- Hero -->
    <section class="relative overflow-hidden pt-24 md:pt-28">
      <div class="absolute inset-0">
        <img
          src="/forest-optimized.webp"
          alt="大島ニュービラを囲む森"
          class="h-full w-full object-cover"
          width="1500"
          height="2000"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-green-950/65"></div>
      </div>
      <div class="relative mx-auto max-w-5xl px-6 py-20 text-center text-white md:py-28">
        <p class="text-xs font-bold tracking-[0.3em] text-green-200 uppercase">Guest Guide</p>
        <h1 class="mt-4 font-serif text-4xl font-bold tracking-wide sm:text-5xl">ようこそ、大島ニュービラへ。</h1>
        <p class="mx-auto mt-6 max-w-2xl text-sm leading-8 text-white/90 sm:text-base">
          海を越え、この森の入り口まで辿り着いてくださりありがとうございます。<br class="hidden sm:block" />
          このガイドを、島での時間をスムーズに、そして自由に楽しむための地図としてお使いください。
        </p>
        <div class="mx-auto mt-8 inline-flex rounded-full border border-white/30 bg-white/10 px-5 py-2 text-xs font-bold tracking-wide text-white/90 backdrop-blur-sm">
          ご宿泊者向けページ
        </div>
      </div>
    </section>

    <!-- Quick navigation -->
    <section class="border-b border-orange-100 bg-white py-8">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
          {quickLinks.map((item) => (
            <a
              href={item.href}
              class="flex min-h-24 flex-col items-center justify-center rounded-2xl border border-gray-200 bg-white px-3 py-4 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-green-300 hover:shadow-md"
            >
              <span class="text-2xl" aria-hidden="true">{item.icon}</span>
              <span class="mt-2 text-xs font-bold leading-5 text-gray-800">{item.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Arrival -->
    <section id="arrival" class="scroll-mt-28 py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="max-w-3xl">
          <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">Before Arrival</p>
          <h2 class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">到着前に確認すること</h2>
          <p class="mt-5 leading-8 text-gray-600">伊豆大島では、その日の海況によって入港地が変わることがあります。出発前に最新情報をご確認ください。</p>
        </div>

        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          <article class="rounded-3xl border border-orange-100 bg-white p-7 shadow-sm">
            <div class="text-3xl" aria-hidden="true">🚨</div>
            <h3 class="mt-4 text-xl font-bold text-gray-900">本日の入港地</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">元町港・岡田港のどちらに到着するかを確認してください。高速ジェット船の入出港地は当日朝6:00頃に案内されます。</p>
            <a
              href="https://www.tokaikisen.co.jp/schedule/"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-green-700 hover:underline"
            >
              東海汽船の運航状況を見る <span aria-hidden="true">↗</span>
            </a>
          </article>

          <article class="rounded-3xl border border-orange-100 bg-white p-7 shadow-sm">
            <div class="text-3xl" aria-hidden="true">🚌</div>
            <h3 class="mt-4 text-xl font-bold text-gray-900">バスの時刻表</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">最寄りは「大島高校前」バス停で、施設まで徒歩約9分です。当日の入出港地によりダイヤが変わる場合があるため、乗車前に最新の公園線時刻表をご確認ください。</p>
            <a
              href="https://www.oshima-bus.com/rosen-bus.html"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-green-700 hover:underline"
            >
              大島バスの時刻表を見る <span aria-hidden="true">↗</span>
            </a>
          </article>

          <article class="rounded-3xl border border-orange-100 bg-white p-7 shadow-sm">
            <div class="text-3xl" aria-hidden="true">🔑</div>
            <h3 class="mt-4 text-xl font-bold text-gray-900">チェックイン</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">チェックインは15:00から、チェックアウトは10:00までです。敷地内に設置したタブレットを使用する無人受付となります。</p>
            <p class="mt-4 rounded-2xl bg-orange-50 px-4 py-3 text-xs font-medium leading-6 text-gray-600">元町港から車約5分 ／ 岡田港から約11分 ／ 東京大島かめりあ空港から約6分</p>
          </article>
        </div>

        <div class="mt-6 rounded-3xl border border-green-100 bg-green-50/70 p-6 md:flex md:items-center md:justify-between md:gap-8">
          <div>
            <h3 class="font-serif text-lg font-bold text-gray-900">島内の移動はレンタカーがおすすめです</h3>
            <p class="mt-2 text-sm leading-7 text-gray-600">三原山・裏砂漠・波浮港・御神火温泉・買い出しなどを自由に巡るならレンタカーが便利です。台数に限りがあるため、宿とあわせて早めの予約をおすすめします。</p>
          </div>
          <a href="https://www.oshima-navi.com/transportation/" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex shrink-0 text-sm font-bold text-green-700 hover:underline md:mt-0">島内交通の案内を見る ↗</a>
        </div>
      </div>
    </section>

    <!-- Wi-Fi -->
    <section id="wifi" class="scroll-mt-28 bg-green-950 py-16 text-white md:py-20">
      <div class="mx-auto max-w-5xl px-6">
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <p class="text-xs font-bold tracking-[0.28em] text-green-300 uppercase">Wi-Fi</p>
            <h2 class="mt-3 font-serif text-3xl font-bold">無料Wi-Fiをご利用いただけます</h2>
            <p class="mt-5 text-sm leading-8 text-white/75">
              島内の回線状況・通信障害・天候・機器の状態などにより、一時的に接続しにくくなったり、通信速度が低下したりする場合があります。常時の接続や通信速度を保証するものではありません。
            </p>
            <p class="mt-3 text-sm leading-7 text-white/75">重要なオンライン会議など、安定した通信が必須の場合は予備の通信手段をご用意ください。</p>
          </div>
          <div class="rounded-3xl border border-white/15 bg-white/10 p-7 backdrop-blur-sm sm:p-8">
            <p class="text-xs font-bold tracking-[0.2em] text-green-300 uppercase">Connection Info</p>
            <h3 class="mt-3 text-xl font-bold">SSID・パスワードは施設内でご案内しています</h3>
            <p class="mt-4 text-sm leading-7 text-white/75">
              セキュリティのため、Wi-Fiの接続情報はWeb上には掲載していません。ご宿泊時に施設内の案内をご確認ください。
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Guest info -->
    <section id="guest-info" class="scroll-mt-28 py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="max-w-3xl">
          <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">Guest Information</p>
          <h2 class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">設備・持参品・無料貸出品</h2>
          <p class="mt-5 leading-8 text-gray-600">宿泊設備としてご用意しているもの、ご持参いただくもの、無料貸出・サービス品、敷地内のオーナー所有設備を分けてご案内します。</p>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-2">
          <article class="rounded-3xl border border-gray-200 bg-white p-7 shadow-sm">
            <p class="text-xs font-bold tracking-[0.2em] text-gray-500 uppercase">Included</p>
            <h3 class="mt-2 text-xl font-bold text-gray-900">宿泊設備・基本アメニティ</h3>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-gray-700">
              {basicAmenities.map((item) => (
                <li class="flex gap-3"><span class="mt-0.5 text-green-600" aria-hidden="true">●</span><span>{item}</span></li>
              ))}
            </ul>
            <p class="mt-5 border-t border-gray-100 pt-5 text-xs leading-6 text-gray-500">こちらは宿泊設備・基本アメニティとしてご案内しているものです。Wi-Fiについては上記の通信環境に関する注意事項をご確認ください。</p>
          </article>

          <article class="rounded-3xl border border-amber-200 bg-amber-50 p-7">
            <p class="text-xs font-bold tracking-[0.2em] text-amber-800 uppercase">Please Bring</p>
            <h3 class="mt-2 text-xl font-bold text-gray-900">ご持参いただくもの</h3>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-gray-700">
              {bringItems.map((item) => (
                <li class="flex gap-3"><span class="mt-0.5 text-amber-700" aria-hidden="true">●</span><span>{item}</span></li>
              ))}
            </ul>
            <p class="mt-5 border-t border-amber-200 pt-5 text-xs leading-6 text-amber-900/80"><strong>BBQ用の炭は施設では用意していません。</strong> BBQをする場合は、食材・飲み物に加えて、着火剤・着火ライターもご用意ください。</p>
          </article>

          <article class="rounded-3xl border border-green-200 bg-white p-7 shadow-sm">
            <p class="text-xs font-bold tracking-[0.2em] text-green-700 uppercase">Complimentary</p>
            <h3 class="mt-2 text-xl font-bold text-gray-900">無料貸出・サービス品</h3>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-gray-700">
              {complimentaryItems.map((item) => (
                <li class="flex gap-3"><span class="mt-0.5 text-green-600" aria-hidden="true">●</span><span>{item}</span></li>
              ))}
            </ul>
            <p class="mt-5 border-t border-gray-100 pt-5 text-xs leading-6 text-gray-500">滞在を少し楽しく・快適にするため、オーナーからの無料サービスとしてご用意しています。宿泊設備・基本アメニティとは別のもので、内容・種類・数量は時期により変更となる場合があります。破損・紛失・補充状況等により、一時的に利用できない場合があります。</p>
          </article>

          <article class="rounded-3xl border border-sky-200 bg-sky-50 p-7">
            <p class="text-xs font-bold tracking-[0.2em] text-sky-800 uppercase">Owner's Facilities</p>
            <h3 class="mt-2 text-xl font-bold text-gray-900">敷地内のオーナー所有設備</h3>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-gray-700">
              {ownerFacilities.map((item) => (
                <li class="flex gap-3"><span class="mt-0.5 text-sky-700" aria-hidden="true">●</span><span>{item}</span></li>
              ))}
            </ul>
            <p class="mt-5 border-t border-sky-200 pt-5 text-xs leading-6 text-sky-950/75">同じ敷地内にオーナーが所有・管理する設備があり、ご宿泊中のお客様はオーナーの厚意により無料で利用できます。<strong>これらは大島ニュービラの宿泊設備・付帯設備には含まれません。</strong> メンテナンス・故障・清掃等により、予告なく利用できない場合があります。</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Island guide -->
    <section id="island-guide" class="scroll-mt-28 bg-white py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="text-center">
          <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">Around Oshima</p>
          <h2 class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">食べる・遊ぶ・買う</h2>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          <a
            href="https://app.notion.com/p/2e024b6861ae80a5baf2f65672232b32?pvs=21"
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-3xl border border-gray-200 bg-orange-50 p-7 transition hover:-translate-y-1 hover:shadow-lg"
          >
            <span class="text-3xl" aria-hidden="true">🍴</span>
            <h3 class="mt-4 text-xl font-bold text-gray-900">食べる</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">スタッフや島民のおすすめをまとめた、元町グルメガイド。</p>
            <p class="mt-5 text-sm font-bold text-green-700">グルメガイドを見る <span aria-hidden="true">↗</span></p>
          </a>
          <a
            href="https://www.izu-oshima.or.jp/play.html"
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-3xl border border-gray-200 bg-orange-50 p-7 transition hover:-translate-y-1 hover:shadow-lg"
          >
            <span class="text-3xl" aria-hidden="true">🌋</span>
            <h3 class="mt-4 text-xl font-bold text-gray-900">遊ぶ</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">自然・体験・観光スポットは大島観光協会の最新情報もご活用ください。</p>
            <p class="mt-5 text-sm font-bold text-green-700">大島観光協会を見る <span aria-hidden="true">↗</span></p>
          </a>
          <a
            href="/#shopping-guide"
            class="group rounded-3xl border border-gray-200 bg-orange-50 p-7 transition hover:-translate-y-1 hover:shadow-lg"
          >
            <span class="text-3xl" aria-hidden="true">🛒</span>
            <h3 class="mt-4 text-xl font-bold text-gray-900">買う</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">BBQや料理の食材、飲み物、日用品などの買い出し先はこちら。</p>
            <p class="mt-5 text-sm font-bold text-green-700">スーパーガイドを見る <span aria-hidden="true">↗</span></p>
          </a>
        </div>
      </div>
    </section>

    <!-- BBQ -->
    <section id="bbq" class="scroll-mt-28 py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div class="lg:sticky lg:top-28">
            <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">Gazebo BBQ</p>
            <h2 class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">森で火を囲む。<br />ガゼボ庵の使い方</h2>
            <p class="mt-5 leading-8 text-gray-600">森の空気に包まれながら、自分たちで火を囲む時間を安全に楽しむためのガイドです。</p>

            <div class="mt-7 rounded-3xl border-2 border-red-200 bg-red-50 p-6">
              <p class="text-sm font-bold text-red-900">🔥 BBQをご利用の方へ</p>
              <p class="mt-2 text-sm leading-7 text-red-900/80"><strong>炭は施設では用意していません。</strong><br />食材・飲み物に加えて、着火剤・着火ライターも事前にご用意ください。</p>
            </div>

            <img
              src="/night-bbq.webp"
              alt="夜の屋外炊事場ガゼボ庵"
              class="mt-7 aspect-[4/3] w-full rounded-3xl object-cover shadow-lg"
              width="1500"
              height="2000"
              loading="lazy"
            />
          </div>

          <div class="space-y-5">
            <details open class="group rounded-3xl border border-gray-200 bg-white shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
                <span>1. BBQで使える基本道具</span>
                <span class="text-green-700 transition group-open:rotate-45" aria-hidden="true">＋</span>
              </summary>
              <div class="border-t border-gray-100 px-6 py-6">
                <ul class="grid gap-3 sm:grid-cols-2">
                  {bbqCoreItems.map((item) => (
                    <li class="rounded-2xl bg-orange-50 px-4 py-3 text-sm font-medium text-gray-700">{item}</li>
                  ))}
                </ul>
                <p class="mt-5 text-sm leading-7 text-gray-600">サルビア棟キッチンのカウンター上にある持ち出しBOXと、ガゼボ庵の茶色い収納庫をご確認ください。</p>
                <p class="mt-3 text-xs leading-6 text-gray-500">食器類はサルビア棟キッチンのものをご利用ください。Bluetoothスピーカーなどの無料貸出品は、BBQに必要な基本設備とは別のサービス品で、利用可否を保証するものではありません。</p>
              </div>
            </details>

            <details class="group rounded-3xl border border-gray-200 bg-white shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
                <span>2. コンロ・テーブルの組み立て</span>
                <span class="text-green-700 transition group-open:rotate-45" aria-hidden="true">＋</span>
              </summary>
              <div class="border-t border-gray-100 px-6 py-6 text-sm leading-8 text-gray-700">
                <ol class="space-y-4">
                  <li><strong>① 内容物を確認：</strong>黒いバッグからコンロ本体・脚パーツ・ネジ類を取り出します。</li>
                  <li><strong>② 脚を組み立てる：</strong>長い脚パーツを細い棒状のパーツとネジでつなぎ、2セット作ります。</li>
                  <li><strong>③ 本体と脚を固定：</strong>組み立てた脚をコンロ本体の側面に取り付け、ネジを締めます。</li>
                  <li><strong>④ 補助パネルを取り付け：</strong>コンロを立て、脚の下部に補助パネルを取り付けます。</li>
                  <li><strong>⑤ 網・鉄板をセット：</strong>火起こしが完了してから網または鉄板を載せます。</li>
                </ol>
                <div class="mt-5 rounded-2xl bg-amber-50 p-4 text-amber-950"><strong>お願い：</strong>組み立て時は軍手を着用してください。焼き場と食事スペースは少し離して配置すると安全で快適です。</div>
              </div>
            </details>

            <details class="group rounded-3xl border border-gray-200 bg-white shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
                <span>3. 火起こしの目安</span>
                <span class="text-green-700 transition group-open:rotate-45" aria-hidden="true">＋</span>
              </summary>
              <div class="border-t border-gray-100 px-6 py-6 text-sm leading-8 text-gray-700">
                <ol class="space-y-4">
                  <li><strong>① 着火剤を置く：</strong>コンロの底に着火剤を置きます。</li>
                  <li><strong>② 炭を積む：</strong>着火剤を囲むように炭を積みます。</li>
                  <li><strong>③ 着火：</strong>着火ライターで着火剤に火をつけます。</li>
                  <li><strong>④ 火が回るのを待つ：</strong>火がついた直後に何度も炭を動かさず、様子を見ながら火が回るのを待ちます。</li>
                  <li><strong>⑤ 炭を広げる：</strong>炭の表面が白っぽくなり火が回ったら、トングで平らに広げて網・鉄板を載せます。</li>
                </ol>
                <p class="mt-5 rounded-2xl bg-gray-50 p-4 text-xs leading-6 text-gray-600">火起こしにかかる時間は、炭の種類・量・天候などによって異なります。火がついている間はその場を離れないでください。</p>
              </div>
            </details>

            <details class="group rounded-3xl border border-gray-200 bg-white shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
                <span>4. 手持ち花火について</span>
                <span class="text-green-700 transition group-open:rotate-45" aria-hidden="true">＋</span>
              </summary>
              <div class="border-t border-gray-100 px-6 py-6 text-sm leading-8 text-gray-700">
                <p>手持ち花火のみお楽しみいただけます。なお、強風・乾燥・天候その他の安全上の理由により、当日は利用をお控えいただく場合があります。</p>
                <ul class="mt-4 space-y-3">
                  <li><strong>場所：</strong>敷地中央のコンクリート道路部分、またはガゼボ庵のシンク周辺で行ってください。森の中・サルビア棟内は禁止です。</li>
                  <li><strong>消火：</strong>バケツに水を入れ、使用済み花火を完全に消火してください。</li>
                  <li><strong>禁止：</strong>打ち上げ花火・噴出花火は使用できません。</li>
                </ul>
              </div>
            </details>

            <details class="group rounded-3xl border border-gray-200 bg-white shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
                <span>5. 火のルール・後片付け</span>
                <span class="text-green-700 transition group-open:rotate-45" aria-hidden="true">＋</span>
              </summary>
              <div class="border-t border-gray-100 px-6 py-6 text-sm leading-8 text-gray-700">
                <ul class="space-y-3">
                  <li><strong>火の番：</strong>火が点いている間は絶対にその場を離れないでください。</li>
                  <li><strong>炭：</strong>使用後は火が完全に消えていることを確認してください。炭の処理は現地の案内に従ってください。</li>
                  <li><strong>道具：</strong>使用した網・鉄板・トング・取り皿は、シンクの洗剤で油汚れを軽く洗い流してください。</li>
                  <li><strong>収納：</strong>洗った道具や、十分に冷めたコンロ・テーブルは収納庫へ戻さず、シンク周辺または収納庫横に置いてください。清掃スタッフが再洗浄・収納します。</li>
                  <li><strong>ゴミ：</strong>サルビア棟の指定ゴミ箱へ分別して捨ててください。</li>
                  <li><strong>天候：</strong>強風・荒天時は安全のためBBQの利用をお控えください。</li>
                </ul>
                <div class="mt-5 rounded-2xl border border-red-100 bg-red-50 p-4 text-xs leading-6 text-red-900">建物内・森など、火気禁止の場所では火を使用しないでください。喫煙についても現地の案内に従い、火の取り扱いには十分ご注意ください。</div>
              </div>
            </details>

            <details class="group rounded-3xl border border-gray-200 bg-white shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
                <span>6. 夏の虫について</span>
                <span class="text-green-700 transition group-open:rotate-45" aria-hidden="true">＋</span>
              </summary>
              <div class="border-t border-gray-100 px-6 py-6 text-sm leading-8 text-gray-700">
                <p>大島ニュービラは森に囲まれた環境のため、季節や時間帯によって虫が多くなることがあります。特に夏の夜は虫が集まりやすいため、ガゼボ庵の照明から少し離れた芝生側で過ごすなど、状況に合わせてお楽しみください。</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </section>

