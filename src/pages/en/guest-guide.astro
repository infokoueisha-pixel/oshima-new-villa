---
import EnglishLayout from '../../layouts/EnglishLayout.astro';

const pageTitle = 'Guest Guide | Oshima New Villa';
const pageDescription = 'Guest guide for Oshima New Villa on Izu Oshima, Tokyo. Arrival ports, buses, Wi-Fi, self check-in, what is provided, BBQ rules, owner-owned facilities and other practical information for your stay.';

const quickLinks = [
  { label: 'Arrival & Check-in', href: '#arrival', icon: '🚢' },
  { label: 'Wi-Fi', href: '#wifi', icon: '📶' },
  { label: 'What We Provide', href: '#guest-info', icon: '🧳' },
  { label: 'Eat, Explore & Shop', href: '#island-guide', icon: '🗺️' },
  { label: 'BBQ & Gazebo', href: '#bbq', icon: '🔥' },
  { label: 'Forest Time', href: '#forest-time', icon: '🌙' },
];

const providedItems = [
  '4 single beds and 2 sofa beds',
  'Dining space for 6; separate bathroom and toilet',
  'Refrigerator, microwave, rice cooker and toaster',
  'Electric kettle, gas stove, basic cookware and tableware',
  'Bathtub, shower and bidet toilet seat',
  'Bath towels, face towels, toothbrushes and indoor slippers',
  'Shampoo, conditioner and body soap',
  'BBQ grill and benches',
  'Wi-Fi equipment (connection and speed are not guaranteed)',
];

const complimentaryItems = [
  'Board games',
  'Toys',
  'Water guns and other water-play items',
  'Outdoor slippers',
  'Face wash',
  'Bluetooth speaker',
];

const ownerFacilities = [
  'Washing machine',
  'Gas dryer',
  'Shower booth in the container building',
  'Toilet in the container building',
];

const notProvidedItems = [
  'Sleepwear / pajamas',
  'Razors',
];

const bbqCoreItems = [
  'BBQ grill',
  'Grill grate / griddle plate',
  'Tongs / work gloves',
  'Folding table',
  'Sink / bucket',
];
---

<EnglishLayout title={pageTitle} description={pageDescription} noindex={true}>
  <div class="bg-orange-50">
    <!-- Hero -->
    <section class="relative overflow-hidden pt-24 md:pt-28">
      <div class="absolute inset-0">
        <img
          src="/forest-optimized.webp"
          alt="Forest surrounding Oshima New Villa"
          class="h-full w-full object-cover"
          width="1500"
          height="2000"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-green-950/65"></div>
      </div>
      <div class="relative mx-auto max-w-5xl px-6 py-20 text-center text-white md:py-28">
        <p class="text-xs font-bold tracking-[0.3em] text-green-200 uppercase">Guest Guide</p>
        <h1 class="mt-4 font-serif text-4xl font-bold tracking-wide sm:text-5xl">Welcome to Oshima New Villa.</h1>
        <p class="mx-auto mt-6 max-w-2xl text-sm leading-8 text-white/90 sm:text-base">
          Thank you for crossing the sea and making your way to this forest on Izu Oshima.<br class="hidden sm:block" />
          Use this guide to make your stay on the island simple, comfortable and free-flowing.
        </p>
        <div class="mx-auto mt-8 inline-flex rounded-full border border-white/30 bg-white/10 px-5 py-2 text-xs font-bold tracking-wide text-white/90 backdrop-blur-sm">
          For staying guests
        </div>
      </div>
    </section>

    <!-- Quick navigation -->
    <section class="border-b border-orange-100 bg-white py-8">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
          {quickLinks.map((item) => (
            <a
              href={item.href}
              class="flex min-h-24 flex-col items-center justify-center rounded-2xl border border-gray-200 bg-white px-3 py-4 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-green-300 hover:shadow-md"
            >
              <span class="text-2xl" aria-hidden="true">{item.icon}</span>
              <span class="mt-2 text-xs font-bold leading-5 text-gray-800">{item.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Arrival -->
    <section id="arrival" class="scroll-mt-28 py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="max-w-3xl">
          <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">Before Arrival</p>
          <h2 class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">What to check before you arrive</h2>
          <p class="mt-5 leading-8 text-gray-600">On Izu Oshima, the arrival port may change depending on sea conditions. Please check the latest information before departure.</p>
        </div>

        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          <article class="rounded-3xl border border-orange-100 bg-white p-7 shadow-sm">
            <div class="text-3xl" aria-hidden="true">🚨</div>
            <h3 class="mt-4 text-xl font-bold text-gray-900">Today’s arrival port</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">Please check whether your vessel will arrive at Motomachi Port or Okada Port. High-speed jetfoil arrival and departure ports are normally announced at around 6:00 AM on the day.</p>
            <a
              href="https://www.tokaikisen.co.jp/schedule/"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-green-700 hover:underline"
            >
              Check Tokai Kisen service status <span aria-hidden="true">↗</span>
            </a>
          </article>

          <article class="rounded-3xl border border-orange-100 bg-white p-7 shadow-sm">
            <div class="text-3xl" aria-hidden="true">🚌</div>
            <h3 class="mt-4 text-xl font-bold text-gray-900">Local bus timetable</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">The nearest stop is “Oshima Koko-mae,” about a 9-minute walk from the villa. Timetables may change depending on the day’s arrival and departure port, so please check the latest Koen Line timetable before boarding.</p>
            <a
              href="https://www.oshima-bus.com/rosen-bus.html"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-green-700 hover:underline"
            >
              View Oshima Bus timetable <span aria-hidden="true">↗</span>
            </a>
          </article>

          <article class="rounded-3xl border border-orange-100 bg-white p-7 shadow-sm">
            <div class="text-3xl" aria-hidden="true">🔑</div>
            <h3 class="mt-4 text-xl font-bold text-gray-900">Check-in</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">Check-in is available from 3:00 PM, and check-out is by 10:00 AM. The property is unattended; please use the tablet installed on the property for self check-in.</p>
            <p class="mt-4 rounded-2xl bg-orange-50 px-4 py-3 text-xs font-medium leading-6 text-gray-600">About 5 min by car from Motomachi Port / 11 min from Okada Port / 6 min from Oshima Airport</p>
          </article>
        </div>

        <div class="mt-6 rounded-3xl border border-green-100 bg-green-50/70 p-6 md:flex md:items-center md:justify-between md:gap-8">
          <div>
            <h3 class="font-serif text-lg font-bold text-gray-900">A rental car is recommended on the island</h3>
            <p class="mt-2 text-sm leading-7 text-gray-600">A car is the easiest way to visit Mt. Mihara, Urasabaku Desert, Habu Port, Gojinka Onsen and local shops at your own pace. Rental cars are limited, so we recommend booking one early together with your accommodation.</p>
          </div>
          <a href="https://www.oshima-navi.com/transportation/" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex shrink-0 text-sm font-bold text-green-700 hover:underline md:mt-0">View island transportation info ↗</a>
        </div>
      </div>
    </section>

    <!-- Wi-Fi -->
    <section id="wifi" class="scroll-mt-28 bg-green-950 py-16 text-white md:py-20">
      <div class="mx-auto max-w-5xl px-6">
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <p class="text-xs font-bold tracking-[0.28em] text-green-300 uppercase">Wi-Fi</p>
            <h2 class="mt-3 font-serif text-3xl font-bold">Free Wi-Fi is available</h2>
            <p class="mt-5 text-sm leading-8 text-white/75">
              Island network conditions, outages, weather or equipment conditions may temporarily affect connectivity or reduce speed. Continuous connection and a specific communication speed are not guaranteed.
            </p>
            <p class="mt-3 text-sm leading-7 text-white/75">If you need a stable connection for an important online meeting or similar purpose, please prepare a backup internet connection.</p>
          </div>
          <div class="rounded-3xl border border-white/15 bg-white/10 p-7 backdrop-blur-sm sm:p-8">
            <p class="text-xs font-bold tracking-[0.2em] text-green-300 uppercase">Connection Info</p>
            <h3 class="mt-3 text-xl font-bold">SSID and password are displayed inside the villa</h3>
            <p class="mt-4 text-sm leading-7 text-white/75">
              For security, Wi-Fi connection details are not published on this website. Please check the information displayed inside the property during your stay.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Guest info -->
    <section id="guest-info" class="scroll-mt-28 py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="max-w-3xl">
          <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">Guest Information</p>
          <h2 class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">What is provided — and what is not</h2>
          <p class="mt-5 leading-8 text-gray-600">
            We separate items into three categories: things provided as part of the accommodation, complimentary items that may be available but are not guaranteed, and items that are generally not provided.
          </p>
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-3">
          <article class="rounded-3xl border border-green-200 bg-green-50 p-7">
            <p class="text-xs font-bold tracking-[0.2em] text-green-700 uppercase">Provided</p>
            <h3 class="mt-2 text-xl font-bold text-gray-900">Included with your stay</h3>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-gray-700">
              {providedItems.map((item) => (
                <li class="flex gap-3"><span class="mt-0.5 text-green-700" aria-hidden="true">●</span><span>{item}</span></li>
              ))}
            </ul>
            <p class="mt-5 border-t border-green-200 pt-5 text-xs leading-6 text-green-950/75">
              These are the main accommodation facilities and basic amenities we provide. Wi-Fi equipment is provided, but please see the connectivity notice above.
            </p>
          </article>

          <article class="rounded-3xl border border-sky-200 bg-sky-50 p-7">
            <p class="text-xs font-bold tracking-[0.2em] text-sky-800 uppercase">Complimentary</p>
            <h3 class="mt-2 text-xl font-bold text-gray-900">May be available free of charge</h3>
            <p class="mt-4 text-sm leading-7 text-gray-700">Complimentary loan / service items</p>
            <ul class="mt-3 space-y-3 text-sm leading-7 text-gray-700">
              {complimentaryItems.map((item) => (
                <li class="flex gap-3"><span class="mt-0.5 text-sky-700" aria-hidden="true">●</span><span>{item}</span></li>
              ))}
            </ul>
            <p class="mt-5 text-xs leading-6 text-sky-950/75">
              These are not part of the accommodation facilities or basic amenities. Items, types and quantities may change, and they may be unavailable due to damage, loss or restocking. Availability of any specific item is not guaranteed.
            </p>

            <div class="mt-6 border-t border-sky-200 pt-6">
              <p class="text-sm font-bold text-gray-900">Owner-owned facilities on the property</p>
              <ul class="mt-3 space-y-3 text-sm leading-7 text-gray-700">
                {ownerFacilities.map((item) => (
                  <li class="flex gap-3"><span class="mt-0.5 text-sky-700" aria-hidden="true">●</span><span>{item}</span></li>
                ))}
              </ul>
              <p class="mt-4 text-xs leading-6 text-sky-950/75">
                These facilities are owned and managed by the property owner on the same premises. <strong>They are not included in the accommodation facilities or ancillary facilities of Oshima New Villa.</strong> Guests may use them free of charge when available, but they may be unavailable due to maintenance, malfunction, cleaning or other reasons.
              </p>
            </div>
          </article>

          <article class="rounded-3xl border border-amber-200 bg-amber-50 p-7">
            <p class="text-xs font-bold tracking-[0.2em] text-amber-800 uppercase">Not Provided</p>
            <h3 class="mt-2 text-xl font-bold text-gray-900">Generally not provided</h3>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-gray-700">
              {notProvidedItems.map((item) => (
                <li class="flex gap-3"><span class="mt-0.5 text-amber-700" aria-hidden="true">●</span><span>{item}</span></li>
              ))}
            </ul>
            <p class="mt-5 border-t border-amber-200 pt-5 text-xs leading-6 text-amber-950/75">
              Please bring these yourself if you need them.
            </p>

            <div class="mt-6 rounded-2xl border border-amber-200 bg-white/80 p-5">
              <p class="text-sm font-bold text-gray-900">🔥 Only if you plan to BBQ</p>
              <p class="mt-2 text-xs leading-6 text-gray-600">
                Charcoal, fire starters, a long lighter, food and drinks are not provided. Please prepare these items only if you plan to use the BBQ.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Island guide -->
    <section id="island-guide" class="scroll-mt-28 bg-white py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="text-center">
          <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">Around Oshima</p>
          <h2 class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">Eat, explore and shop</h2>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          <a
            href="https://app.notion.com/p/2e024b6861ae80a5baf2f65672232b32?pvs=21"
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-3xl border border-gray-200 bg-orange-50 p-7 transition hover:-translate-y-1 hover:shadow-lg"
          >
            <span class="text-3xl" aria-hidden="true">🍴</span>
            <h3 class="mt-4 text-xl font-bold text-gray-900">Eat</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">A Motomachi food guide with recommendations from our team and local residents.</p>
            <p class="mt-5 text-sm font-bold text-green-700">View food guide <span aria-hidden="true">↗</span></p>
          </a>
          <a
            href="https://www.izu-oshima.or.jp/play.html"
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-3xl border border-gray-200 bg-orange-50 p-7 transition hover:-translate-y-1 hover:shadow-lg"
          >
            <span class="text-3xl" aria-hidden="true">🌋</span>
            <h3 class="mt-4 text-xl font-bold text-gray-900">Explore</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">For current information on nature, activities and sightseeing spots, please also check the Izu Oshima Tourism Association.</p>
            <p class="mt-5 text-sm font-bold text-green-700">Visit tourism association <span aria-hidden="true">↗</span></p>
          </a>
          <a
            href="/#shopping-guide"
            class="group rounded-3xl border border-gray-200 bg-orange-50 p-7 transition hover:-translate-y-1 hover:shadow-lg"
          >
            <span class="text-3xl" aria-hidden="true">🛒</span>
            <h3 class="mt-4 text-xl font-bold text-gray-900">Shop</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">Find places to buy BBQ ingredients, groceries, drinks and everyday supplies.</p>
            <p class="mt-5 text-sm font-bold text-green-700">View shopping information <span aria-hidden="true">↗</span></p>
          </a>
        </div>
      </div>
    </section>

    <!-- BBQ -->
    <section id="bbq" class="scroll-mt-28 py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div class="lg:sticky lg:top-28">
            <p class="text-xs font-bold tracking-[0.28em] text-green-700 uppercase">Gazebo BBQ</p>
            <h2 class="mt-3 font-serif text-3xl font-bold text-gray-900 md:text-4xl">Gather around the fire.<br />How to use the gazebo</h2>
            <p class="mt-5 leading-8 text-gray-600">A practical guide for enjoying a BBQ safely while surrounded by the forest.</p>

            <div class="mt-7 rounded-3xl border-2 border-red-200 bg-red-50 p-6">
              <p class="text-sm font-bold text-red-900">🔥 If you plan to use the BBQ</p>
              <p class="mt-2 text-sm leading-7 text-red-900/80">
                Basic equipment such as the BBQ grill and benches is provided. <strong>Charcoal, fire starters, a long lighter, food and drinks are not provided.</strong><br />Please prepare what you need if you plan to BBQ.
              </p>
            </div>

            <img
              src="/night-bbq.webp"
              alt="Gazebo BBQ area at night"
              class="mt-7 aspect-[4/3] w-full rounded-3xl object-cover shadow-lg"
              width="1500"
              height="2000"
              loading="lazy"
            />
          </div>

          <div class="space-y-5">
            <details open class="group rounded-3xl border border-gray-200 bg-white shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
                <span>1. Basic BBQ equipment</span>
                <span class="text-green-700 transition group-open:rotate-45" aria-hidden="true">＋</span>
              </summary>
              <div class="border-t border-gray-100 px-6 py-6">
                <ul class="grid gap-3 sm:grid-cols-2">
                  {bbqCoreItems.map((item) => (
                    <li class="rounded-2xl bg-orange-50 px-4 py-3 text-sm font-medium text-gray-700">{item}</li>
                  ))}
                </ul>
                <p class="mt-5 text-sm leading-7 text-gray-600">Please check the take-out box on the Salvia kitchen counter and the brown storage cabinet in the gazebo.</p>
                <p class="mt-3 text-xs leading-6 text-gray-500">You may use tableware from the Salvia kitchen. Complimentary items such as the Bluetooth speaker are separate from essential BBQ equipment, and their availability is not guaranteed.</p>
              </div>
            </details>

            <details class="group rounded-3xl border border-gray-200 bg-white shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
                <span>2. Setting up the grill and table</span>
                <span class="text-green-700 transition group-open:rotate-45" aria-hidden="true">＋</span>
              </summary>
              <div class="border-t border-gray-100 px-6 py-6 text-sm leading-8 text-gray-700">
                <ol class="space-y-4">
                  <li><strong>① Check the parts:</strong> Remove the grill body, leg parts and screws from the black bag.</li>
                  <li><strong>② Assemble the legs:</strong> Connect the long leg pieces using the thin rods and screws to make two leg sets.</li>
                  <li><strong>③ Attach the legs:</strong> Fix the assembled legs to the sides of the grill and tighten the screws.</li>
                  <li><strong>④ Attach the lower support panel:</strong> Stand the grill upright and attach the support panel to the lower part of the legs.</li>
                  <li><strong>⑤ Add the grate or griddle:</strong> Place the grate or griddle on the grill only after the charcoal is properly lit.</li>
                </ol>
                <div class="mt-5 rounded-2xl bg-amber-50 p-4 text-amber-950"><strong>Please note:</strong> Wear work gloves while assembling the grill. Keeping the cooking area slightly apart from the dining area makes the setup safer and more comfortable.</div>
              </div>
            </details>

            <details class="group rounded-3xl border border-gray-200 bg-white shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
                <span>3. Lighting the charcoal</span>
                <span class="text-green-700 transition group-open:rotate-45" aria-hidden="true">＋</span>
              </summary>
              <div class="border-t border-gray-100 px-6 py-6 text-sm leading-8 text-gray-700">
                <ol class="space-y-4">
                  <li><strong>① Place the fire starter:</strong> Put the fire starter at the bottom of the grill.</li>
                  <li><strong>② Stack the charcoal:</strong> Arrange the charcoal around the fire starter.</li>
                  <li><strong>③ Light it:</strong> Use a long lighter to ignite the fire starter.</li>
                  <li><strong>④ Let the fire spread:</strong> Avoid moving the charcoal repeatedly just after lighting it. Wait and watch as the fire spreads.</li>
                  <li><strong>⑤ Spread the charcoal:</strong> Once the charcoal surface starts turning whitish and the fire has spread, use tongs to spread it evenly, then add the grate or griddle.</li>
                </ol>
                <p class="mt-5 rounded-2xl bg-gray-50 p-4 text-xs leading-6 text-gray-600">Lighting time varies depending on the type and amount of charcoal and the weather. Never leave the fire unattended.</p>
              </div>
            </details>

            <details class="group rounded-3xl border border-gray-200 bg-white shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
                <span>4. Handheld fireworks</span>
                <span class="text-green-700 transition group-open:rotate-45" aria-hidden="true">＋</span>
              </summary>
              <div class="border-t border-gray-100 px-6 py-6 text-sm leading-8 text-gray-700">
                <p>Only handheld fireworks are allowed. Depending on strong winds, dry conditions, weather or other safety concerns, we may ask guests not to use fireworks on a particular day.</p>
                <ul class="mt-4 space-y-3">
                  <li><strong>Where:</strong> Use the central concrete road area on the property or around the gazebo sink. Fireworks are not allowed in the forest or inside the Salvia villa.</li>
                  <li><strong>Extinguishing:</strong> Fill a bucket with water and fully extinguish used fireworks.</li>
                  <li><strong>Not allowed:</strong> Aerial fireworks and fountain-style fireworks may not be used.</li>
                </ul>
              </div>
            </details>

            <details class="group rounded-3xl border border-gray-200 bg-white shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
                <span>5. Fire safety and cleanup</span>
                <span class="text-green-700 transition group-open:rotate-45" aria-hidden="true">＋</span>
              </summary>
              <div class="border-t border-gray-100 px-6 py-6 text-sm leading-8 text-gray-700">
                <ul class="space-y-3">
                  <li><strong>Supervision:</strong> Never leave the area while a fire is burning.</li>
                  <li><strong>Charcoal:</strong> After use, make sure the fire is completely extinguished. Follow the on-site instructions for charcoal disposal.</li>
                  <li><strong>Equipment:</strong> Lightly wash oil and food residue from the grate, griddle, tongs and plates using the detergent at the sink.</li>
                  <li><strong>After washing:</strong> Do not put washed tools, or a grill/table that is still warm, back into the storage cabinet. Leave them around the sink or beside the cabinet. Cleaning staff will wash and store them again.</li>
                  <li><strong>Trash:</strong> Separate and dispose of trash in the designated bins inside the Salvia villa.</li>
                  <li><strong>Weather:</strong> Please do not use the BBQ during strong winds or severe weather.</li>
                </ul>
                <div class="mt-5 rounded-2xl border border-red-100 bg-red-50 p-4 text-xs leading-6 text-red-900">Do not use fire inside buildings, in the forest or in any other area where open flames are prohibited. Please also follow the on-site smoking rules and take great care when handling fire.</div>
              </div>
            </details>

            <details class="group rounded-3xl border border-gray-200 bg-white shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-bold text-gray-900 [&::-webkit-details-marker]:hidden">
                <span>6. Summer insects</span>
                <span class="text-green-700 transition group-open:rotate-45" aria-hidden="true">＋</span>
              </summary>
              <div class="border-t border-gray-100 px-6 py-6 text-sm leading-8 text-gray-700">
