---
import EnglishLayout from '../../layouts/EnglishLayout.astro';
const pageTitle = 'Guest Guide | Choose Your Reservation | Oshima New Villa';
const pageDescription = 'Guest guide for Oshima New Villa. Choose SALVIA, FREESIA, or a booking that includes both villas.';
---

<EnglishLayout title={pageTitle} description={pageDescription} noindex={true}>
  <main class="min-h-screen bg-orange-50 pt-24 md:pt-28">
    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-xs font-bold tracking-[0.3em] text-green-700 uppercase">Guest Guide</p>
          <h1 class="mt-4 font-serif text-4xl font-bold text-gray-900 md:text-5xl">Choose the villa(s) in your reservation</h1>
          <p class="mx-auto mt-6 max-w-2xl text-sm leading-8 text-gray-600 md:text-base">Select the reservation type shown in your booking confirmation to see the correct facilities and BBQ information.</p>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
        <a href="/en/guest-guide/salvia/" class="group rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-lg">
          <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">Up to 6 guests</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-gray-900">SALVIA</h2>
          <p class="mt-3 text-sm leading-7 text-gray-600">BBQ at Gazebo An</p>
          <span class="mt-6 inline-flex text-sm font-bold text-green-800">Open guide <span class="ml-1 transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        <a href="/en/guest-guide/freesia/" class="group rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-lg">
          <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">Up to 3 guests</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-gray-900">FREESIA</h2>
          <p class="mt-3 text-sm leading-7 text-gray-600">BBQ on the private wooden deck</p>
          <span class="mt-6 inline-flex text-sm font-bold text-green-800">Open guide <span class="ml-1 transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        <a href="/en/guest-guide/salvia-freesia/" class="group rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-lg">
          <p class="text-xs font-bold tracking-[0.18em] text-green-700 uppercase">Up to 9 guests</p>
          <h2 class="mt-3 font-serif text-2xl font-bold text-gray-900">SALVIA + FREESIA</h2>
          <p class="mt-3 text-sm leading-7 text-gray-600">Gazebo An is included</p>
          <span class="mt-6 inline-flex text-sm font-bold text-green-800">Open guide <span class="ml-1 transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        </div>
        <p class="mx-auto mt-8 max-w-2xl text-center text-xs leading-6 text-gray-500">Your pre-arrival message will normally link directly to the correct guide.</p>
      </div>
    </section>
  </main>
</EnglishLayout>
