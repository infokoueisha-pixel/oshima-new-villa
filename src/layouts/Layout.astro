---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '大島ニュービラ | 伊豆大島の貸別荘',
  description = '森と眠る、心の再生。1975年開業の貸別荘が、15年ぶりにリノベーションして復活。伊豆大島で仲間と過ごす、静かな時間を。',
} = Astro.props;

// メニュー一覧に「アクセス」を追加
const navItems = [
  { label: 'ストーリー', href: '#story' },
  { label: '3つの魅力', href: '#experience' },
  { label: '設備・Q&A', href: '#facilities' },
  { label: 'アクセス', href: '#access' },
];
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Noto+Serif+JP:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-M3WQTD59');</script>
    <!-- End Google Tag Manager -->
  </head>
  <body class="min-h-screen flex flex-col antialiased bg-orange-50 text-gray-800">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M3WQTD59"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- ヘッダー -->
    <header
      class="fixed top-0 inset-x-0 z-50 border-b border-gray-200/80 bg-white/90 backdrop-blur-md shadow-sm"
    >
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-3">
        <a href="/" class="group flex items-center gap-3 transition-opacity hover:opacity-80">
          <img src="/oshima_new_villa_logo_A_N.png" alt="ロゴ" class="h-10 w-auto object-contain" />
          <span class="font-serif text-lg font-bold tracking-wider text-gray-900">大島ニュービラ</span>
        </a>

        <nav class="hidden items-center gap-8 lg:flex" aria-label="メインナビゲーション">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="text-sm font-bold tracking-wide text-gray-600 transition-colors hover:text-green-700"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="#booking"
            class="rounded-full bg-green-700 px-6 py-2.5 text-sm font-bold text-white shadow-md shadow-green-700/20 transition-all hover:bg-green-600 hover:shadow-lg hover:-translate-y-0.5"
          >
            予約する
          </a>
        </nav>

        <!-- スマホ用予約ボタン -->
        <a
          href="#booking"
          class="rounded-full bg-green-700 px-4 py-2 text-sm font-bold text-white shadow-md lg:hidden"
        >
          予約
        </a>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- フッター -->
    <footer class="bg-gray-900 pt-16 pb-8 text-white">
      <div class="mx-auto max-w-7xl px-6">
        <div class="flex flex-col items-center gap-8 text-center md:flex-row md:justify-between md:text-left">
          <div class="flex flex-col items-center md:items-start">
            <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-80">
              <img src="/oshima_new_villa_logo_A_W.png" alt="ロゴ" class="h-12 w-auto object-contain opacity-90" />
              <span class="font-serif text-xl font-bold tracking-wider text-white">大島ニュービラ</span>
            </a>
            <p class="mt-4 text-sm text-gray-400">〒100-0101 東京都大島町元町字新込126-42</p>
          </div>
          <!-- メニュー一覧をループで表示 -->
          <nav class="flex flex-wrap justify-center gap-6 text-sm text-gray-400" aria-label="フッターナビゲーション">
            {
              navItems.map((item) => (
                <a href={item.href} class="transition-colors hover:text-white">
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
        <div class="mt-12 border-t border-gray-800 pt-8 text-center text-xs text-gray-500">
          <p>&copy; {new Date().getFullYear()} Oshima New Villa. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <!-- TOPに戻るフローティングボタン -->
    <a
      href="#"
      id="back-to-top"
      class="fixed bottom-6 right-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-green-700 text-white shadow-lg opacity-0 transition-opacity duration-300 hover:bg-green-600 pointer-events-none md:bottom-10 md:right-10"
      aria-label="ページトップへ戻る"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
      </svg>
    </a>

    <script>
      // 少しスクロールしたらボタンを表示するスクリプト
      const backToTopBtn = document.getElementById('back-to-top');
      if (backToTopBtn) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 400) {
            backToTopBtn.classList.remove('opacity-0', 'pointer-events-none');
            backToTopBtn.classList.add('opacity-100', 'pointer-events-auto');
          } else {
            backToTopBtn.classList.add('opacity-0', 'pointer-events-none');
            backToTopBtn.classList.remove('opacity-100', 'pointer-events-auto');
          }
        });

        backToTopBtn.addEventListener('click', (e) => {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@400;600;700&display=swap');

  :root {
    font-family: 'Noto Sans JP', sans-serif;
  }
  
  h1, h2, h3, h4, h5, h6, .font-serif {
    font-family: 'Noto Serif JP', serif;
  }
</style>