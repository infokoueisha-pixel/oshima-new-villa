---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = '伊豆大島の一棟貸し宿｜最大6名・BBQ・森のヴィラ｜大島ニュービラ',
  description = '伊豆大島・元町の一棟貸し宿「大島ニュービラ」。家族・友人で最大6名、BBQ・自炊を楽しめる森のヴィラです。元町港から車で約5分。1975年開業の施設を2026年にリニューアルしました。',
  noindex = false,
} = Astro.props;

const siteUrl = 'https://oshima-new-villa.com/';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL('/ogp-oshima-new-villa.jpg', siteUrl).href;
const propertyImageUrl = new URL('/main-optimized.webp', siteUrl).href;

const homeAnchor = (hash: string) => Astro.url.pathname === '/' ? hash : `/${hash}`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: '大島ニュービラ',
      alternateName: 'Oshima New Villa',
      inLanguage: 'ja',
    },
    {
      '@type': 'LodgingBusiness',
      '@id': `${siteUrl}#lodging-business`,
      name: '大島ニュービラ',
      alternateName: 'Oshima New Villa',
      url: siteUrl,
      description,
      image: [
        propertyImageUrl,
        new URL('/day-salvia.webp', siteUrl).href,
        new URL('/sofa-salvia.webp', siteUrl).href,
        new URL('/night-bbq.webp', siteUrl).href,
      ],
      logo: new URL('/oshima_new_villa_logo_A_N.png', siteUrl).href,
      address: {
        '@type': 'PostalAddress',
        postalCode: '100-0101',
        addressRegion: '東京都',
        addressLocality: '大島町',
        streetAddress: '元町字新込126-42',
        addressCountry: 'JP',
      },
      checkinTime: '15:00',
      checkoutTime: '10:00',
      petsAllowed: false,
      smokingAllowed: false,
      sameAs: [
        'https://www.airbnb.jp/rooms/1602063410123886296',
      ],
      amenityFeature: [
        { '@type': 'LocationFeatureSpecification', name: '一棟貸切', value: true },
        { '@type': 'LocationFeatureSpecification', name: '最大6名', value: true },
        { '@type': 'LocationFeatureSpecification', name: '無料Wi-Fi', value: true },
        { '@type': 'LocationFeatureSpecification', name: 'キッチン', value: true },
        { '@type': 'LocationFeatureSpecification', name: '屋外BBQ設備', value: true },
        { '@type': 'LocationFeatureSpecification', name: '無料駐車場', value: true },
      ],
    },
  ],
};

const desktopNavItems = [
  { label: '宿の魅力', href: homeAnchor('#experience') },
  { label: '客室', href: homeAnchor('#gallery') },
  { label: '島を楽しむ', href: homeAnchor('#volcano-guide') },
  { label: 'モデルコース', href: homeAnchor('#itinerary') },
  { label: '設備・FAQ', href: homeAnchor('#facilities') },
  { label: 'アクセス', href: homeAnchor('#access') },
];

const mobileNavGroups = [
  {
    title: '宿泊する',
    items: [
      { label: '大島ニュービラの魅力', href: homeAnchor('#experience') },
      { label: 'サルビア棟・客室', href: homeAnchor('#gallery') },
      { label: '設備・よくある質問', href: homeAnchor('#facilities') },
    ],
  },
  {
    title: '大島を楽しむ',
    items: [
      { label: '三原山・裏砂漠', href: homeAnchor('#volcano-guide') },
      { label: '地層大切断面', href: homeAnchor('#strata-guide') },
      { label: '波浮港', href: homeAnchor('#habu-port-guide') },
      { label: '椿・大島公園', href: homeAnchor('#camellia-park-guide') },
      { label: '夕焼け・星空', href: homeAnchor('#sunset-sky-guide') },
    ],
  },
  {
    title: '旅を計画する',
    items: [
      { label: '1泊2日モデルコース', href: homeAnchor('#itinerary') },
      { label: 'スーパー・買い出し', href: homeAnchor('#shopping-guide') },
      { label: 'アクセス・駐車場', href: homeAnchor('#access') },
    ],
  },
  {
    title: '私たちについて',
    items: [{ label: '1975年からの物語', href: homeAnchor('#story') }],
  },
];

const footerNavItems = [
  { label: 'ストーリー', href: homeAnchor('#story') },
  { label: '客室', href: homeAnchor('#gallery') },
  { label: '観光案内', href: homeAnchor('#volcano-guide') },
  { label: 'モデルコース', href: homeAnchor('#itinerary') },
  { label: '設備・FAQ', href: homeAnchor('#facilities') },
  { label: 'アクセス', href: homeAnchor('#access') },
];
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="preload"
      as="image"
      href="/main-optimized.webp"
      imagesrcset="/main-optimized-640.webp 640w, /main-optimized-960.webp 960w, /main-optimized.webp 1170w"
      imagesizes="100vw"
      fetchpriority="high"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="大島ニュービラ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="伊豆大島の一棟貸し・大島ニュービラ。大島を遊ぶ。森に帰る。" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="伊豆大島の一棟貸し・大島ニュービラ。大島を遊ぶ。森に帰る。" />

    <meta name="theme-color" content="#15803d" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Noto+Serif+JP:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-M3WQTD59');</script>
    <!-- End Google Tag Manager -->
  </head>
  <body class="min-h-screen flex flex-col antialiased bg-orange-50 text-gray-800">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M3WQTD59"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- ヘッダー -->
    <header
      class="fixed inset-x-0 top-0 z-50 border-b border-gray-200/80 bg-white/90 shadow-sm backdrop-blur-md"
    >
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a href="/" class="group flex min-w-0 items-center gap-2.5 transition-opacity hover:opacity-80 sm:gap-3">
          <img
            src="/oshima_new_villa_logo_A_N.png"
            alt="大島ニュービラ"
            class="h-10 w-auto shrink-0 object-contain"
            width="1267"
            height="1247"
          />
          <span class="truncate font-serif text-base font-bold tracking-wider text-gray-900 sm:text-lg">大島ニュービラ</span>
        </a>

        <nav class="hidden items-center gap-5 xl:flex" aria-label="メインナビゲーション">
          {
            desktopNavItems.map((item) => (
              <a
                href={item.href}
                class="whitespace-nowrap text-sm font-bold tracking-wide text-gray-600 transition-colors hover:text-green-700"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="https://www.airbnb.jp/rooms/1602063410123886296?guests=6&adults=6&s=67&unique_share_id=a393ba49-61eb-4d8e-a4c9-95935b649d65"
            data-booking-location="header"
            target="_blank"
            rel="noopener noreferrer"
            class="ml-1 whitespace-nowrap rounded-full bg-green-700 px-6 py-2.5 text-sm font-bold text-white shadow-md shadow-green-700/20 transition-all hover:-translate-y-0.5 hover:bg-green-600 hover:shadow-lg"
          >
            予約する
          </a>
        </nav>

        <div class="flex shrink-0 items-center gap-2 xl:hidden">
          <details id="mobile-menu" class="relative">
            <summary
              class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-gray-200 bg-white text-gray-800 shadow-sm transition-colors hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-700 [&::-webkit-details-marker]:hidden"
              aria-label="メニューを開く"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </summary>

            <div class="fixed inset-x-0 top-[65px] max-h-[calc(100dvh-65px)] overflow-y-auto border-t border-green-800 bg-green-950 text-white shadow-2xl">
              <nav class="mx-auto max-w-3xl px-6 py-7" aria-label="スマートフォン用メニュー">
                <div class="grid gap-8 sm:grid-cols-2">
                  {
                    mobileNavGroups.map((group) => (
                      <div>
                        <p class="text-xs font-bold tracking-[0.22em] text-green-300 uppercase">{group.title}</p>
                        <ul class="mt-3 divide-y divide-white/10">
                          {group.items.map((item) => (
                            <li>
                              <a
                                href={item.href}
                                class="mobile-menu-link flex items-center justify-between gap-4 py-3.5 text-sm font-bold text-white transition-colors hover:text-green-200"
                              >
                                <span>{item.label}</span>
                                <span class="text-green-300" aria-hidden="true">→</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))
                  }
                </div>

                <a
                  href="https://www.airbnb.jp/rooms/1602063410123886296?guests=6&adults=6&s=67&unique_share_id=a393ba49-61eb-4d8e-a4c9-95935b649d65"
                  data-booking-location="header"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-8 flex w-full items-center justify-center rounded-full bg-white px-6 py-3.5 text-sm font-bold text-green-900 shadow-sm transition-colors hover:bg-green-50"
                >
                  Airbnbで空室・料金を確認する
                </a>
              </nav>
            </div>
          </details>

          <a
            href="https://www.airbnb.jp/rooms/1602063410123886296?guests=6&adults=6&s=67&unique_share_id=a393ba49-61eb-4d8e-a4c9-95935b649d65"
            data-booking-location="header"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-green-700 px-4 py-2 text-sm font-bold text-white shadow-md"
          >
            予約
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- フッター -->
    <footer class="bg-gray-900 pt-16 pb-8 text-white">
      <div class="mx-auto max-w-7xl px-6">
        <div class="flex flex-col items-center gap-8 text-center md:flex-row md:justify-between md:text-left">
          <div class="flex flex-col items-center md:items-start">
            <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-80">
              <img src="/oshima_new_villa_logo_A_W.png" alt="大島ニュービラ" class="h-12 w-auto object-contain opacity-90" width="1267" height="1247" />
              <span class="font-serif text-xl font-bold tracking-wider text-white">大島ニュービラ</span>
            </a>
            <p class="mt-4 text-sm text-gray-400">〒100-0101 東京都大島町元町字新込126-42</p>
          </div>
          <!-- メニュー一覧をループで表示 -->
          <nav class="flex flex-wrap justify-center gap-6 text-sm text-gray-400" aria-label="フッターナビゲーション">
            {
              footerNavItems.map((item) => (
                <a href={item.href} class="transition-colors hover:text-white">
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
        <div class="mt-12 border-t border-gray-800 pt-8 text-center text-xs text-gray-500">
          <p>&copy; {new Date().getFullYear()} Oshima New Villa. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <!-- TOPに戻るフローティングボタン -->
    <a
      href="#"
      id="back-to-top"
      class="fixed bottom-6 right-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-green-700 text-white shadow-lg opacity-0 transition-opacity duration-300 hover:bg-green-600 pointer-events-none md:bottom-10 md:right-10"
      aria-label="ページトップへ戻る"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
      </svg>
    </a>

    <script>
      const mobileMenu = document.getElementById('mobile-menu');
      if (mobileMenu instanceof HTMLDetailsElement) {
        mobileMenu.querySelectorAll('.mobile-menu-link').forEach((link) => {
          link.addEventListener('click', () => {
            mobileMenu.open = false;
          });
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            mobileMenu.open = false;
          }
        });

        document.addEventListener('click', (event) => {
          if (mobileMenu.open && event.target instanceof Node && !mobileMenu.contains(event.target)) {
            mobileMenu.open = false;
          }
        });
      }

      // 少しスクロールしたらボタンを表示するスクリプト
      const backToTopBtn = document.getElementById('back-to-top');
      if (backToTopBtn) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 400) {
            backToTopBtn.classList.remove('opacity-0', 'pointer-events-none');
            backToTopBtn.classList.add('opacity-100', 'pointer-events-auto');
          } else {
            backToTopBtn.classList.add('opacity-0', 'pointer-events-none');
            backToTopBtn.classList.remove('opacity-100', 'pointer-events-auto');
          }
        });

        backToTopBtn.addEventListener('click', (e) => {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    font-family: 'Noto Sans JP', sans-serif;
  }
  
  h1, h2, h3, h4, h5, h6, .font-serif {
    font-family: 'Noto Serif JP', serif;
  }
</style>